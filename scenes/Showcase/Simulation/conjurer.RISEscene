RISE ASCII SCENE 7
#############################################################################################################
#                                                                                                           #
#   File:           conjurer.RISEscene                                                                      #
#   Idea:           A conjurer's canopy.  A square of midnight-blue silk hangs by its four corners over an  #
#                   empty stage; a gilded cube and an ivory ball are tossed up into it from below, punch     #
#                   two peaks into the silk, are thrown back down by it and tumble across the boards while   #
#                   the canopy billows and settles.  One hard spotlight from above and a cool rim behind.    #
#   Simulations:    rigid.bodies `props` (two bodies made from the scene objects' meshes, tossed with       #
#                   velocity and spin; the stage as a plane) and cloth.shell `silk` (silk pinned at its     #
#                   corners, barrier contact, self-collision) in one simulation_group `flourish`, coupled   #
#                   implicitly and sub-iterated: each prop is a mesh collider of the cloth moved by its      #
#                   body's state (`rigid_surface`), and the cloth's contact reaction loads the bodies       #
#                   (`contact_reaction`), so the silk is lifted by the props and throws them back.           #
#   Limits:         cloth-rigid coupling needs each body's surface to be the collider mesh's topology, so   #
#                   the props are mesh bodies (`body_object`), and mesh bodies take no body-body contact    #
#                   (`contact off`): the props are tossed apart and never meet.  A free silk dropped over   #
#                   the props and pinched between a landing prop and the stage failed the cloth's Newton    #
#                   solve in five attempts (docs/SIMULATION_SHOWCASE.md), so the silk is held above them.   #
#   Frame:          y up, metres.                                                                           #
#   Time:           3 s at 30 fps (91 frames).                                                              #
#   Proof/final:    a value followed by `# proof <value>` is the final setting; scripts/                    #
#                   simulation_showcase.sh proof substitutes the proof value.                               #
#   Bake/render:    scripts/simulation_showcase.sh proof|final conjurer   (docs/SIMULATION_SHOWCASE.md)      #
#   showcase:       hero 11 frames 6 16 24 90                                                               #
#                                                                                                           #
#############################################################################################################

standard_shader
{
	name			global
	shaderop		DefaultPathTracing
}

uniformcolor_painter
{
	name			pnt_env
	color			0.2 0.2 0.25
}

pathtracing_pel_rasterizer
{
	samples			512		# proof 64
	oidn_denoise	TRUE
	radiance_map	pnt_env
	radiance_scale	0.08
	radiance_background	FALSE
}

file_rasterizeroutput
{
	pattern			rendered/showcase/conjurer/final/conjurer		# proof rendered/showcase/conjurer/proof/conjurer
	multiple		TRUE
	type			PNG
	bpp				8
	color_space		sRGB
	display_transform	aces
}

film
{
	width			1920		# proof 640
	height			1080		# proof 360
}

animation_options
{
	time_start		0
	time_end		3
	num_frames		91
}

pinhole_camera
{
	location		0.35 0.55 2.5
	lookat			0.0 0.68 0.0
	up				0 1 0
	fov				40.0
}

#############################################################################################################
# Simulations

rigid_simulation
{
	name			props
	frames			91
	substeps		16
	body_object		ball mass 0.45 velocity -0.25 4.6 0.05 spin 2 0 -3 contact off
	body_object		cube mass 0.55 velocity 0.3 4.3 -0.05 spin 4 2 5 contact off
	plane			0 0 0 0 1 0 restitution 0.15 friction 0.6
}

# The stage the cloth lies on is 15 mm below the plane the props land on, so a prop resting on the silk on the
# stage leaves the silk room for its contact offset (rigid.bodies' plane contact does not see the cloth).

cloth_simulation
{
	name			silk
	frames			91
	size_u			1.0
	size_v			1.0
	vertices_u		49		# proof 31
	vertices_v		49		# proof 31
	origin			-0.5 1.0 -0.5
	axis_u			1 0 0
	axis_v			0 0 1
	pin				u0v0
	pin				u1v0
	pin				u0v1
	pin				u1v1
	material		silk-lightweight
	substeps		16
	newton_iterations	100
	self_collision	TRUE
	collider		plane 0 -0.015 0 0 1 0
	collider_port	ball collider_ball
	collider_port	cube collider_cube
}

simulation_group
{
	name			flourish
	members			props
	members			silk
	connect			props.body_state -> silk.collider_ball via rigid_surface body=ball
	connect			props.body_state -> silk.collider_cube via rigid_surface body=cube
	connect			silk.collider_reaction -> props.body_load via contact_reaction targets=ball,cube
	policy			implicit
	order			gauss-seidel
	member_order	props silk
	tolerance		1e-6
	absolute_tolerance	1e-4
	sub_iterations	40
	on_non_convergence	halve
	minimum_macro_step	0.002
}

#############################################################################################################
# Materials

uniformcolor_painter
{
	name			pnt_silk_warp
	color			0.03 0.05 0.25
}

uniformcolor_painter
{
	name			pnt_silk_weft
	color			0.10 0.06 0.35
}

weave_material
{
	name			mat_silk
	fabric			silk
	warp_color		pnt_silk_warp
	weft_color		pnt_silk_weft
	transmission	thin
	sheer			0.25
	warp_transmit	0.45
	weft_transmit	0.45
}

uniformcolor_painter
{
	name			pnt_gold
	color			1.0 0.78 0.34
}

ggx_material
{
	name			mat_gold
	rd				pnt_gold
	rs				pnt_gold
	alphax			0.12
	alphay			0.12
	fresnel_mode	schlick_f0
}

uniformcolor_painter
{
	name			pnt_ivory
	color			0.85 0.80 0.68
}

lambertian_material
{
	name			mat_ivory_base
	reflectance		pnt_ivory
}

coated_material
{
	name			mat_ivory
	base			mat_ivory_base
	coat_ior		1.5
	coat_roughness	0.06
}

uniformcolor_painter
{
	name			pnt_stage
	color			0.10 0.06 0.04
}

orennayar_material
{
	name			mat_stage_base
	reflectance		pnt_stage
	roughness		0.5
}

coated_material
{
	name			mat_stage
	base			mat_stage_base
	coat_ior		1.5
	coat_roughness	0.18
}

uniformcolor_painter
{
	name			pnt_curtain
	color			0.18 0.02 0.03
}

orennayar_material
{
	name			mat_curtain
	reflectance		pnt_curtain
	roughness		0.9
}

#############################################################################################################
# Objects

simulated_mesh_geometry
{
	name			geo_silk
	source			silk.surface
	double_sided	TRUE
}

standard_object
{
	name			silk_object
	geometry		geo_silk
	material		mat_silk
}

sphere_geometry
{
	name			geo_ball
	radius			0.085
}

standard_object
{
	name			ball
	geometry		geo_ball
	material		mat_ivory
	position		-0.22 0.16 0.02
	transform_source	props.bodies[ball]
}

box_geometry
{
	name			geo_cube
	width			0.14
	height			0.14
	depth			0.14
}

standard_object
{
	name			cube
	geometry		geo_cube
	material		mat_gold
	position		0.24 0.16 -0.03
	transform_source	props.bodies[cube]
}

clippedplane_geometry
{
	name			geo_stage
	pta				-6 -0.015 -6
	ptb				 6 -0.015 -6
	ptc				 6 -0.015  6
	ptd				-6 -0.015  6
}

standard_object
{
	name			stage
	geometry		geo_stage
	material		mat_stage
}

clippedplane_geometry
{
	name			geo_backcloth
	pta				-6 0 -1.6
	ptb				 6 0 -1.6
	ptc				 6 4 -1.6
	ptd				-6 4 -1.6
}

standard_object
{
	name			backcloth
	geometry		geo_backcloth
	material		mat_curtain
}

# A hard spotlight from above front, footlights, and a cool rim from behind.
spot_light
{
	name			spot
	position		0.4 3.2 1.4
	target			0 0.4 0
	color			1.0 0.9 0.75
	power			70
	inner			13
	outer			22
}

# Footlights: a warm strip at the stage's front edge, lighting the props and the canopy's underside.
rect_light
{
	name			footlights
	center			0.0 0.04 1.1
	size			1.4 0.08
	facing			0 0.55 -1
	color			1.0 0.8 0.55
	exitance		80
}

rect_light
{
	name			rim
	center			0.0 2.6 -1.2
	size			1.6 0.5
	facing			0 -1 0.7
	color			0.65 0.75 1.0
	exitance		14
}
