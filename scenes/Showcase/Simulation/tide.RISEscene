	name			mat_red
	base			mat_red_base
	coat_ior		1.5
	coat_roughness	0.15
}

uniformcolor_painter
{
	name			pnt_yellow
	color			0.85 0.6 0.05
}

lambertian_material
{
	name			mat_yellow_base
	reflectance		pnt_yellow
}

coated_material
{
	name			mat_yellow
	base			mat_yellow_base
	coat_ior		1.5
	coat_roughness	0.15
}

uniformcolor_painter
{
	name			pnt_blue
	color			0.05 0.18 0.55
}

lambertian_material
{
	name			mat_blue_base
	reflectance		pnt_blue
}

coated_material
{
	name			mat_blue
	base			mat_blue_base
	coat_ior		1.5
	coat_roughness	0.15
}

uniformcolor_painter
{
	name			pnt_green
	color			0.08 0.4 0.12
}

lambertian_material
{
	name			mat_green_base
	reflectance		pnt_green
}

coated_material
{
	name			mat_green
	base			mat_green_base
	coat_ior		1.5
	coat_roughness	0.15
}

uniformcolor_painter
{
	name			pnt_natural
	color			0.7 0.55 0.35
}

lambertian_material
{
	name			mat_natural_base
	reflectance		pnt_natural
}

coated_material
{
	name			mat_natural
	base			mat_natural_base
	coat_ior		1.5
	coat_roughness	0.15
}

uniformcolor_painter
{
	name			pnt_backdrop
	color			1.0 0.97 0.92
}

lambertian_luminaire_material
{
	name			mat_backdrop
	exitance		pnt_backdrop
	material		none
	scale			0.7
}

uniformcolor_painter
{
	name			pnt_table
	color			0.12 0.10 0.09
}

orennayar_material
{
	name			mat_table
	reflectance		pnt_table
	roughness		0.7
}

#############################################################################################################
# The water and the blocks

simulated_mesh_geometry
{
	name			geo_water
	source			water.surface
}

standard_object
{
	name			water_object
	geometry		geo_water
	material		mat_water
}

box_geometry
{
	name			geo_plank
	width			0.15
	height			0.04
	depth			0.06
}

standard_object
{
	name			plank
	geometry		geo_plank
	material		mat_red
	position		0.1 0.02 0
	transform_source	blocks.bodies[plank]
}

box_geometry
{
	name			geo_cube
	width			0.07
	height			0.07
	depth			0.07
}

standard_object
{
	name			cube
	geometry		geo_cube
	material		mat_yellow
	position		0.07 0.075 0
	transform_source	blocks.bodies[cube]
}

# The body's cylinder axis is its z; so is the geometry's, so the body's orientation turns both.
cylinder_geometry
{
	name			geo_pillar
	axis			z
	radius			0.03
	height			0.07
}

standard_object
{
	name			pillar
	geometry		geo_pillar
	material		mat_blue
	position		0.14 0.075 0
	transform_source	blocks.bodies[pillar]
}

box_geometry
{
	name			geo_lintel
	width			0.14
	height			0.03
	depth			0.05
}

standard_object
{
	name			lintel
	geometry		geo_lintel
	material		mat_green
	position		0.1 0.125 0
	transform_source	blocks.bodies[lintel]
}

box_geometry
{
	name			geo_tower
	width			0.045
	height			0.09
	depth			0.045
}

standard_object
{
	name			tower
	geometry		geo_tower
	material		mat_natural
	position		0.1 0.185 0
	transform_source	blocks.bodies[tower]
}

sphere_geometry
{
	name			geo_dome
	radius			0.03
}

standard_object
{
	name			dome
	geometry		geo_dome
	material		mat_red
	position		0.1 0.26 0
	transform_source	blocks.bodies[dome]
}

box_geometry
{
	name			geo_boat
	width			0.15
	height			0.036
	depth			0.06
}

standard_object
{
	name			boat
	geometry		geo_boat
	material		mat_blue
	position		-0.29 0.258 0.03
	transform_source	blocks.bodies[boat]
}

