# sand), a dark wall around the panel.

clippedplane_geometry
{
	name			geo_backdrop
	pta				-0.75 -0.0126 -0.62
	ptb				 0.75 -0.0126 -0.62
	ptc				 0.75  0.9    -0.62
	ptd				-0.75  0.9    -0.62
}

standard_object
{
	name			backdrop
	geometry		geo_backdrop
	material		mat_backdrop
}

clippedplane_geometry
{
	name			geo_wall
	pta				-4 -0.0126 -0.64
	ptb				 4 -0.0126 -0.64
	ptc				 4  3      -0.64
	ptd				-4  3      -0.64
}

