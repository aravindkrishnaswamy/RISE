RISE ASCII SCENE 7
#############################################################################################################
#                                                                                                           #
#   File:           tide.RISEscene                                                                          #
#   Idea:           A child's tower of painted wooden blocks stands on the dry sand of a glass aquarium; a  #
#                   dam of green water behind it is released with a toy boat riding on top.  The wave       #
#                   lifts the blocks off each other, the tower comes apart and the blocks and the boat      #
#                   float, roll and knock together while the water sloshes back and forth.  Backlit         #
#                   through the glass, with a softbox above throwing caustics on the sand.                  #
#   Simulations:    rigid.bodies `blocks` (six stacked blocks - boxes, a cylinder, a sphere - and the boat: #
#                   body-body contact, stacking, the tank as planes) and liquid.mac `water` (level set) in  #
#                   one simulation_group `tank`: the liquid owns the exchange and solves the bodies' six    #
#                   degrees of freedom in its pressure solve (two-way: buoyancy, drag, the wave's push and  #
#                   the bodies' wakes), rigid.bodies owns every contact.                                    #
#   Frame:          y up, metres; the tank's inside is the liquid domain, x -0.4..0.4, z -0.2..0.2.         #
#   Time:           4 s at 30 fps (121 frames).                                                             #
#   Proof/final:    a value followed by `# proof <value>` is the final setting; scripts/                    #
#                   simulation_showcase.sh proof substitutes the proof value.                               #
#   Bake/render:    scripts/simulation_showcase.sh proof|final tide   (docs/SIMULATION_SHOWCASE.md)          #
#   showcase:       hero 27 frames 0 12 45 90                                                                #
#                                                                                                           #
#############################################################################################################

standard_shader
{
	name			global
	shaderop		DefaultPathTracing
}

uniformcolor_painter
{
	name			pnt_env
	color			0.30 0.33 0.36
}

pathtracing_pel_rasterizer
{
	samples			512		# proof 64
	oidn_denoise	TRUE
	radiance_map	pnt_env
	radiance_scale	0.2
	radiance_background	FALSE
}

file_rasterizeroutput
{
	pattern			rendered/showcase/tide/final/tide		# proof rendered/showcase/tide/proof/tide
	multiple		TRUE
	type			PNG
	bpp				8
	color_space		sRGB
	display_transform	aces
}

film
{
	width			1920		# proof 640
	height			1080		# proof 360
}

animation_options
{
	time_start		0
	time_end		4
	num_frames		121
}

pinhole_camera
{
	location		0.12 0.21 0.88
	lookat			0.0 0.12 0.0
	up				0 1 0
	fov				38.0
}

#############################################################################################################
# Simulations

rigid_simulation
{
	name			blocks
	frames			121
	substeps		16
	body			plank box 0.15 0.04 0.06 density 650 at 0.1 0.02 0 friction 0.5 restitution 0.25
	body			cube box 0.07 0.07 0.07 density 650 at 0.07 0.075 0 friction 0.5 restitution 0.25
	body			pillar cylinder 0.03 0.07 density 650 at 0.14 0.075 0 orientation 0.70711 0.70711 0 0 friction 0.5 restitution 0.25
	body			lintel box 0.14 0.03 0.05 density 650 at 0.1 0.125 0 friction 0.5 restitution 0.25
	body			tower box 0.045 0.09 0.045 density 650 at 0.1 0.185 0 orientation 0.9659 0 0.2588 0 friction 0.5 restitution 0.25
	body			dome sphere 0.03 density 650 at 0.1 0.26 0 friction 0.5 restitution 0.25
	body			boat box 0.15 0.036 0.06 density 560 at -0.29 0.258 0.03 orientation 0.9848 0 0.1736 0 friction 0.5 restitution 0.25
	plane			0 0 0 0 1 0 restitution 0.1 friction 0.6
	plane			-0.4 0 0 1 0 0 restitution 0.2 friction 0.4
	plane			0.4 0 0 -1 0 0 restitution 0.2 friction 0.4
	plane			0 0 -0.2 0 0 1 restitution 0.2 friction 0.4
	plane			0 0 0.2 0 0 -1 restitution 0.2 friction 0.4
}

liquid_simulation
{
	name			water
	frames			121
	domain_min		-0.4 0 -0.2
	domain_size		0.8 0.6 0.4
	resolution		128		# proof 64
	threads			8
	liquid			box -0.4 0 -0.2 -0.19 0.245 0.2
	liquid			fill 0.025
	body			plank box 0.15 0.04 0.06 motion port at 0.1 0.02 0
	body			cube box 0.07 0.07 0.07 motion port at 0.07 0.075 0
	body			pillar cylinder 0.03 0.07 motion port at 0.14 0.075 0 orientation 0.70711 0.70711 0 0
	body			lintel box 0.14 0.03 0.05 motion port at 0.1 0.125 0
	body			tower box 0.045 0.09 0.045 motion port at 0.1 0.185 0 orientation 0.9659 0 0.2588 0
	body			dome sphere 0.03 motion port at 0.1 0.26 0
	body			boat box 0.15 0.036 0.06 motion port at -0.29 0.258 0.03 orientation 0.9848 0 0.1736 0
}

simulation_group
{
	name			tank
	members			water
	members			blocks
	connect			blocks.body_state -> water.body_state
	connect			blocks.body_mass_properties -> water.body_mass_properties
	connect			blocks.body_contact -> water.body_contact
	connect			water.body_load -> blocks.body_load
	policy			staggered
	order			gauss-seidel
	member_order	water blocks
	owned			water blocks
}

#############################################################################################################
# Materials

dielectric_material
{
	name				mat_water
	tau					0.06 0.42 0.33
	ior					1.333
	scattering			10000
	henyey-greenstein	FALSE
}

dielectric_material
{
	name				mat_glass
	tau					0.6 0.8 0.72
	ior					1.52
	scattering			10000
	henyey-greenstein	FALSE
}

