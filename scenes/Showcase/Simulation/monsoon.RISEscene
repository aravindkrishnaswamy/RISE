clippedplane_geometry
{
	name			geo_ground
	pta				-4 -0.002 -4
	ptb				 4 -0.002 -4
	ptc				 4 -0.002  4
	ptd				-4 -0.002  4
}

standard_object
{
	name			ground
	geometry		geo_ground
