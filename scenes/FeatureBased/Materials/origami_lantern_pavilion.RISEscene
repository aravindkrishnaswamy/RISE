	orientation	0.0 240.0 0.0
}

standard_object
{
	name		obj_sail_6
	geometry	geo_origami_sail
	material	mat_origami_paper
	modifier	mod_origami_combined
	position	-0.18 0.36 -0.10
	orientation	0.0 300.0 0.0
}

##################################################
# 3. DICHROIC VELVET & SPIRAL-GOLD BROCADE TORUS:
#    osl_fresnel + osl_layer_weight (Facing) +
#    osl_to_camera_vector + osl_vector_rotate + mix_material
##################################################

# Dichroic velvet colour shifts live with camera-space normal & facing angle:
# deep midnight-indigo facing camera -> glowing royal magenta-violet at grazing rim!
expression_painter
{
	name		pnt_dichroic_velvet
	def			ncam	osl_to_camera_vector(N)
	def			face	osl_layer_weight(0.48, vec3(0,0,0), 1)
	def			fres	osl_fresnel(1.42, vec3(0,0,0), 0)
	def			tilt	osl_clamp(0, ncam.x * 0.5 + 0.5, 0.0, 1.0)
	def			core	mix(vec3(0.04, 0.05, 0.16), vec3(0.08, 0.12, 0.26), tilt)
	def			rim		mix(vec3(0.55, 0.09, 0.36), vec3(0.14, 0.44, 0.62), tilt)
	expr		mix(core, rim, clamp(face * 0.85 + fres * 0.45, 0.0, 1.0))
}

lambertian_material
{
	name		mat_dichroic_velvet
	reflectance	pnt_dichroic_velvet
}

# Spiral brocade gold filigree bands computed with osl_vector_rotate!
scalar_painter
{
	name		sp_spiral_gold_w
	def			pr		osl_vector_rotate(0, 0, Po, vec3(0,0,0), vec3(0,1,0), Po.y * 4.5, vec3(0,0,0))
	def			ang		atan2(pr.z, pr.x)
	def			wave	sin(ang * 6.0 + length(vec3(pr.x, 0.0, pr.z)) * 18.0)
	def			band	smoothstep(0.62, 0.74, wave)
	expression	band
}

scalar_painter
{
	name		sp_velvet_w
	expression	1.0 - sample_scalar(sp_spiral_gold_w)
}

scalar_painter
{
	name		sp_velvet_nap_h
	expression	osl_noise_texture(Po * 55.0, 0.0, 3, 1, 3.0, 0.6, 2.0, 0.0, 1.0, 0.1, 1)
}

relief_modifier
{
	name		mod_velvet_nap
	height		sp_velvet_nap_h
	scale		0.002
	domain		surface
	max_slope	0.35
}

mix_material
{
	name		mat_brocade_torus
	child		mat_dichroic_velvet weight sp_velvet_w      modifier mod_velvet_nap
	child		mat_brass_inlay     weight sp_spiral_gold_w modifier none
}

torus_geometry
{
	name		geo_brocade_torus
	majorradius	0.36
	minorratio	0.36
}

standard_object
{
	name		obj_brocade_torus
	geometry	geo_brocade_torus
	material	mat_brocade_torus
	position	0.92 0.56 0.25
	orientation	62.0 -28.0 18.0
}

# Slender basalt pedestal cradling the brocade torus
lathe_geometry
{
	name			geo_torus_stand
	axis			y
	n_radial		40
	profile_point	0.00 0.00
	profile_point	0.26 0.00
	profile_point	0.24 0.04
	profile_point	0.11 0.08
	profile_point	0.09 0.16
	profile_point	0.16 0.21
	profile_point	0.00 0.19
}

standard_object
{
	name		obj_torus_stand
	geometry	geo_torus_stand
	material	mat_basalt
	position	0.92 0.00 0.25
}

##################################################
# 4. CAMERA-RAY GOSSAMER GALLERY VEIL:
#    osl_is_camera_ray() + mix_material + passthrough +
#    diffuse_transmission_material
##################################################

# Delicate golden-amber vellum & filigree veil:
#   - To camera rays (`osl_is_camera_ray() == 1`): 72% passthrough gossamer so the
#     viewer looks right through the etched veil at the origami lantern behind!
#   - To shadow & indirect rays (`osl_is_camera_ray() == 0`): denser translucent screen
#     that casts a warm golden tinted shadow onto the terrazzo floor!
expression_painter
{
	name		pnt_veil_refl
	def			g		osl_gradient(vec3(u, v, 0.0), 3)
	expr		mix(vec3(0.32, 0.26, 0.20), vec3(0.22, 0.32, 0.38), g)
}

expression_painter
{
	name		pnt_veil_trans
	def			g		osl_gradient(vec3(u, v, 0.0), 3)
	expr		mix(vec3(0.58, 0.36, 0.16), vec3(0.24, 0.44, 0.54), g)
}

diffuse_transmission_material
{
	name			mat_veil_vellum
	reflectance		pnt_veil_refl
	transmittance	pnt_veil_trans
}

# Gold filigree veins etched across the gossamer veil via Voronoi Distance-to-Edge
scalar_painter
{
	name		sp_veil_gold_w
	def			edge	osl_voronoi_distance(vec3(u * 4.0, v * 6.0, 0.0), 0.0, 2, 3, 0, 1.0, 0.0, 0.5, 2.0, 0.0, 2.0, 0.8, 1)
	def			border	max(max(step(u, 0.05), step(0.95, u)), max(step(v, 0.04), step(0.96, v)))
	def			vein	1.0 - smoothstep(0.015, 0.032, edge)
	expression	clamp(max(border, vein * 0.85), 0.0, 1.0)
}

scalar_painter
{
	name		sp_veil_pass_w
	def			cam		osl_is_camera_ray()
	def			gold	sample_scalar(sp_veil_gold_w)
	expression	(1.0 - gold) * mix(0.20, 0.74, cam)
}

scalar_painter
{
	name		sp_veil_vellum_w
	expression	clamp(1.0 - sample_scalar(sp_veil_gold_w) - sample_scalar(sp_veil_pass_w), 0.0, 1.0)
}

mix_material
{
	name		mat_gossamer_veil
	child		mat_veil_vellum weight sp_veil_vellum_w modifier none
	child		mat_brass_inlay weight sp_veil_gold_w   modifier none
	passthrough	weight sp_veil_pass_w
}

# Gently curved arched gallery screen
skin_geometry
{
	name		geo_gossamer_veil
	n_len		24
	n_across	12
	billow		0.08
	rail_a		-0.34 0.06  0.04
	rail_a		-0.34 0.52  0.00
	rail_a		-0.28 0.92  0.02
	rail_a		-0.14 1.12  0.04
	rail_b		 0.34 0.06 -0.04
	rail_b		 0.34 0.52  0.00
	rail_b		 0.28 0.92 -0.02
	rail_b		 0.14 1.12 -0.04
}

standard_object
{
	name		obj_gossamer_veil
	geometry	geo_gossamer_veil
	material	mat_gossamer_veil
	position	-0.84 0.00 0.56
	orientation	0.0 34.0 0.0
}

# Small basalt plinth foot under the gossamer screen
box_geometry
{
	name		geo_veil_foot
	width		0.76
	height		0.07
