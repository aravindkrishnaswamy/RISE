	size		0.014
	color		1.0 0.82 0.60
	exitance	220
}

sdf_geometry
{
	name	geo_alcove_sconce
	part	box union 0    -1.395 0.550 -0.33   0 0 0   1 1 1   0.035 0.045 0.060   0.006
}

standard_object
{
	name		obj_alcove_sconce
	geometry	geo_alcove_sconce
	material	mat_post
	position	0 0 0
