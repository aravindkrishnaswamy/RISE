RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           teapot.RISEscene                                                                              #
#   Description:    A simple Utah teapot                                                                    #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      January 23, 2002                                                                        #
#                                                                                                           #
#############################################################################################################

##################################################
# Setup a renderer
##################################################

hdr_painter
{
	name				pnt_rad
	file				lightprobes/rnl_probe.hdr
}

standard_shader
{
	name			global
	shaderop		DefaultPathTracing
}

# Migrated from pixelpel_rasterizer by tools/migrate_scenes_legacy_rasterizer.py (--mode full --integrator pt, legacy-deprecation Phase 2).
pathtracing_pel_rasterizer
{
	samples				16
	radiance_map		pnt_rad
	radiance_background	TRUE
	max_diffuse_bounce		0
}
/*
file_rasterizeroutput
{
	pattern				rendered/teapot/frame
	type				PNG
	bpp					8
	multiple			TRUE
	color_space			sRGB
}
*/

file_rasterizeroutput
{
	pattern				rendered/teapot
	type				PNG
	bpp					8
	color_space			sRGB
}


animation_options
{
	time_start			0.0
	time_end			1.0
	num_frames			120.000000000000
}

##################################################
# Cameras
##################################################

film
{
	width			1200
	height			800
}

pinhole_camera
{
	location			0 0 7.5
	lookat				0 0 0
	up					0 1 0
	fov					39.0
#	exposure			0.00416666666666667	
}

##################################################
# Painters
##################################################

#############################################################################################################
#									RISE Ascii Scene File													#
#																											#
#	File: 			colors.scn																				#
#   Description:	Contains commonly used colors from all scenes											#
#	Author: 		Aravind Krishnaswamy																	#
#	Birthdate:		November 14, 2003																		#
#																											#
#############################################################################################################
#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           standard_colors.RISEscene                                                               #
#   Description:    Contains some standard colors                                                           #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################

uniformcolor_painter
{
	name		color_black
	color		0.0 0.0 0.0
}

uniformcolor_painter
{
	name		color_white
	color		1.0 1.0 1.0
}













#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           povray_colors.RISEscene                                                                 #
#   Description:    Contains colors taken from POV-Ray                                                      #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################
















uniformcolor_painter
{
	name		color_gold
	color		0.8 0.498039 0.196078 
}






	
	

	






















uniformcolor_painter
{
	name		color_slateblue
	color		0.0 0.498039 1.0 
}






















uniformcolor_painter
{
	name		color_darkpurple
	color		0.53 0.12 0.47 
}
























perlin2d_painter
{
	name				pnt_perlin
	colora				color_darkpurple
	colorb				color_slateblue
	persistence			0.5
	scale				5 5
	shift				0 0
	octaves				4
}

perlin3d_painter
{
	name				pnt_perlin3d
	colora				color_white
	colorb				color_black
	persistence			0.5
	scale				5 5 5
	shift				0 0 0
	octaves				4
}

png_painter
{
	name				pnt_disp
	file				textures/waterbump.png
}

# Legacy phase 2 slice B2: was iridescent_painter (colora `color_darkpurple`, colorb `color_slateblue`, bias -0.5); now its
# projected-area mean colour (1-w) colora + w colorb, w = 0.2083; the view-dependent
# colour shift moved to the thin-film ggx_material(s) that bind it.
uniformcolor_painter
{
	name				pnt_iri
	color				0.41958 0.19876 0.58042
	colorspace			Rec709RGB_Linear
}

mandelbrot_painter
{
	name				pnt_mandelbrot
	colora				color_black
	colorb				color_white
	xstart				-1.75
	xend				0.75
	ystart				-1.25
	yend				1.25
	exponent			12.0
}

# Legacy phase 2 slice B2: was cooktorrance_material; cooktorrance_material -> ggx_material conductor, alpha = facets 0.1 (SCENE_CONVENTIONS 11.5).
ggx_material
{
	name				ct
	rd					color_black
	rs					color_gold
	alphax				0.1
	alphay				0.1
	fresnel_mode		conductor
	ior					1.8
	extinction			0
}

##################################################
# Materials
##################################################

# Legacy phase 2 slice B2: white F0 tint for the thin-film materials.
uniformcolor_painter
{
	name				pnt_tf_white
	color				1 1 1
	colorspace			Rec709RGB_Linear
}

scalar_painter
{
	name				tf_Ti_n
	file				colors/thinfilm/substrates/Ti.n
}

scalar_painter
{
	name				tf_Ti_k
	file				colors/thinfilm/substrates/Ti.k
}

scalar_painter
{
	name				tf_TiO2_n
	file				colors/thinfilm/oxides/TiO2.n
}

scalar_painter
{
	name				tf_TiO2_k
	file				colors/thinfilm/oxides/TiO2.k
}

# Legacy phase 2 slice B2: substrate of `polished` (was polished_material reflectance).
# Legacy phase 2 slice B2: was lambertian_material; lambertian with iridescent `pnt_iri` -> pearlescent ggx: rd = mean colour 0.42 0.199 0.58 (w 0.208), TiO2 film 120 nm over a 1.5 dielectric (alpha 0.3), thickness matching colorb's hue.
ggx_material
{
	name				polished_base
	rd					pnt_iri
	rs					pnt_tf_white
	alphax				0.3
	alphay				0.3
	fresnel_mode		thinfilm
	ior					1.5
	extinction			0
	film_ior			tf_TiO2_n
	film_extinction		tf_TiO2_k
	film_thickness		120
}

# Legacy phase 2 slice B2: was polished_material (Fresnel dielectric coat over a Lambertian substrate) ->
# coated_material over `polished_base`; coat_weight = tau 0.9 0.91 0.98 (Rec.709 luminance; the tint is dropped), coat_ior 3 (ior 10000 clamped to coated_material's [1, 3]), coat_roughness 1/sqrt(2*256+1) = 0.04415 (SCENE_CONVENTIONS 11.5).
coated_material
{
	name				polished
	base				polished_base
	coat_weight			0.9129
	coat_ior			3
	coat_roughness		0.04415
}

# Legacy phase 2 slice B2: was perfectreflector_material; perfectreflector with iridescent `pnt_iri` -> near-mirror (alpha 0.01) TiO2 film 150 nm over titanium, thickness matching colorb's hue.
ggx_material
{
	name				perf_ref
	rd					none
	rs					pnt_tf_white
	alphax				0.01
	alphay				0.01
	fresnel_mode		thinfilm
	ior					tf_Ti_n
	extinction			tf_Ti_k
	film_ior			tf_TiO2_n
	film_extinction		tf_TiO2_k
	film_thickness		150
}

lambertian_material
{
	name				white
	reflectance			color_white
}

##################################################
# Objects
##################################################
#
# Displacement pipeline: bicubic Bezier patches are the underlying shape
# (tessellated on demand by DisplacedGeometry), and the displacement map
# is applied along per-vertex normals of the tessellated mesh.  Using
# bezierpatch_geometry as the base keeps a single source of truth for
# the Utah teapot model — the same .bezier file feeds the analytic
# test variant (scenes/Tests/Geometry/teapot_analytic.RISEscene) and this
# displacement showcase.
#
bezierpatch_geometry
{
	name				teapotgeom_base
	file				models/raw/teapot.bezier
	maxpatches			2
	maxdepth			7
	bsp					TRUE
	center_object		TRUE
}

displaced_geometry
{
	name				teapotgeom
	base_geometry		teapotgeom_base
	detail				128
	displacement		pnt_disp
	disp_scale			0.1
	maxpolygons			10
	maxdepth			24
	bsp					TRUE
}

standard_object
{
	name				teapot
	geometry			teapotgeom
	orientation			20 -20 0
	material			perf_ref
	casts_shadows		FALSE
	receives_shadows	FALSE
}
/*
directional_light
{
	name		light
	power		3.0
	color		1.0 1.0 1.0
	direction	0 0 1
}
*/
omni_light
{
	name		light
	power		900.0
	color		1.0 1.0 1.0
	position	0 0 8.5
}
/*
timeline
{
	element_type		object
	element				teapot
	param				orientation

	time 0
	value 0 0 0

	time 0.5
	value 90 270 0

	time 1
	value 360 360 0
}
*/

timeline
{
	element_type		camera
	param				target_orientation

	interpolator		hermite

	time 0
	value 0 0

	time 0.25
	value 90 90

	time 0.50
	value 0 180

	time 0.75
	value -10 270

	time 1
	value 0 360
}

timeline
{
	element_type		light
	element				light
	param				position

	interpolator		hermite

	time 0
	value 0 0 800

	time 0.25
	value 800 800 0

	time 0.50
	value 0 0 -800

	time 0.75
	value -800 -1.5 0

	time 1
	value 0 0 800
}



