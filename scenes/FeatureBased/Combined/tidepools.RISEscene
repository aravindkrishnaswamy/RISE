RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           tidepools.RISEscene                                                                     #
#   Description:    An abstract tidepool scene with water-like refractive surfaces, pebble-textured         #
#                   floor, and organic shapes. Thin lens camera provides depth of field.                    #
#                   Tests: thin lens camera + DOF, dielectric on torus, Perlin3D as material texture,      #
#                          IBL with uffizi probe, Voronoi3D painter, blend painter, ellipsoid geometry      #
#   Author:         Generated for integration testing                                                       #
#                                                                                                           #
#############################################################################################################

> set accelerator B 10 8

##################################################
# Setup a renderer
##################################################

hdr_painter
{
	name				pnt_env
	file				lightprobes/uffizi_probe.hdr
}
standard_shader
{
	name		global
	shaderop	DefaultPathTracing
}

pathtracing_pel_rasterizer
{
	samples                       64
	oidn_denoise                  TRUE
	pathguiding                   FALSE
	pathguiding_sampling_type     RIS
	pathguiding_iterations        6
	pathguiding_spp               12
	pathguiding_alpha             0.5
	pathguiding_max_depth         8
	adaptive_max_samples	128
	adaptive_threshold		0.05
	radiance_map		pnt_env
	radiance_background	TRUE
}

file_rasterizeroutput
{
	pattern				rendered/tidepools
	type				PNG
	bpp					8
	color_space			sRGB
}

##################################################
# Cameras - Thin lens with depth of field
##################################################

# Camera 4 m back and 2.5 m up, looking down at the tidepool.
# Distance ≈ √(2.6² + 4²) ≈ 4.8 m.  85mm short-tele at f/1.8 —
# intimate look on the pool, with the floor pebbles and surrounding
# stones falling into a soft creamy bokeh.

film
{
	width			800
	height			600
}

thinlens_camera
{
	location			0 2.5 4.0
	lookat				0 -0.1 0
	up					0 1 0
	sensor_size			36              # mm — full-frame
	focal_length		85              # mm — short tele
	fstop				1.8
	focus_distance		4.8             # metres — onto the pool surface
}

##################################################
# Painters
##################################################

#############################################################################################################
#									RISE Ascii Scene File													#
#																											#
#	File: 			colors.scn																				#
#   Description:	Contains commonly used colors from all scenes											#
#	Author: 		Aravind Krishnaswamy																	#
#	Birthdate:		November 14, 2003																		#
#																											#
#############################################################################################################
#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           standard_colors.RISEscene                                                               #
#   Description:    Contains some standard colors                                                           #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################

uniformcolor_painter
{
	name		color_black
	color		0.0 0.0 0.0
}

uniformcolor_painter
{
	name		color_white
	color		1.0 1.0 1.0
}













#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           povray_colors.RISEscene                                                                 #
#   Description:    Contains colors taken from POV-Ray                                                      #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################






















	
	

	




































































uniformcolor_painter
{
	name				pnt_rock_dark
	color				0.45 0.42 0.35
}

uniformcolor_painter
{
	name				pnt_rock_light
	color				0.65 0.58 0.48
}

# Perlin3D for rocky/pebble floor texture
perlin3d_painter
{
	name				pnt_rock
	colora				pnt_rock_dark
	colorb				pnt_rock_light
	persistence			0.65
	octaves				6
	scale				5.0 5.0 5.0
}

# Voronoi3D cell colors
uniformcolor_painter
{
	name				pnt_vor_border
	color				0.3 0.25 0.2
}

uniformcolor_painter
{
	name				pnt_vor_tan1
	color				0.55 0.5 0.4
}

uniformcolor_painter
{
	name				pnt_vor_tan2
	color				0.6 0.55 0.45
}

uniformcolor_painter
{
	name				pnt_vor_tan3
	color				0.5 0.45 0.38
}

uniformcolor_painter
{
	name				pnt_vor_tan4
	color				0.58 0.52 0.42
}

uniformcolor_painter
{
	name				pnt_vor_tan5
	color				0.52 0.48 0.4
}

# Voronoi3D for cracked mud / cellular pattern
voronoi3d_painter
{
	name				pnt_voronoi
	border				pnt_vor_border
	bordersize			0.04
	gen					0.2 0.3 0.1 pnt_vor_tan1
	gen					0.7 0.1 0.8 pnt_vor_tan2
	gen					0.4 0.8 0.5 pnt_vor_tan3
	gen					0.9 0.6 0.3 pnt_vor_tan4
	gen					0.1 0.5 0.9 pnt_vor_tan5
}

# Blend painter: mix rock and voronoi for the pool floor
perlin2d_painter
{
	name				pnt_mask
	colora				color_black
	colorb				color_white
	persistence			0.4
	octaves				3
	scale				3.0 3.0
}

blend_painter
{
	name				pnt_poolfloor
	colora				pnt_rock
	colorb				pnt_voronoi
	mask				pnt_mask
}


uniformcolor_painter
{
	name				pnt_moss
	color				0.25 0.4 0.2
}

# Iridescent for the shell-like object
uniformcolor_painter
{
	name				pnt_shell_blue
	color				0.3 0.5 0.7
}

uniformcolor_painter
{
	name				pnt_shell_pink
	color				0.7 0.4 0.5
}

# Legacy phase 2 slice C: was iridescent_painter (colora `pnt_shell_blue`, colorb `pnt_shell_pink`, bias 0.5); now its
# projected-area mean colour (1-w) colora + w colorb, w = 0.9583; the view-dependent
# colour shift moved to the thin-film ggx_material(s) that bind it.
uniformcolor_painter
{
	name				pnt_shell
	color				0.68333 0.40417 0.50833
	colorspace			Rec709RGB_Linear
}

##################################################
# Materials
##################################################

# Pool floor - Oren-Nayar rough surface with blended texture
orennayar_material
{
	name				pool_floor
	reflectance			pnt_poolfloor
	roughness			0.7
}

# Water surface - dielectric
dielectric_material
{
	name				water
	tau			0.85 0.92 0.95
	ior					1.33
	scattering			5000.0
}

# Wet pebbles - a clear coat over a Perlin-textured base.  The coat weight
# (polished `tau` before the slice-C migration) is locked to unity
# here as an authoring choice (a uniform coat coverage), not because
# the engine can't vary it: scalar_painter has since gained a `painter`
# form (the P2.1 any-painter bridge, docs/WETNESS_COAT_DESIGN.md §3.6) that
# binds ANY colour painter with a channel select, so
# `scalar_painter { painter pnt_rock channel R }` bound to `coat_weight` would let
# the coat coverage follow the same perlin field driving `reflectance`
# below.  (An earlier version of this comment said scalar_painter had no
# way to read a spatial painter at all; that stopped being true once the
# `painter` bridge landed.)  The spatial colour variation still lives in
# the perlin painter via `reflectance`.
# Legacy phase 2 slice C: substrate of `wet_rock` (was polished_material reflectance).
lambertian_material
{
	name				wet_rock_base
	reflectance			pnt_rock
}

# Legacy phase 2 slice C: was polished_material (Fresnel dielectric coat over a Lambertian substrate) ->
# coated_material over `wet_rock_base`; coat_weight = tau 1, coat_ior 1.45, coat_roughness 1/sqrt(2*800+1) = 0.02499 (SCENE_CONVENTIONS 11.5).
coated_material
{
	name				wet_rock
	base				wet_rock_base
	coat_weight			1
	coat_ior			1.45
	coat_roughness		0.02499
}

# Moss-covered rock - Oren-Nayar
orennayar_material
{
	name				mossy
	reflectance			pnt_moss
	roughness			0.95
}

# Legacy phase 2 slice C: white F0 tint for the thin-film materials.
uniformcolor_painter
{
	name				pnt_tf_white
	color				1 1 1
	colorspace			Rec709RGB_Linear
}

scalar_painter
{
	name				tf_TiO2_n
	file				colors/thinfilm/oxides/TiO2.n
}

scalar_painter
{
	name				tf_TiO2_k
	file				colors/thinfilm/oxides/TiO2.k
}

# Shell-like iridescent material (a thin-film GGX since slice C)
# Legacy phase 2 slice C: was lambertian_material; lambertian with iridescent `pnt_shell` -> pearlescent ggx: rd = mean colour 0.683 0.404 0.508 (w 0.958), TiO2 film 280 nm over a 1.5 dielectric (alpha 0.3), thickness matching its normal-incidence colour 0.7 0.4 0.5.
ggx_material
{
	name				shell
	rd					pnt_shell
	rs					pnt_tf_white
	alphax				0.3
	alphay				0.3
	fresnel_mode		thinfilm
	ior					1.5
	extinction			0
	film_ior			tf_TiO2_n
	film_extinction		tf_TiO2_k
	film_thickness		280
}

##################################################
# Geometries & Objects
##################################################

# Pool floor
infiniteplane_geometry
{
	name				floorgeom
	xtile				0.5
	ytile				0.5
}

standard_object
{
	name				floor
	geometry			floorgeom
	position			0.0 -0.5 0.0
	orientation			-90.0 0.0 0.0
	material			pool_floor
}

# Shallow water disk (ellipsoid squashed flat)
ellipsoid_geometry
{
	name				watergeom
	radii				1.25 0.04 1.25
}

standard_object
{
	name				water_surface
	geometry			watergeom
	position			0 -0.1 0
	material			water
}

# Pebbles (various ellipsoids with wet rock material)
ellipsoid_geometry
{
	name				pebble1geom
	radii				0.1 0.05 0.075
}

ellipsoid_geometry
{
	name				pebble2geom
	radii				0.075 0.04 0.09
}

ellipsoid_geometry
{
	name				pebble3geom
	radii				0.125 0.06 0.1
}

standard_object
{
	name				pebble1
	geometry			pebble1geom
	position			-0.6 -0.4 0.3
	orientation			0 25 10
	material			wet_rock
}

standard_object
{
	name				pebble2
	geometry			pebble2geom
	position			0.4 -0.42 -0.2
	orientation			10 -15 5
	material			wet_rock
}

standard_object
{
	name				pebble3
	geometry			pebble3geom
	position			-0.2 -0.38 -0.6
	orientation			5 40 0
	material			wet_rock
}

standard_object
{
	name				pebble4
	geometry			pebble1geom
	position			0.8 -0.4 0.7
	orientation			0 -60 15
	material			wet_rock
}

# Mossy rock (larger)
sphere_geometry
{
	name				rockgeom
	radius				0.4
}

standard_object
{
	name				mossy_rock
	geometry			rockgeom
	position			-1.2 -0.15 -0.3
	material			mossy
}

# Torus ring partially submerged (like a sea creature)
torus_geometry
{
	name				torusgeom
	majorradius			0.35
	minorratio			0.15
}

standard_object
{
	name				glass_ring
	geometry			torusgeom
	position			0.5 -0.05 0.3
	orientation			30 0 15
	material			water
}

# Shell-like object (small torus with iridescent material)
torus_geometry
{
	name				shellgeom
	majorradius			0.12
	minorratio			0.35
}

standard_object
{
	name				shell_obj
	geometry			shellgeom
	position			0.1 -0.35 0.8
	orientation			-20 45 0
	material			shell
}

# Another shell
standard_object
{
	name				shell_obj2
	geometry			shellgeom
	position			-0.8 -0.38 0.6
	orientation			10 -30 15
	material			shell
}

##################################################
# Lights
##################################################

directional_light
{
	name				sun
	power				4.0
	color				1.0 0.95 0.85
	colorspace			sRGB
	# RISE convention: `direction` FROM surface TO light, lit when N·dir > 0.
	direction			0.3 1.0 -0.5
}

# Warm fill from below/side to add life
omni_light
{
	name				warm_fill
	power				1.5
	color				1.0 0.85 0.6
	colorspace			sRGB
	position			2 1.5 3
}

# Cool rim light from behind
spot_light
{
	name				rim_light
	position			0 3 -3
	target				0 0 0
	color				0.7 0.8 1.0
	colorspace			sRGB
	power				4.0
	inner				20
	outer				50
}

