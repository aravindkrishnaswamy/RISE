RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           showroom.RISEscene                                                                      #
#   Description:    A showroom displaying the torus knot mesh with iridescent material, a Ward              #
#                   anisotropic cylinder, and various objects under ambient occlusion with IBL from          #
#                   St. Peter's Basilica light probe. Features the adaptive rasterizer.                     #
#                   Tests: risemesh (torusknot), iridescent painter as material, Ward anisotropic on        #
#                          cylinder, ambient occlusion + IBL (stpeters probe), adaptive rasterizer,         #
#                          lines painter, Ashikmin-Shirley material                                        #
#   Author:         Generated for integration testing                                                       #
#                                                                                                           #
#############################################################################################################

> set accelerator B 10 8

##################################################
# Setup a renderer
##################################################

hdr_painter
{
	name				pnt_env
	file				lightprobes/stpeters_probe.hdr
}

standard_shader
{
	name			global
	shaderop		DefaultPathTracing
}

standard_shader
{
	name			glossy_shader
	shaderop		DefaultPathTracing
}

# Migrated from pixelpel_rasterizer by tools/migrate_scenes_legacy_rasterizer.py (--mode full --integrator pt, legacy-deprecation Phase 2).
pathtracing_pel_rasterizer
{
	samples				64
	radiance_map		pnt_env
	radiance_background	TRUE
	# Phase 2 slice B1 retune (owner-approved): radiance_scale 1 -> 1.75 (measured 0.648 vs legacy 0.649); the legacy chain added an ambient-occlusion term (0.20 of its 0.649 mean) that ruling #6 drops
	radiance_scale		1.75
}

file_rasterizeroutput
{
	pattern				rendered/showroom
	type				PNG
	bpp					8
	color_space			sRGB
}

##################################################
# Cameras
##################################################

film
{
	width			800
	height			600
}

pinhole_camera
{
	location			0 3.0 8.0
	lookat				0 1.0 0
	up					0 1 0
	fov					35.0
}

##################################################
# Painters
##################################################

#############################################################################################################
#									RISE Ascii Scene File													#
#																											#
#	File: 			colors.scn																				#
#   Description:	Contains commonly used colors from all scenes											#
#	Author: 		Aravind Krishnaswamy																	#
#	Birthdate:		November 14, 2003																		#
#																											#
#############################################################################################################
#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           standard_colors.RISEscene                                                               #
#   Description:    Contains some standard colors                                                           #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################















#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           povray_colors.RISEscene                                                                 #
#   Description:    Contains colors taken from POV-Ray                                                      #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################






















	
	

	




































































# Iridescent painter for the torus knot
uniformcolor_painter
{
	name				pnt_iri_blue
	color				0.2 0.4 0.8
}

uniformcolor_painter
{
	name				pnt_iri_pink
	color				0.8 0.3 0.5
}

# Legacy phase 2 slice B2: was iridescent_painter (colora `pnt_iri_blue`, colorb `pnt_iri_pink`, bias 0.4); now its
# projected-area mean colour (1-w) colora + w colorb, w = 0.9280; the view-dependent
# colour shift moved to the thin-film ggx_material(s) that bind it.
uniformcolor_painter
{
	name				pnt_iridescent
	color				0.7568 0.3072 0.5216
	colorspace			Rec709RGB_Linear
}

# Lines painter for the display platform
uniformcolor_painter
{
	name				pnt_lines_dark
	color				0.15 0.15 0.15
}

uniformcolor_painter
{
	name				pnt_lines_light
	color				0.25 0.25 0.25
}

lines_painter
{
	name				pnt_lines
	colora				pnt_lines_dark
	colorb				pnt_lines_light
	size				0.02
}

uniformcolor_painter
{
	name				pnt_brushed_metal
	color				0.65 0.63 0.6
}

uniformcolor_painter
{
	name				pnt_brushed_spec
	color				0.9 0.88 0.85
}

uniformcolor_painter
{
	name				pnt_darkgray
	color				0.2 0.2 0.2
}

uniformcolor_painter
{
	name				pnt_warm_white
	color				0.95 0.92 0.88
}

uniformcolor_painter
{
	name				pnt_ruby
	color				0.6 0.1 0.15
}

uniformcolor_painter
{
	name				pnt_ruby_spec
	color				0.95 0.6 0.65
}

# Anisotropic highlight parameters for the cylinder


# Ashikmin-Shirley Nu/Nv


##################################################
# Materials
##################################################

# Legacy phase 2 slice B2: white F0 tint for the thin-film materials.
uniformcolor_painter
{
	name				pnt_tf_white
	color				1 1 1
	colorspace			Rec709RGB_Linear
}

scalar_painter
{
	name				tf_Ti_n
	file				colors/thinfilm/substrates/Ti.n
}

scalar_painter
{
	name				tf_Ti_k
	file				colors/thinfilm/substrates/Ti.k
}

scalar_painter
{
	name				tf_TiO2_n
	file				colors/thinfilm/oxides/TiO2.n
}

scalar_painter
{
	name				tf_TiO2_k
	file				colors/thinfilm/oxides/TiO2.k
}

# Iridescent material for the torus knot
# Legacy phase 2 slice B2: was lambertian_material; lambertian with iridescent `pnt_iridescent` -> pearlescent ggx: rd = mean colour 0.757 0.307 0.522 (w 0.928), TiO2 film 300 nm over a 1.5 dielectric (alpha 0.3), thickness matching its normal-incidence colour 0.8 0.3 0.5.
ggx_material
{
	name				iridescent_mat
	rd					pnt_iridescent
	rs					pnt_tf_white
	alphax				0.3
	alphay				0.3
	fresnel_mode		thinfilm
	ior					1.5
	extinction			0
	film_ior			tf_TiO2_n
	film_extinction		tf_TiO2_k
	film_thickness		300
}

# Brushed metal cylinder - Ward anisotropic
# Legacy phase 2 slice B2: was ward_anisotropic_material; ward_anisotropic alphax 0.01 alphay 0.3 carried, rs -> F0 (schlick_f0) (SCENE_CONVENTIONS 11.5).
ggx_material
{
	name				brushed_metal
	rd					pnt_brushed_metal
	rs					pnt_brushed_spec
	alphax				0.01
	alphay				0.3
	fresnel_mode		schlick_f0
}

# Display platform - lines pattern
lambertian_material
{
	name				platform_mat
	reflectance			pnt_lines
}

# Dark gallery floor
lambertian_material
{
	name				floor_mat
	reflectance			pnt_darkgray
}

# Ashikmin-Shirley anisotropic for a vase-like object
# Legacy phase 2 slice B2: was ashikminshirley_anisotropicphong_material; ashikmin-shirley nu 10 nv 500 -> alphax 0.4082 alphay 0.06312 (sqrt(2/(n+2))), rs -> F0 (schlick_f0) (SCENE_CONVENTIONS 11.5).
ggx_material
{
	name				ashikmin_mat
	rd					pnt_warm_white
	rs					pnt_warm_white
	alphax				0.40825
	alphay				0.063119
	fresnel_mode		schlick_f0
}

# Glossy ruby sphere - Schlick
# Legacy phase 2 slice B2: was schlick_material; schlick roughness 0.05 -> alpha sqrt(r) = 0.2236, rs -> F0 (schlick_f0) (SCENE_CONVENTIONS 11.5).
ggx_material
{
	name				ruby
	rd					pnt_ruby
	rs					pnt_ruby_spec
	alphax				0.22361
	alphay				0.22361
	fresnel_mode		schlick_f0
}

##################################################
# Geometries & Objects
##################################################

# Floor (clipped plane for irradiance cache compatibility)
clippedplane_geometry
{
	name				floorgeom
	pta					-8.0 0.0 -6.0
	ptb					-8.0 0.0 6.0
	ptc					8.0 0.0 6.0
	ptd					8.0 0.0 -6.0
}

standard_object
{
	name				floor
	geometry			floorgeom
	position			0.0 0.0 0.0
	material			floor_mat
}

# Central display platform
cylinder_geometry
{
	name				platformgeom
	axis				y
	radius				1.2
	height				0.3
}

standard_object
{
	name				platform
	geometry			platformgeom
	position			0 0.15 0
	material			platform_mat
}

# Torus knot (risemesh) - central showpiece with iridescent material
risemesh_geometry
{
	name				torusknot_geom
	file				models/risemesh/torusknot.risemesh
}

standard_object
{
	name				torus_knot
	geometry			torusknot_geom
	position			0 1.5 0
	orientation			0 30 0
	scale				0.008 0.008 0.008
	material			iridescent_mat
}

# Brushed metal cylinder - left display
cylinder_geometry
{
	name				metalcylgeom
	axis				y
	radius				0.4
	height				2.0
}

standard_object
{
	name				metal_cylinder
	geometry			metalcylgeom
	position			-3.0 1.0 -1.0
	material			brushed_metal
	shader				glossy_shader
}

# Ashikmin-Shirley ellipsoid - right display
ellipsoid_geometry
{
	name				vasegeom
	radii				0.25 0.5 0.25
}

standard_object
{
	name				ashikmin_vase
	geometry			vasegeom
	position			3.0 1.0 -1.0
	material			ashikmin_mat
	shader				glossy_shader
}

# Ruby sphere in the foreground
sphere_geometry
{
	name				rubygeom
	radius				0.35
}

standard_object
{
	name				ruby_sphere
	geometry			rubygeom
	position			1.5 0.35 2.5
	material			ruby
	shader				glossy_shader
}

# Small display pedestals for side objects
box_geometry
{
	name				sidepedestalgeom
	width				0.8
	height				0.6
	depth				0.8
}

standard_object
{
	name				pedestal_left
	geometry			sidepedestalgeom
	position			-3.0 0.3 -1.0
	material			platform_mat
}

standard_object
{
	name				pedestal_right
	geometry			sidepedestalgeom
	position			3.0 0.3 -1.0
	material			platform_mat
}

##################################################
# Lights
##################################################

directional_light
{
	name				key
	power				2.0
	color				1.0 0.98 0.93
	colorspace			sRGB
	# RISE convention: `direction` FROM surface TO light, lit when N·dir > 0.
	direction			0.5 1.0 -0.3
}

omni_light
{
	name				fill
	power				500.0
	color				0.9 0.92 1.0
	colorspace			sRGB
	position			4 5 6
}


