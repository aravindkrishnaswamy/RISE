RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           spotlight_drama.RISEscene                                                               #
#   Description:    A dramatic stage with colored spot lights illuminating SSS objects and casting           #
#                   colored shadows. A translucent dragon is backlit, a wax-like bunny glows with           #
#                   diffusion SSS, and a reflective floor catches all the light interplay.                 #
#                   Tests: colored spot lights, simple SSS + diffusion SSS, reflective floor with          #
#                          distribution tracing, risemesh (dragon + bunny), translucent material,          #
#                          perfectreflector + distribution tracing                                         #
#   Author:         Generated for integration testing                                                       #
#                                                                                                           #
#############################################################################################################

> set accelerator B 10 8

##################################################
# Scene-level options.  Geometry coords are in metres — a 30m × 20m
# stage with characters at human/dragon scales.  scene_unit defaults
# to 1.0 (metres), so no scene_options block is needed; the camera's
# mm-input lens params are converted internally.
##################################################

##################################################
# Setup a renderer
# Note: SSS shaders are defined after the painters section
# because they need color_white from the colors script.
##################################################

standard_shader
{
	name		floor_shader
	shaderop		DefaultPathTracing
}

standard_shader
{
	name		global
	shaderop		DefaultPathTracing
}

# Migrated from pixelpel_rasterizer by tools/migrate_scenes_legacy_rasterizer.py (--mode full --integrator pt, legacy-deprecation Phase 2).
pathtracing_pel_rasterizer
{
	samples				256
}

file_rasterizeroutput
{
	pattern				rendered/spotlight_drama
	type				PNG
	bpp					8
	color_space			sRGB
}

##################################################
# Cameras
##################################################

# Camera 18 m back and 10 m up, looking at the stage centre 3 m up.
# Distance ≈ √(7² + 15²) ≈ 16.6 m → focus on the characters.
# 85mm short telephoto wide-open at f/1.4 — cinematic shallow DOF.
# Floor edges and back curtain blur out beyond the characters.

film
{
	width			800
	height			600
}

thinlens_camera
{
	location			0 10 18
	lookat				0 3 3
	up					0 1 0
	sensor_size			36              # mm — full-frame
	focal_length		85              # mm — short tele
	fstop				1.4             # cinema-prime fast aperture
	focus_distance		16              # metres — onto the dragon / bunny plane
}

##################################################
# Painters
##################################################

#############################################################################################################
#									RISE Ascii Scene File													#
#																											#
#	File: 			colors.scn																				#
#   Description:	Contains commonly used colors from all scenes											#
#	Author: 		Aravind Krishnaswamy																	#
#	Birthdate:		November 14, 2003																		#
#																											#
#############################################################################################################
#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           standard_colors.RISEscene                                                               #
#   Description:    Contains some standard colors                                                           #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################


uniformcolor_painter
{
	name		color_white
	color		1.0 1.0 1.0
}













#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           povray_colors.RISEscene                                                                 #
#   Description:    Contains colors taken from POV-Ray                                                      #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################






















	
	

	




































































uniformcolor_painter
{
	name				pnt_jade_ref
	color				0.15 0.25 0.15
}

uniformcolor_painter
{
	name				pnt_jade_tau
	color				0.2 0.4 0.25
}

uniformcolor_painter
{
	name				pnt_wax_ref
	color				0.3 0.28 0.22
}

uniformcolor_painter
{
	name				pnt_wax_tau
	color				0.55 0.5 0.4
}

uniformcolor_painter
{
	name				pnt_stage_floor
	color				0.3 0.3 0.35
}

uniformcolor_painter
{
	name				pnt_curtain
	color				0.25 0.05 0.05
}

##################################################
# SSS Shaders (after colors script so color_white is available)
##################################################

# White lambertian BSDF the legacy point-cloud SSS ops gathered their irradiance
# with (unreferenced since legacy-deprecation Phase 2 slice B1 converted those ops
# to subsurfacescattering_material; kept so the scene's material set is unchanged)
lambertian_material
{
	name				sss_white
	reflectance			color_white
}

standard_shader
{
	name		dragon_shader
	shaderop		DefaultPathTracing
}

standard_shader
{
	name		bunny_shader
	shaderop		DefaultPathTracing
}

##################################################
# Materials
##################################################

# Translucent jade-like material for the dragon
# ref + tau must be <= 1.0 per channel to conserve energy
translucent_material
{
	name				jade
	ref					pnt_jade_ref
	tau					pnt_jade_tau
	ext			0
	N					1.4
	scattering			0.7
}

# Wax-like material for the bunny
# ref + tau must be <= 1.0 per channel to conserve energy
translucent_material
{
	name				wax
	ref					pnt_wax_ref
	tau					pnt_wax_tau
	ext			0
	N					1.5
	scattering			0.5
}

# Reflective stage floor
perfectreflector_material
{
	name				mirror_floor
	reflectance			pnt_stage_floor
}

# Curtain backdrop
orennayar_material
{
	name				curtain
	reflectance			pnt_curtain
	roughness			0.9
}

# White pedestal
lambertian_material
{
	name				pedestal_mat
	reflectance			color_white
}

##################################################
# Geometries & Objects
##################################################

# Stage floor
box_geometry
{
	name				floorgeom
	width				30.0
	height				0.2
	depth				20.0
}

standard_object
{
	name				stage_floor
	geometry			floorgeom
	position			0 -0.1 0
	material			mirror_floor
	shader				floor_shader
}

# Curtain backdrop
clippedplane_geometry
{
	name				curtaingeom
	pta					-15.0 15.0 0.0
	ptb					-15.0 0.0 0.0
	ptc					15.0 0.0 0.0
	ptd					15.0 15.0 0.0
}

standard_object
{
	name				curtain
	geometry			curtaingeom
	position			0 0 -8
	material			curtain
}

# Dragon - translucent jade with simple SSS
# Dragon model is ~0.6 units tall natively, scaled 10x to ~6 units
risemesh_geometry
{
	name				dragongeom
	file				models/risemesh/dragon_small.risemesh
}

# Green jade (re-authored in legacy-deprecation Phase 2 slice B1, owner-approved; was the
# point-cloud simple_sss_shaderop `sss_simple`, whose white override BSDF hid the jade colour).
# Christensen-Burley subsurfacescattering_material (as the scene's other SSS objects): its
# diffuse reflectance (albedo) is the scene's authored jade colour 0.15 0.25 0.15 (pnt_jade_ref),
# and its profile tail falls off at 10 per unit (a ~0.1-unit glow on the ~6-unit dragon), so it
# reads as translucent stone rather than a glowing surface.
subsurfacescattering_material
{
	name			sss_simple_sss_jade
	ior			1.3
	absorption	7.89779 8.30641 7.89779
	scattering	1.39373 2.7688 1.39373
	g			0
}

standard_object
{
	name				dragon
	geometry			dragongeom
	position			-4 -1.5 3
	orientation			0 30 0
	scale				30 30 30
	material			sss_simple_sss_jade
	shader				dragon_shader
}

# Bunny - wax with diffusion approximation SSS
# Bunny model is ~0.2 units tall natively, scale up to ~6 units
risemesh_geometry
{
	name				bunnygeom
	file				models/risemesh/bunny.risemesh
}

# Converted from diffusion_approximation_sss_shaderop `sss_wax` (point-cloud SSS, frozen) by tools/migrate_scenes_legacy_rasterizer.py --mode full:
#   the op's own sigma_s / sigma_a (per mm) x 1000 x geometric_scale 0.05, ior 1.3, g 0.8.
subsurfacescattering_material
{
	name			sss_wax_sss_wax
	ior			1.3
	absorption	1.6 8.5 24
	scattering	37 44 50.5
	g			0.8
}

standard_object
{
	name				bunny
	geometry			bunnygeom
	position			4 -1.2 2
	orientation			0 20 0
	scale				30 30 30
	material			sss_wax_sss_wax
	shader				bunny_shader
}

# Central sphere on a pedestal (wax SSS material)
sphere_geometry
{
	name				spheregeom
	radius				1.5
}

cylinder_geometry
{
	name				pedestalgeom
	axis				y
	radius				0.8
	height				1.5
}

standard_object
{
	name				pedestal
	geometry			pedestalgeom
	position			0 0.75 -2
	material			pedestal_mat
}

standard_object
{
	name				center_sphere
	geometry			spheregeom
	position			0 3.2 -2
	material			sss_wax_sss_wax
	shader				bunny_shader
}

##################################################
# Lights - Colored spot lights for dramatic effect
##################################################

# Red spot from upper left - illuminates the dragon
spot_light
{
	name				spot_red
	position			-7 10 6
	target				-4 3 1
	color				1.0 0.2 0.15
	colorspace			sRGB
	# Phase 2 slice B1 retune (owner-approved): power 20000.0 -> 5808; with the jade dragon re-authored, x0.2904 on the three spots (x0.29 on the backlight) restores the legacy whole-image mean (the legacy SSS ops' irrad_scale fudge had set its brightness)
	power				5808
	inner				30
	outer				80
}

# Blue spot from upper right - illuminates the bunny
spot_light
{
	name				spot_blue
	position			7 10 6
	target				4 3 2
	color				0.2 0.3 1.0
	colorspace			sRGB
	# Phase 2 slice B1 retune (owner-approved): power 30000.0 -> 8712; with the jade dragon re-authored, x0.2904 on the three spots (x0.29 on the backlight) restores the legacy whole-image mean (the legacy SSS ops' irrad_scale fudge had set its brightness)
	power				8712
	inner				30
	outer				80
}

# Warm amber spot from directly above center
spot_light
{
	name				spot_amber
	position			0 12 4
	target				0 2 -2
	color				1.0 0.8 0.4
	colorspace			sRGB
	# Phase 2 slice B1 retune (owner-approved): power 15000.0 -> 4356; with the jade dragon re-authored, x0.2904 on the three spots (x0.29 on the backlight) restores the legacy whole-image mean (the legacy SSS ops' irrad_scale fudge had set its brightness)
	power				4356
	inner				30
	outer				80
}

# Subtle cool rim light from behind
directional_light
{
	name				backlight
	# Phase 2 slice B1 retune (owner-approved): power 30.0 -> 8.7; with the jade dragon re-authored, x0.29 on the backlight (x0.2904 on the three spots) restores the legacy whole-image mean (the legacy SSS ops' irrad_scale fudge had set its brightness)
	power				8.7
	color				0.6 0.65 0.8
	colorspace			sRGB
	direction			0 -0.3 1
}


