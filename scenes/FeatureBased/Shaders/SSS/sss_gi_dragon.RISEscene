RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           sss_gi_dragon.RISEscene                                                                     #
#   Description:    Combines a subsurface scattering object into a scene with global illumination           #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      February 23, 2006                                                                       #
#                                                                                                           #
#############################################################################################################

> echo warning Warning! This scene is quite CPU intensive and may take considerable time to render, particularily on slower machines.

##################################################
# Setup a renderer
##################################################

standard_shader
{
	name				global
	shaderop		DefaultPathTracing
}

standard_shader
{
	name				sss
	shaderop		DefaultPathTracing
}

# Migrated from pixelpel_rasterizer by tools/migrate_scenes_legacy_rasterizer.py (--mode full --integrator pt, legacy-deprecation Phase 2).
pathtracing_pel_rasterizer
{
	samples				64
	pixel_filter		tent
	pixel_filter_width	1.7
	pixel_filter_height	1.7
}

file_rasterizeroutput
{
	pattern				rendered/sss_gi_dragon
	type				PNG
#	bpp				16
#	color_space			ProPhotoRGB
}

##################################################
# Cameras
##################################################

film
{
	width			960
	height			720
}

pinhole_camera
{
	location			0.2 0 19.5
	lookat				0.2 0 0
	up					0 1 0
	fov					30.0
}

##################################################
# Painters
##################################################

#############################################################################################################
#									RISE Ascii Scene File													#
#																											#
#	File: 			colors.scn																				#
#   Description:	Contains commonly used colors from all scenes											#
#	Author: 		Aravind Krishnaswamy																	#
#	Birthdate:		November 14, 2003																		#
#																											#
#############################################################################################################
#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           standard_colors.RISEscene                                                               #
#   Description:    Contains some standard colors                                                           #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################


uniformcolor_painter
{
	name		color_white
	color		1.0 1.0 1.0
}













#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           povray_colors.RISEscene                                                                 #
#   Description:    Contains colors taken from POV-Ray                                                      #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################






















	
	

	




































































##################################################
# Materials
##################################################

lambertian_material
{
	name				white
	reflectance			color_white
}

lambertian_luminaire_material
{
	name				lum
	exitance			color_white
	# DL-320 (2026-09-28): 10 -> 8.2.  The panel is double-sided and sits close to the left wall; since DL-320 its back face lights that wall (it used to leave a dark patch there), and the bounce brightened the dragon by ~23 %.  8.2 returns the dragon to within ~3.5 % (about one sd of the measurement) of its pre-DL-320 level, erring bright rather than dark.
	# Phase 2 slice B1 retune (owner-approved): scale 8.2 -> 3.8; the legacy final gather truncated the bounces in this albedo-1.0 box, and full path tracing read 2.2x brighter
	scale				3.8
	material			none
}

##################################################
# Objects
##################################################

risemesh_geometry
{
	name			meshgeom
	file			models/risemesh/dragon_small.risemesh
}

# Converted from simple_sss_shaderop `sss` (point-cloud SSS, frozen) by tools/migrate_scenes_legacy_rasterizer.py --mode full:
#   Christensen-Burley match: albedo 0.0493827 0.95 0.444444 (colour material `white`, x the op's 1/extinction^2 channel weights, clamped to [0.01, 0.95]), profile tail falloff = extinction x 1000 x geometric_scale 0.2 = 18 4 6 per unit.
subsurfacescattering_material
{
	name			sss_sss_white
	ior			1.3
	absorption	13.4289 0.583232 5.26864
	scattering	0.697604 11.0814 4.21491
	g			0
}

standard_object
{
	name				mesh
	geometry			meshgeom
	orientation			0 30 0
	position			1 -5.6 0
	scale				40 40 40
	material			sss_sss_white
	shader				sss
}

clippedplane_geometry
{
	name				wallgeom
	pta					-14.1 -14.1 0
	ptb					14.1 -14.1 0
	ptc					14.1 14.1 0
	ptd					-14.1 14.1 0
}

standard_object
{
	name				rwall
	geometry			wallgeom
	position			5.5 0 0
	orientation			0 -90 0
	material			white
}


standard_object
{
	name				bwall
	geometry			wallgeom
	position			0 0 -10.5
	orientation			0 0 0
	material			white
}

standard_object
{
	name				twall
	geometry			wallgeom
	position			0 3.5 0
	orientation			90 0 0
	material			white
}

standard_object
{
	name				botwall
	geometry			wallgeom
	position			0 -3.5 0
	orientation			-90 0 0
	material			white
}

standard_object
{
	name				backwall
	geometry			wallgeom
	position			-6 0 0
	orientation			0 90 0
	material			white
}

clippedplane_geometry
{
	name				lightgeom
	pta					-2.1 -2.1 0
	ptb					2.1 -2.1 0
	ptc					2.1 2.1 0
	ptd					-2.1 2.1 0
}

standard_object
{
	name				light
	geometry			lightgeom
	material			lum
	position			-5.5 0 0
	orientation			0 90 0
}



