##################################################
# NIGHT / LUME SHOT (alternate mode -- self-contained, NO manual chunk edits).
# The photoluminescent lume carries the frame: the chapter-ring arcs, the
# hands, and the centre pin glow blue-green while everything else falls to
# near black.  `lume_glow_night` is defined but UNUSED in day mode (an unbound
# material has no render effect); the `>` command block below applies the mode
# at scene-load time via the generalized `> modify` command.
#
# TO ACTIVATE: delete the '/*' and '*/' lines around the command block (and
# re-add them to return to day).  Tuning: lume_glow_night 'scale' = glow
# brightness, pnt_lume_glow = glow colour; the lume is then the ONLY light, so
# raise the rasterizer 'samples' (e.g. 32 -> 256) for a clean night hero.
##################################################
uniformcolor_painter
{
	name				pnt_lume_glow
	color				0.45 0.95 0.70
}

lambertian_luminaire_material
{
	name				lume_glow_night
	exitance			pnt_lume_glow
	scale				45.0
	material			none
}

/*
> modify rasterizer radiance_scale 0.02
> modify material soft_top_lum scale 0
> modify material soft_bot_lum scale 0
> modify object sdfhour material lume_glow_night
> modify object sdfminute material lume_glow_night
> modify object pin material lume_glow_night
*/
