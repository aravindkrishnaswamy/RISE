RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           weathered_workbench.RISEscene                                                          #
#   Description:    Textures showcase 1/4 (doc 88 Phase 1+2 arc) -- a wooden workbench with a bolted-on   #
#                   cast-iron bench vise and a de-tiled diamond-plate tool tray.  The wood top's colour     #
#                   AND roughness are driven from the SAME expression_painter grain field (ramp_painter     #
#                   for colour, scalar_painter{painter} bridge for roughness -- gloss follows grain), and   #
#                   relief_modifier relief_wood (scale 0.25, max_slope 0.30) binds the same field raw to    #
#                   the top and all four legs, so the grain reads as carved surface, not paint.             #
#                   scatter_painter scatters oil stains that blend_painter{mode multiply} darkens onto      #
#                   the wood.  The tool tray is a checker_painter hex-tiled via stochastic_tile_painter to  #
#                   break its grid repeat -- no tileable photo/scan asset exists in-repo, so this demo      #
#                   substitutes a procedural checker source to exercise the de-tiling MECHANISM; the        #
#                   intended use of stochastic_tile_painter is a small tiling photo/scan, per the skill.    #
#                                                                                                           #
#   THE VISE.  Until 2026-09-06 the "iron vise" here was two box_geometry under an isotropic worley3d       #
#   field reprojected by mapping_painter{projection world} -- and the standing criticism of it was exactly   #
#   right: it said nothing about what it was, and it looked like a generated texture rather than an         #
#   object.  It is now built against the seven-rule doctrine in the header of                                #
#   plank_closeup.RISEscene, whose rule 7 (silhouette first) named this vise as its counter-example.        #
#   The worley chunks and the mapping_painter are gone, not re-skinned.                                     #
#                                                                                                           #
#   1. THE FOOTPRINT WAS MEASURED FIRST, AND EVERY SIZE FOLLOWS FROM IT.  Painting clamp(fw*50,0,1) on      #
#      the vise as a lambertian and dividing by a flat-albedo control gives fw p50 = 7.95 mm over the       #
#      object (the geometric pixel spacing at its 3.38 m axial depth is 5.4 mm, so fw runs about 1.5 px     #
#      here).  That single number decides the whole surface: a feature needs ~3 px to carry shape, so the   #
#      casting undulation is 33 mm (6 px) and the paint chips 20-40 mm, and a real casting's 1-3 mm         #
#      pitting -- a fifth of a pixel -- is BANNED from colour and relief and sent to roughness alone.       #
#      This is why the vise carries no pits at all where the nail in plank_closeup carries plenty: the      #
#      two scenes are 20x apart in footprint, and the sizes are not transferable.                           #
#                                                                                                           #
#   2. THE SILHOUETTE SAYS "BENCH VISE" BEFORE ANY TEXTURE.  Fifteen sdf_geometry parts: a bolted base      #
#      flange with four proud bolt heads, a cast body carrying the fixed rear jaw with a flat anvil pad     #
#      behind it, a machined slide bar, a movable front jaw on it, two hardened jaw pads standing proud     #
#      of both castings, a lead screw, a thrust collar and a T-handle hanging off-centre in its hole.       #
#      The castings are smin-joined (k 0.014-0.030) so they carry the fillets a drawn casting has; the      #
#      bar, the pads and the bolt heads are HARD unions, because a machined part meets a casting at an      #
#      edge.  The object is yawed 48 degrees -- a swivel base is what a vise has one FOR -- which is the    #
#      only orientation that shows the jaw gap, the jaw faces and the full length of the handle at once.    #
#                                                                                                           #
#   3. ONE FIELD, FOUR CONSUMERS.  expr_vise runs a WEATHERING axis (machined steel -> paint -> the cast    #
#      iron a chip exposes -> rust); ramp_vise colours it, sp_vise_rough bridges it to GGX roughness,       #
#      sp_vise_relief bridges it raw into relief_vise, and sp_vise_ior / sp_vise_extinction bridge it into  #
#      the FRESNEL, so the same field that says "this is paint" also stops that point being a conductor.    #
#      Variation is tied to the geometry throughout: occlusion() puts grime and rust in the fillets and     #
#      under the flange lip, -N.y rusts the undersides, curv chips the paint off the drawn arrises, and a   #
#      Po-space part mask -- not a noise -- decides which faces are machined.                               #
#                                                                                                           #
#   ------------------------------------------------------------------------------------------------      #
#   WHAT WAS TRIED AND WAS WRONG                                                                            #
#   ------------------------------------------------------------------------------------------------      #
#                                                                                                           #
#   -- THE FIRST VISE WAS BUILT AT TRUE SCALE AND WAS ILLEGIBLE.  A 200 mm-tall vise is 37 px here and      #
#      read as a grey lump.  The shipped one is 300 mm above the bench -- deliberately a big shop vise,     #
#      and deliberately the same envelope the two boxes it replaced occupied, so the composition, the       #
#      bench top's relief tuning and the camera did not have to move.                                       #
#                                                                                                           #
#   -- THE HANDLE POINTED AT THE CAMERA.  With the screw axis along +Z the T-handle is 28 degrees off       #
#      the view axis and foreshortens to 47% -- a stub.  Solving for a bar PERPENDICULAR to the view        #
#      (0.898*sin(t) + 0.19*cos(t) = 0 at the 48-degree yaw) gives a near-vertical hang, which then runs    #
#      the bar's lower end into the bench top; -35 degrees is the compromise that keeps 93% of the length   #
#      on screen with the end still 49 mm clear.  Foreshortening is a composition variable, not a detail.   #
#                                                                                                           #
#   -- EVERY fbm HAD OCTAVES BELOW THE PIXEL FOOTPRINT, AND THEY READ AS DIRT.  fbm(P*30, 3, ...) puts      #
#      its third octave at 8 mm, and fbm(P*32, 4, ...) its last two at 7 and 3 mm -- all under two          #
#      pixels.  The field probe looked correctly mottled at a distance and turned to fine speckle up        #
#      close, which is precisely the "generated" tell.  OCTAVE COUNT IS A FEATURE-SIZE DECISION, not a      #
#      quality dial: both fields are 2 octaves now, and the sub-pixel structure that was cut from them      #
#      lives in sp_vise_grain, which reaches roughness ONLY.                                                #
#                                                                                                           #
#   -- THE RAMP GAVE PAINT AND BARE IRON THE SAME LUMINANCE.  Being careful about the doctrine's            #
#      over-contrast warning, the first ramp put intact paint at 0.090 and the iron a chip exposes at       #
#      0.070 -- a 1.3:1 step that is invisible under any lighting.  The field was healthy the whole time    #
#      (a probe showed a 0.062 within-band standard deviation); the RAMP was eating it.  Over-contrast is   #
#      a tell, but so is a ramp that refuses to spend the range the field actually occupies -- the shipped  #
#      step is 2.3:1, which is the same band the plank's early-to-late wood uses.                           #
#                                                                                                           #
#   -- THE PART MASK FADED OUT ACROSS THE OUTER HALF OF EACH JAW PAD.  padband's z transition was set at    #
#      the pad's own boundary rather than just outside it, so the pad's outer half sat at mask ~0.5, took   #
#      half the CAST branch, and grew a rust fringe along the top of every pad.  A part mask has to         #
#      OVERSHOOT the part; the transition then lands on the neighbouring casting, where it is hidden by     #
#      the crease that is already there.  Every mask edge in expr_vise is placed on a real geometric edge   #
#      for that reason, and it matters twice over because relief_vise reads the same field, so a mask       #
#      transition is also a height step.                                                                    #
#                                                                                                           #
#   -- CHIPS KEYED MOSTLY ON `curv` DREW AN OUTLINE.  At 0.55*arris the paint failed in a neat band         #
#      around every jaw and flange edge, which reads as a rendered outline effect rather than as wear.      #
#      The arris still has to be the FIRST place paint goes, but at 0.18 against a 1.4x chip field and a    #
#      0.35 gravity-run term, so the chips are patches that happen to reach the edges.                      #
#                                                                                                           #
#   -- RUST WITH NO DIRECTION.  Rust is the one process here that gravity writes, so `runs` is an 8:1       #
#      vertical fbm (11 mm across, 88 mm down) that both elongates the chips downward and concentrates      #
#      the rust in the lower part of each. The casting undulation is left ISOTROPIC on purpose -- a sand    #
#      mould has no grain direction -- which is the one place this scene departs from the doctrine's        #
#      "every noise term gets a direction", and it departs because the physics says so.                     #
#                                                                                                           #
#   -- A RUST STAIN RUNNING OVER INTACT PAINT IS NOT REACHABLE FROM A SINGLE 1-D RAMP, and was dropped      #
#      rather than faked: a point cannot be both "paint" and "rust" on one axis.  Rust here only grows      #
#      where the paint is already gone, which is what the physics says anyway.  Grime under the flange      #
#      ON THE BENCH is out of reach for the opposite reason -- occlusion() is self-occlusion only -- and    #
#      is deliberately NOT painted on as a decal.                                                           #
#                                                                                                           #
#   Author:         RISE contributors                                                                       #
#   Birthdate:      2026-08-20                                                                              #
#                                                                                                           #
#############################################################################################################

##################################################
# Setup a renderer
##################################################

# Declared before the rasterizer chunk below (which references it as
# `radiance_map`) -- ordinary declare-before-use.  Refinement pass: the
# first render left an unlit white void above the bench; a soft workshop-
# window sky reads far better and costs nothing extra to render.
uniformcolor_painter
{
	name			pnt_sky
	color			0.58 0.60 0.64
}

standard_shader
{
	name			global
	shaderop		DefaultDirectLighting
}

pixelpel_rasterizer
{
	max_recursion			4
	samples					12
	lum_samples				1
	radiance_map			pnt_sky
	radiance_background		TRUE
}

file_rasterizeroutput
{
	pattern			rendered/weathered_workbench
	type			PNG
	bpp				8
	color_space		sRGB
}

##################################################
# Cameras
##################################################

film
{
	width			640
	height			480
}

pinhole_camera
{
	location		0 1.6 3.4
	lookat			0 0.75 0
	up				0 1 0
	fov				42.0
}

##################################################
# Painters -- wood top: one grain field, two consumers
##################################################

# The FIELD.  Anisotropic domain-warped fbm: high frequency across the
# plank (X, via `grain_across`) and low along it (Y/Z), nested inside a
# domain warp so the rings wander instead of reading as plain noise.
# Every art-directable number is a `param` with a range (the doc-88
# human-editability contract).
expression_painter
{
	name			expr_grain
	param			grain_along 3.0 min 0.5 max 12 step 0.25 label "Grain frequency (along plank)"
	param			grain_across 14.0 min 2 max 40 step 1 label "Grain frequency (across plank)"
	param			ring_warp 0.35 min 0.0 max 1.5 step 0.05 label "Ring warp strength"
	param			contrast 2.2 min 1.0 max 5.0 step 0.1 label "Grain contrast"
	seed			4.0
	def				warp_p vec3(P.x*grain_across + seed, P.y*grain_along + seed*1.7, P.z*grain_along + seed*2.3) + ring_warp*vec3(fbm(P*grain_along+vec3(0,0,0),3,0.5,2.0), fbm(P*grain_along+vec3(5.2,1.3,7.7),3,0.5,2.0), fbm(P*grain_along+vec3(9.1,2.6,4.4),3,0.5,2.0))
	def				grain fbm(warp_p, 5, 0.55, 2.1)
	expr			clamp(grain*contrast+0.5, 0, 1)
}

# CONSUMER 1 -- colour: dark heartwood -> pale sapwood.
ramp_painter
{
	name			ramp_wood
	input			expr_grain
	channel			R
	interpolation	smooth
	stop			0.00  0.10 0.055 0.02
	stop			0.35  0.32 0.17  0.07
	stop			0.70  0.55 0.33  0.15
	stop			1.00  0.78 0.55  0.30
	color_space		Rec709RGB_Linear
}

# CONSUMER 2 -- the PHYSICAL SCALAR, off the SAME field: roughness sweeps
# 0.05 (dark grain/polished) .. 0.47 (pale sapwood/weathered) -- gloss follows grain.
scalar_painter
{
	name			sp_wood_rough
	painter			expr_grain
	channel			R
	scale			0.42
	bias			0.05
}

# CONSUMER 3 -- RELIEF (docs/RELIEF_MODIFIER_DESIGN.md Phase 5): the SAME
# field, bridged raw (no scale/bias -- relief_modifier's own `scale` below is
# the independent height-amplitude multiplier, exactly the pattern
# skills/agent/materials-and-media-basics.md's crackle-glaze recipe uses).
# ramp_wood maps field=0 -> dark heartwood, field=1 -> pale sapwood, so this
# raw field is monotonically increasing with "paleness".  Dark grain/late-
# wood should read as SUNK relative to the pale wood between the streaks --
# relief_modifier's convention is POSITIVE height rises along +N, and the
# raw field is 0 at the dark end and 1 at the pale end, so binding it with
# a POSITIVE scale leaves the dark end at the local floor and raises the
# pale end above it: dark reads sunk, which is the sign this scene wants
# (a look choice for a weathered bench, not a claim about real wood, where
# dense late-wood usually stands proud) -- the OPPOSITE of
# the crackle-glaze recipe's negative scale, because that recipe's dark end
# is the HIGH end of its own field (see that recipe's own comment).
#
# AMPLITUDE + CLAMP (retuned 2026-09-06; docs/RELIEF_MODIFIER_DESIGN.md §12
# Phase 5 addendum has the full sweep table and the PNG paths).  This grain is
# a 5-octave fbm whose tangent-plane slope is O(10), and an UNCLAMPED relief
# on it has NO usable amplitude at all -- the two failure modes OVERLAP rather
# than leaving a band to thread.  The original Phase 5 sweep read 0.05 as
# "artifact-free" and the review then dialled it to 0.03, but the footprint
# arc (2026-09-06) makes that reading an ALIASING ARTEFACT: the sweep predates
# footprint-driven step selection on analytic primitives, so what it measured
# was a sub-footprint stencil.  Re-swept against the real step rule, 0.03 is
# INVISIBLE (the field's detail sits below the pixel footprint) and 0.10-0.25
# unclamped renders as BLACK bands and speckle -- the shading normal leans
# past the geometric horizon as seen from the ray, and the material's
# geometric-horizon gate then rejects nearly every sampled direction.  On the
# bench-top crop, 0.25 unclamped puts 976 of 10000 pixels below luma 12,
# against 0 at 0.03.
#
# `max_slope` (added with this retune) bounds the TILT instead of the
# amplitude: it rescales the gradient to that slope with its DIRECTION
# PRESERVED, so `scale` can be raised for legibility while the clamp holds the
# peaks.  0.25 / 0.30 is the knee of the measured frontier -- fine-detail
# contrast +19% over the old 0.03 (hf-RMS 18.5 -> 22.1) at 23 of 10000
# near-black pixels, all in the extreme-grazing far band and all following the
# grain.  0.35 buys +8% more for 2.7x the blacks, 0.40 for 3.8x, and there the
# darks start clumping into solid patches.  `scale` approaches a CEILING once
# the clamp binds -- full saturation needs EVERY gradient in this fbm field
# past the bound, so scale 0.15/0.25/0.40 still move a little (hf-RMS
# 21.51/22.06/22.14, a monotone 2.9% spread, not identical) -- so there is
# little above 0.25 to gain here.  Note 0.30 is BELOW the 0.5-1.0 band the skill doc
# recommends generally: this bench top is a large horizontal plane seen at a
# grazing angle over most of its area, which puts the horizon far closer than
# on a surface viewed nearer face-on.
#
# THE KEY LIGHT WAS LEFT ALONE, having been tested.  Lowering it from 42 to 24
# degrees elevation (direction 0.5 0.35 0.6, same power) does NOT help the
# grain read: fine-detail contrast goes slightly DOWN (24.8 -> 24.3 at
# 0.25/0.4), the plank dims ~7%, and near-black pixels rise 35%.  The reason
# is the same grazing-budget geometry as the max_slope clamp itself, applied
# to the LIGHT instead of the camera: max_slope 0.4 caps the tilt at
# atan(0.4) ~= 21.8 degrees, so an away-facing tilt can point the shading
# normal up to 21.8 degrees past the light's own direction before N'.L goes
# non-positive.  At the 42-degree key that margin is still 42-21.8=20.2
# degrees; at the 24-degree key it is only 24-21.8=2.2 degrees, so far more
# of the fbm field's actual tilt distribution crosses that horizon and gets
# gated BLACK -- a second, light-side instance of the same geometric-horizon
# mechanism max_slope exists to manage on the ray side.  (An earlier draft of
# this comment said a raking key "saturates" the toward-light tilts at
# N.L ~ 1; it does not -- the closest approach at 21.8 degrees of tilt
# budget and a 24-degree key is sin(46) ~= 0.72, nowhere near saturation.
# The measurement and the decision are unchanged: it is a horizon-gating
# loss, not a saturation ceiling.)  The 42-degree key is already the better
# choice.
#
# `domain surface` -- the bench top and
# legs are `box_geometry`, an analytic primitive with no UVs, which is
# exactly why `surface` and not `uv`.
#
# This comment used to add "and one that never populates `txFootprint`, so
# there is no distance fade here".  That stopped being true on
# 2026-09-06: docs/TEXTURE_FOOTPRINT_ANALYTIC_DESIGN.md moved footprint
# production to the `Object::IntersectRay` layer, so EVERY geometry
# publishes a world footprint on a primary hit, boxes included, and §3.3's
# mesh-only caveat is gone.  The bench top therefore DOES fade with
# distance now, and the auto step here is the footprint rather than the
# 1e-3 floor.  See §12 "Fix round 2" for the measurement that then halved
# the footprint fraction, which is what keeps the grain from reading soft
# at this camera distance.
scalar_painter
{
	name			sp_wood_relief
	painter			expr_grain
	channel			R
}

relief_modifier
{
	name			relief_wood
	height			sp_wood_relief
	domain			surface
	scale			0.25
	step			0
	max_slope		0.30
}

##################################################
# Painters -- oil stains: scatter_painter + blend_painter{mode multiply}
##################################################

uniformcolor_painter
{
	name			pnt_white_full
	color			1.0 1.0 1.0
	colorspace		Rec709RGB_Linear
}

uniformcolor_painter
{
	name			pnt_stain_dark
	color			0.12 0.08 0.05
	colorspace		Rec709RGB_Linear
}

# Scattered oil-stain stamps: dark blobs over a WHITE background, so this
# painter alone is a multiply-darkening MASK (white = no stain, dark = stain).
scatter_painter
{
	name				scatter_stains
	source				pnt_stain_dark
	background			pnt_white_full
	cell_scale			9.0
	stamp_scale			0.45
	jitter_position		0.8
	jitter_rotation		180.0
	jitter_scale		0.3
	probability			0.28
	seed				7
}

# mode multiply: blend(a,b) = a*b, then mask (full white -> selects the
# multiplied combination everywhere) interpolates toward colorb -- net
# effect: scatter_stains darkens ramp_wood wherever a stain stamp landed.
blend_painter
{
	name			blend_wood_stained
	colora			scatter_stains
	colorb			ramp_wood
	mask			pnt_white_full
	mode			multiply
}

uniformcolor_painter
{
	name			pnt_wood_spec
	color			0.4 0.35 0.28
}

##################################################
# Painters -- the vise: ONE cast-iron field, four consumers
##################################################

# THE FIELD.  Sizes come from the MEASURED footprint over the vise
# (`fw` p50 = 7.95 mm; see the geometry comment below), so the ordering
# is: casting undulation at 6 px, chips at 4-7 px, and NOTHING finer in
# colour or relief -- a real casting's 1-3 mm pitting is a fifth of a
# pixel here and can only read as dirt, so it goes to roughness alone
# (`sp_vise_grain`).
#
# The axis the field runs along is a WEATHERING axis, not a brightness
# one: 0 = bare machined steel, ~0.30 = intact paint, ~0.62 = the cast
# iron a chip exposes, 1.0 = rust bloom.  Everything that moves a point
# along it is either a sized surface process or a question the geometry
# answers about itself.
expression_painter
{
	name			expr_vise
	param			cast_freq 30.0 min 6 max 90 step 1 label "Casting undulation frequency"
	param			patch_freq 15.0 min 4 max 50 step 1 label "Casting-scale patch frequency"
	param			chip_freq 32.0 min 8 max 90 step 1 label "Paint-chip field frequency"
	param			chip_cov 0.16 min -0.3 max 0.6 step 0.02 label "Paint-chip threshold (lower = more bare iron)"
	param			paint_w 0.42 min 0.0 max 0.8 step 0.02 label "Field value of intact paint"
	param			iron_w 0.66 min 0.3 max 0.9 step 0.02 label "Field value of bare cast iron"
	param			steel_w 0.06 min 0.0 max 0.3 step 0.01 label "Field value of machined steel"
	param			rust_crev 0.55 min 0.0 max 1.5 step 0.05 label "Rust in crevices"
	param			grime_crev 0.16 min 0.0 max 0.6 step 0.02 label "Grime darkening the paint in crevices"
	param			rust_down 0.40 min 0.0 max 1.5 step 0.05 label "Rust on the underside"
	seed			19.0

	# -- geometry signals (doctrine 3).  Every threshold here was MEASURED
	# on this object, not guessed: a probe render of each signal, divided
	# by a flat-albedo control, gave curv p25/p50/p75/p90 = 0 / 10.4 /
	# 27.7 / 32.9 and occlusion(0.09) p2/p10/p25/p50 = 0.43 / 0.70 / 0.87
	# / 0.97.  `curv` is normalised by the object's bbox diagonal (0.76 m
	# here), so a flat cast face reads 0, the screw and handle barrels
	# read ~17, and only the drawn arrises of the castings reach 30+ --
	# which is why `arris` starts at 18 and not anywhere near 1.
	def				occ occlusion(0.09)
	def				crev smoothstep(0.84, 0.50, occ)
	def				down clamp(-N.y, 0, 1)
	def				arris smoothstep(18.0, 34.0, curv)

	# -- the machined-part mask, in OBJECT space (`Po`), because "is this
	# face machined or as-cast" is a fact about the PART, not about a
	# noise field, and a vise's whole visual argument is the contrast
	# between the two.  Three bands: the two jaw pads and the slot
	# between them; the slide bar where it shows between the castings;
	# and everything forward of the movable jaw (screw, collar, handle).
	#
	# Every transition below is placed ON a real geometric edge -- the
	# pad's own boundary at |Po.z - 0.0295| = 0.0445, its lower face at
	# Po.y = 0.171, the bar's flank at |Po.x| = 0.054, the jaw casting's
	# front at Po.z = 0.173.  That is not decoration: `relief_vise` reads
	# the same field, so a mask edge is a height step, and a height step
	# is only invisible when it lands where the silhouette already has a
	# crease.
	def				padband smoothstep(0.055, 0.047, abs(Po.z - 0.0295)) * smoothstep(0.163, 0.170, Po.y) * smoothstep(0.124, 0.117, abs(Po.x))
	def				barband smoothstep(0.060, 0.050, abs(Po.x)) * smoothstep(0.106, 0.114, Po.y) * smoothstep(0.194, 0.186, Po.y) * smoothstep(0.170, 0.158, Po.z)
	def				frontband smoothstep(0.174, 0.182, Po.z)
	def				mach clamp(padband + barband + frontband, 0, 1)

	# -- surface processes, sized to the footprint.
	# 33 mm sand-casting undulation: 6 px, so it carries SHAPE and is the
	# only term `relief_vise` really renders.
	def				und fbm(P*cast_freq + vec3(seed, seed*1.7, seed*2.3), 2, 0.5, 2.0)
	# 67 mm casting-scale drift: 12 px, coarser than the undulation, so it
	# moves neighbouring ripples together instead of scrambling them.
	def				patch smoothstep(-0.12, 0.24, fbm(P*patch_freq + vec3(3.0, 8.0, 1.0), 3, 0.5, 2.0))

	# -- the paint layer.  Paint does not chip at random: it comes off the
	# ARRISES first, off the casting's high spots next, and it survives in
	# the broad flat panels.  So the chip field is `arris` and `und` added
	# to a 31 mm noise and thresholded HARD (0.05 wide) -- a chip edge is
	# crisp, and a soft one reads as a stain.
	def				chipf fbm(P*chip_freq + vec3(11.0, 2.0, 5.0), 2, 0.55, 2.1)
	def				runs fbm(vec3(P.x*88.0, P.y*11.0, P.z*88.0) + vec3(6.0, 1.0, 3.0), 2, 0.5, 2.0)
	def				bare smoothstep(chip_cov, chip_cov + 0.05, 1.4*chipf + 0.18*arris + 0.30*und + 0.35*runs)

	# -- rust.  Concentrated where water sits and cannot dry: the crevices
	# `occlusion()` finds (jaw-to-body fillet, under the flange lip,
	# around the bolt heads) and the downward faces `-N.y` finds.  It only
	# exists where the paint is already gone, which is what `* bare` says.
	def				rust clamp(0.15 + rust_crev*crev + rust_down*down + 0.45*patch + 0.55*runs, 0, 1)

	# -- the two surfaces, mixed by the part mask.  `iron_w` and the rust
	# reach are held so the CAST branch tops out just under 1.0 before the
	# undulation is added: a ramp cannot reserve a range the field is free
	# to write into.
	def				grime grime_crev*crev*(1.0 - bare)
	def				cast paint_w - grime + (iron_w - paint_w)*bare + (0.94 - iron_w)*bare*rust + 0.26*und
	def				steel steel_w + 0.09*rust + 0.05*und
	expr			clamp(mix(cast, steel, mach), 0, 1)
}

# CONSUMER 1 -- colour.  Machined steel -> dulled steel -> a flat plateau
# of intact paint -> the cast iron a chip exposes -> rust.  The paint
# occupies 0.26..0.55 as a near-constant colour on purpose (doctrine: a
# smooth gradient across a plateau reads as a row of rods), and the
# paint-to-iron step at 0.55 -> 0.62 is deliberately tight because a
# chip boundary is an edge, not a fade.
ramp_painter
{
	name			ramp_vise
	input			expr_vise
	channel			R
	interpolation	smooth
	stop			0.00  0.185 0.195 0.210
	stop			0.11  0.118 0.124 0.134
	stop			0.20  0.032 0.039 0.050
	stop			0.32  0.046 0.058 0.081
	stop			0.46  0.078 0.099 0.136
	stop			0.60  0.112 0.140 0.186
	stop			0.66  0.042 0.040 0.036
	stop			0.76  0.082 0.070 0.056
	stop			0.87  0.250 0.118 0.050
	stop			1.00  0.365 0.185 0.088
	color_space		Rec709RGB_Linear
}

# CONSUMER 2 -- roughness, linear off the same field: machined steel 0.10,
# paint 0.26, bare iron 0.47, rust 0.72.
scalar_painter
{
	name			sp_vise_rough_base
	painter			expr_vise
	channel			R
	scale			0.66
	bias			0.06
}

# ... plus the ONE term that is deliberately NOT in the field: sand-casting
# grain at 4.5 mm.  That is 0.8 of a pixel here, so by doctrine 1 it can
# carry neither colour nor shape -- but a microfacet distribution is
# exactly where sub-pixel structure belongs, and breaking the specular up
# per-pixel is most of what stops a GGX surface reading as moulded plastic.
scalar_painter
{
	name			sp_vise_grain
	param			grain_freq 220.0 min 60 max 600 step 10 label "Sand-cast grain frequency"
	def				g fbm(P*grain_freq + vec3(4.0, 7.0, 1.0), 2, 0.5, 2.0)
	expression		0.075*g
}

scalar_painter
{
	name			sp_vise_rough
	add				sp_vise_rough_base sp_vise_grain
	weight_a		1.0
	weight_b		1.0
}

# CONSUMER 3 -- relief.  NEGATIVE scale: the field's high end is rust and
# the hollows it eats, and a hollow sinks.  `scale` is set from the
# undulation's own geometry rather than swept blind -- a 33 mm ripple with
# about 0.8 mm of amplitude wants a slope near 0.16, and the undulation
# term moves the field by about +-0.045, so 0.16/(0.045/0.033) = 0.05.
# `max_slope` then bounds what the chip edges do with the same scale (the
# field steps ~0.3 across ~10 mm there, which is a slope of 30 before the
# clamp); 0.30 is the same knee the bench top's own sweep found, and for
# the same reason -- most of this scene is seen at a grazing angle, which
# brings the geometric horizon in close.  `step 0` resolves to fw/2 ~ 4 mm,
# an eighth of the undulation's wavelength, so the ripple is differenced
# well inside its own feature.
scalar_painter
{
	name			sp_vise_relief
	painter			expr_vise
	channel			R
}

relief_modifier
{
	name			relief_vise
	height			sp_vise_relief
	domain			surface
	scale			-0.16
	step			0
	max_slope		0.45
}

# CONSUMER 4 -- the FRESNEL.  The same field decides whether a point is
# metal or not, which no amount of colour can fake: bare machined steel is
# a conductor (ior 2.9, k 3.3, F0 ~ 0.7), while paint and rust are
# dielectrics (ior ~1.6, k ~0, F0 ~ 0.05).  Both slots are physical
# scalars, so both are `scalar_painter` bridges and neither goes anywhere
# near a colourspace conversion.  A chip is left on the dielectric side on
# purpose: exposed iron on a bench vise is oxide within days, not mirror.
scalar_painter
{
	name			sp_vise_ior
	painter			expr_vise
	channel			R
	scale			-1.30
	bias			2.90
}

scalar_painter
{
	name			sp_vise_extinction
	painter			expr_vise
	channel			R
	scale			-3.30
	bias			3.45
}

uniformcolor_painter
{
	name			pnt_vise_spec
	color			0.56 0.57 0.60
	colorspace		Rec709RGB_Linear
}

##################################################
# Painters -- tool tray: stochastic_tile_painter de-tiling a checker source
##################################################

uniformcolor_painter
{
	name			pnt_plate_dark
	color			0.08 0.08 0.09
}

uniformcolor_painter
{
	name			pnt_plate_bright
	color			0.75 0.75 0.78
}

# No tileable photo/scan asset (bark/plaster/rust) exists in-repo, so this
# substitutes a procedural checker source to exercise the de-tiling
# MECHANISM.  stochastic_tile_painter's intended use is a small tiling
# photo/scan, per the skill -- this is not that, just a stand-in source.
checker_painter
{
	name			plate_checker_src
	colora			pnt_plate_dark
	colorb			pnt_plate_bright
	size			0.09
}

stochastic_tile_painter
{
	name			plate_stochastic
	source			plate_checker_src
	tile_scale		10.0
	seed			3
	mean			0.42 0.42 0.43
	blend_gamma		7.0
	color_space		Rec709RGB_Linear
}

uniformcolor_painter
{
	name			pnt_tray_spec
	color			0.5 0.5 0.5
}

##################################################
# Painters -- floor
##################################################

uniformcolor_painter
{
	name			pnt_floor
	color			0.22 0.22 0.24
}

##################################################
# Materials
##################################################

ggx_material
{
	name			mat_wood_top
	rd				blend_wood_stained
	rs				pnt_wood_spec
	alphax			sp_wood_rough
	alphay			sp_wood_rough
	ior				1.5
	extinction		0.0
}

ggx_material
{
	name			mat_vise
	rd				ramp_vise
	rs				pnt_vise_spec
	alphax			sp_vise_rough
	alphay			sp_vise_rough
	ior				sp_vise_ior
	extinction		sp_vise_extinction
}

ggx_material
{
	name			mat_tray
	rd				plate_stochastic
	rs				pnt_tray_spec
	alphax			0.25
	alphay			0.25
	ior				2.5
	extinction		3.0
}

lambertian_material
{
	name			mat_floor
	reflectance		pnt_floor
}

