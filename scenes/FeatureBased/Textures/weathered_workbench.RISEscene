	position		-1.35 0.4 0.45
	modifier		relief_wood
}

standard_object
{
	name			obj_leg_br
	geometry		geo_leg
	material		mat_wood_top
	position		1.35 0.4 0.45
	modifier		relief_wood
}

##################################################
# Objects -- the bench vise (bolted to the right end of the bench).
#
# DOCTRINE 7 (plank_closeup.RISEscene's header): the silhouette has to say
# what the object is before a single painter is bound to it.  Local frame:
# +Y up, +Z out along the screw axis, origin on the flange's underside, so
# the object below simply drops local y = 0 onto the bench top at y = 0.91.
#
#  1  base flange              roundbox, 390 x 28 x 344 mm, 12 mm arris
#  2  cast body                roundbox, smin k 30 mm to the flange -- the
#                              fillet a casting is drawn with, and the flat
#                              top behind the jaw is the anvil pad
#  3  fixed rear jaw           roundbox, smin k 24 mm, rising out of 2
#  4  slide bar                box, HARD union: a machined member meets a
#                              casting at an edge, never at a fillet
#  5  movable jaw body         roundbox, smin k 21 mm, wrapping 4
#  6  movable front jaw        roundbox, smin k 24 mm
#  7  rear jaw pad             box, hard union, standing 17 mm PROUD of the
#  8  front jaw pad            casting -- see the mask note below
#  9  lead screw               cylinder on Z, emerging from 5
# 10  thrust collar            cylinder
# 11  T-handle                 capsule, hung -35 deg and slid 45 mm off
#                              centre in its hole
# 12-15  bolt heads            cylinders standing 18 mm proud of the flange
#
# The jaws stand 56 mm apart (10 px) and the pads 24 mm (4 px): the gap is
# the second thing after the handle that says "vise", so it is sized to be
# seen, not to be right.
#
# `orientation 0 48 0` -- a vise has a swivel base precisely so it can sit
# at an angle to the bench, and 48 degrees is the yaw that puts the jaw
# gap, the jaw faces and the whole length of the handle in shot at once.
##################################################

sdf_geometry
{
	name			geo_vise
	part			roundbox  union     0        0       0.021  -0.030     0 0 0     1 1 1    0.195  0.021  0.172    0.018
	part			roundbox  smin      0.030    0       0.114  -0.078     0 0 0     1 1 1    0.120  0.093  0.093    0.027
	part			roundbox  smin      0.024    0       0.219  -0.054     0 0 0     1 1 1    0.135  0.081  0.039    0.015
	part			box       union     0        0       0.150   0.030     0 0 0     1 1 1    0.054  0.039  0.128    0
	part			roundbox  smin      0.021    0       0.156   0.128     0 0 0     1 1 1    0.093  0.054  0.045    0.018
	part			roundbox  smin      0.024    0       0.219   0.113     0 0 0     1 1 1    0.135  0.081  0.039    0.015
	part			box       union     0        0       0.244  -0.0068    0 0 0     1 1 1    0.114  0.073  0.0082   0
	part			box       union     0        0       0.244   0.0658    0 0 0     1 1 1    0.114  0.073  0.0082   0
	part			cylinder  union     0        0       0.150   0.242     90 0 0    1 1 1    0.0225 0.105  0        0
	part			cylinder  union     0        0       0.150   0.320     90 0 0    1 1 1    0.042  0.015  0        0
	part			capsule   union     0        0.0528  0.1889  0.359     0 0 -35   1 1 1    0.021  0.145  0        0
	part			cylinder  union     0       -0.150   0.048  -0.150     0 0 0     1 1 1    0.0255 0.012  0        0
	part			cylinder  union     0        0.150   0.048  -0.150     0 0 0     1 1 1    0.0255 0.012  0        0
	part			cylinder  union     0       -0.150   0.048   0.090     0 0 0     1 1 1    0.0255 0.012  0        0
	part			cylinder  union     0        0.150   0.048   0.090     0 0 0     1 1 1    0.0255 0.012  0        0
	maxsteps		192
}

standard_object
{
	name			obj_vise
	geometry		geo_vise
	material		mat_vise
	position		1.15 0.91 -0.02
	orientation		0 48 0
	modifier		relief_vise
}

