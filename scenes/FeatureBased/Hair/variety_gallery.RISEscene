##################################################
# S6 -- FOX-STYLE TWO-LAYER GUARD COAT.  The structure specimen.
#
# TWO grooms on one block, and the only specimen here that needs two.
# `groom_s6u` is 150 k short (0.028 m), fine, heavily medullated fibres
# (kappa 0.80) in warm ginger -- the soft, saturated, light-diffusing
# bulk.  `groom_s6g` is 72 k longer (0.066 m), coarser, DARKER fibres
# (eumelanin 2.30 against the undercoat's 0.30) with a thinner medulla
# and a sharper roughness -- the guard hairs that break the silhouette
# and give the coat its dark tipping.
#
# NOTE (corrected after authoring): an along-strand parameter DOES
# exist -- `ri.ptCoord.x` carries the root-to-tip arc-length fraction at
# the shading point, and ordinary painters can read it (the gap was
# discoverability, not capability; see HAIR_FUR_DESIGN.md).  A per-fibre
# agouti band is therefore expressible directly.  The two-groom
# two-melanin structural substitution used here still earns its keep --
# it separates guard silhouette from undercoat mass, which a band on
# one groom cannot -- and remains the part worth copying.
##################################################
scalar_painter
{
	name			eu_s6u
	value			0.30
}

scalar_painter
{
	name			ph_s6u
	value			1.55
}

hair_material
{
	name			mat_s6u
	eumelanin		eu_s6u
	pheomelanin		ph_s6u
	beta_m			0.45
	beta_n			0.55
	alpha			2.2
	ior			1.55
	medulla_ratio		0.80
	medulla_scatter		2.4
	medulla_g		0.50
}

scalar_painter
{
	name			eu_s6g
	value			2.30
}

scalar_painter
{
	name			ph_s6g
	value			0.85
}

