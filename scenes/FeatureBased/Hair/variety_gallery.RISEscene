##################################################
# S4 -- AFRO-TEXTURED COILS.  The volume specimen.
#
# The shape here comes from what is NOT set: `gravity` 0.06 means the
# coat keeps growing along the normal instead of falling, so the mass
# stays round and stands away from the block.  Tight coils
# (`curl_radius` 0.0045 / `curl_step` 0.011, a helix that turns four
# times in a centimetre) plus heavy `frizz` 0.55 give the interior its
# texture, and the largest strand budget on the plate (300 k) is what
# keeps a mass that big from going transparent.  A small medulla (0.25)
# lifts it just off pure absorption.
##################################################
scalar_painter
{
	name			eu_s4
	value			5.50
}

scalar_painter
{
	name			ph_s4
	value			0.10
}

hair_material
{
	name			mat_s4
	eumelanin		eu_s4
	pheomelanin		ph_s4
	beta_m			0.34
	beta_n			0.42
	alpha			2.5
	ior			1.55
	medulla_ratio		0.25
	medulla_scatter		1.0
	medulla_g		0.35
}

