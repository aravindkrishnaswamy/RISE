{
	name			mat_s6g
	eumelanin		eu_s6g
	pheomelanin		ph_s6g
	beta_m			0.26
	beta_n			0.32
	alpha			2.8
	ior			1.55
	medulla_ratio		0.50
	medulla_scatter		1.6
	medulla_g		0.35
}

