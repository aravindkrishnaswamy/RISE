##################################################
# S7 -- ANGORA UNDERCOAT.  The diffuse-fur end of the axis.
#
# `medulla_ratio` 0.90 is the highest on the plate, near the 0.95 clamp,
# with `medulla_scatter` 2.8: almost the whole fibre is scattering core
# rather than absorbing cortex.  Combined with the highest roughness
# pair here (0.55 / 0.65) and the finest fibres (0.09 mm root), the
# result reads as VELVET rather than as strands -- which is the correct
# answer for rabbit undercoat and the clearest demonstration on the
# plate of what the Yan et al. 2017 medulla lobes actually buy.
##################################################
scalar_painter
{
	name			eu_s7
	value			0.060
}

scalar_painter
{
	name			ph_s7
	value			0.200
}

hair_material
{
	name			mat_s7
	eumelanin		eu_s7
	pheomelanin		ph_s7
	beta_m			0.55
	beta_n			0.65
	alpha			2.0
	ior			1.55
	medulla_ratio		0.90
	medulla_scatter		2.8
	medulla_g		0.55
}

hair_geometry
{
	name			groom_s7
	base_geometry		geo_bust
	count			220000
	segments		5
	length			0.032
	width_root		0.00009
	width_tip		0.00004
	base_detail		144
	seed			103
	density			pnt_pelt
	length_painter		pnt_lenjit
	gravity			0.28
	frizz			0.35
	clump			0.30
	clump_size		0.007
}

##################################################
# S8 -- COARSE BOAR BRISTLE.  The wiry end, and the sparse one.
#
# 14 000 strands -- fifteen times fewer than S7 -- at 1.4 mm root width,
# fifteen times thicker.  A bristle brush is SPARSE and that is what
# makes it a bristle brush; the temptation to raise the count is the
# thing to resist.  `gravity` 0.03 and `frizz` 0.05 keep each quill
# straight and radial, so the rim light rakes along individual fibres
# and they resolve as separate lines at this framing where every other
# specimen resolves only as a mass.
##################################################
scalar_painter
{
	name			eu_s8
	value			3.20
}

scalar_painter
{
	name			ph_s8
	value			0.35
}

hair_material
{
	name			mat_s8
	eumelanin		eu_s8
	pheomelanin		ph_s8
	beta_m			0.20
	beta_n			0.22
	alpha			2.0
	ior			1.55
	medulla_ratio		0.25
	medulla_scatter		0.8
	medulla_g		0.30
}

hair_geometry
{
	name			groom_s8
	base_geometry		geo_bust
	count			14000
	segments		4
	length			0.115
	width_root		0.00140
	width_tip		0.00050
	base_detail		144
	seed			109
	density			pnt_pelt
	length_painter		pnt_lenjit
	gravity			0.03
	frizz			0.05
}

##################################################
# S9 -- SHEEP FLEECE.  The Tier-3 specimen, and the clumped one.
#
# `color` takes an artist reflectance swatch and inverts it to an
# absorption per Chiang's sigma_a = (ln C / D(beta_n))^2 -- the right
# tier when the answer is "this cream" and not "this chemistry".
#
# The crimped mass is `clump` 0.66 at `clump_size` 0.024 (roots
# quantised onto a 24 mm grid, each cell's first strand becoming its
# centre) over heavy `frizz` 0.70 and a short tight curl.  Clumping is
# what turns an even coat into locks; an earlier pass at `clump_size`
# 0.011 made the cell grid itself visible as corduroy, so the cell has
# to be large relative to the fibre spacing or the Phase-1 grid
# quantisation shows through.
##################################################
uniformcolor_painter
{
	name			col_s9
	color			0.720 0.655 0.510
}

hair_material
{
	name			mat_s9
	color			col_s9
	beta_m			0.60
	beta_n			0.70
	alpha			2.0
	ior			1.55
	medulla_ratio		0.72
	medulla_scatter		2.0
	medulla_g		0.45
}

hair_geometry
{
	name			groom_s9
	base_geometry		geo_bust
	count			190000
	segments		12
	length			0.062
	width_root		0.00024
	width_tip		0.00013
	base_detail		144
	seed			127
	density			pnt_pelt
	length_painter		pnt_lenjit
	gravity			0.24
	frizz			0.70
	clump			0.66
	clump_size		0.024
	curl_radius		0.0075
	curl_step		0.014
}

##################################################
# PLACEMENT -- three tiers, staggered.
#
# Rows at y = 0.00 / 0.46 / 0.92 and z = 0.00 / -0.78 / -1.56, with the
# columns offset half a cell per row so no stem ever sits directly
# above another (aligned stems read as three totem poles; this was the
# first composition and it was worse).  The rises are tuned against the
# 245 mm lens so that each row's bases clear the row in front by a
# visible gap in SCREEN space, which is what a stepped museum riser
# does and what makes nine specimens legible in one frame.
##################################################
