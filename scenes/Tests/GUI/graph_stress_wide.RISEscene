RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                               #
#                                                                                                           #
#   File:           graph_stress_wide.RISEscene                                                           #
#   Description:    doc-88 Phase 3 S23 GUI stress scene 1/3 -- ~130 Painter/Material chunks, heavy        #
#                   painter sharing (several hub nodes fanned out to 6-10 referrers), deep reference      #
#                   chains (7+ ranks from a base colour through mapping/stochastic-tile/blend/scalar    #
#                   to a material), and one instance of every doc-88 arc chunk kind (expression_painter,  #
#                   ramp_painter, mapping_painter, stochastic_tile_painter, scatter_painter,            #
#                   voronoi3d_painter{space world}, blend_painter across all five modes).  This is a     #
#                   CANVAS layout/perf/badge workout, not a beauty render -- film and sample count are   #
#                   kept tiny on purpose (Part 2 of NODE_GRAPH_CANVAS.md S23).                       #
#   Author:         RISE contributors
#   Birthdate:      2026-08-21
#############################################################################################################

##################################################
# Setup a renderer
##################################################

standard_shader
{
	name			global
	shaderop		DefaultDirectLighting
}

pixelpel_rasterizer
{
	max_recursion		3
	samples			4
	lum_samples		1
}

file_rasterizeroutput
{
	pattern			rendered/graph_stress_wide
	type			PNG
	bpp			8
	color_space		sRGB
}

##################################################
# Cameras
##################################################

film
{
	width			800
	height			600
}

pinhole_camera
{
	location		0 5.5 15
	lookat			0 0 0
	up			0 1 0
	fov			42.0
}

