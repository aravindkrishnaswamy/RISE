##################################################
# Painters -- expression_painter fields (full param metadata, arc requirement)
##################################################

expression_painter
{
	name			expr_marble
	param			ring_freq 3.0 min 0.5 max 10 step 0.25 label "Vein frequency"
	param			warp_amt 0.5 min 0.0 max 2.0 step 0.05 label "Domain warp strength"
	def			warp_p P*ring_freq + warp_amt*vec3(fbm(P*ring_freq,4,0.5,2.0), fbm(P*ring_freq+vec3(5.2,1.3,7.7),4,0.5,2.0), fbm(P*ring_freq+vec3(9.1,2.6,4.4),4,0.5,2.0))
	def			vein fbm(warp_p, 5, 0.55, 2.1)
	expr			mix(vec3(0.04,0.04,0.06), vec3(0.88,0.86,0.82), clamp(0.5+0.5*sin(vein*6.0),0,1))
}

expression_painter
{
	name			expr_terrain
	param			freq 1.6 min 0.5 max 4.0 step 0.1 label "Terrain frequency"
	param			contrast 2.6 min 1.0 max 5.0 step 0.1 label "Elevation contrast"
	def			h fbm(P*freq, 5, 0.5, 2.0)
	def			t clamp(h*contrast, -1, 1)
	expr			vec3(0.5+0.5*t, 0.5+0.5*t, 0.5+0.5*t)
}

expression_painter
{
	name			expr_rust
	param			spot_freq 4.0 min 1.0 max 12.0 step 0.5 label "Rust spot frequency"
	param			spot_thresh 0.3 min -1.0 max 1.0 step 0.05 label "Rust coverage threshold"
	def			s fbm(P*spot_freq, 4, 0.5, 2.0)
	def			m smoothstep(spot_thresh, spot_thresh+0.3, s)
	expr			mix(vec3(0.55,0.30,0.10), vec3(0.20,0.08,0.03), m)
}

expression_painter
{
	name			expr_wood
	param			along 3.0 min 0.5 max 12 step 0.25 label "Grain freq along"
	param			across 14.0 min 2 max 40 step 1 label "Grain freq across"
	def			wp vec3(P.x*across, P.y*along, P.z*along)
	def			g fbm(wp, 5, 0.55, 2.1)
	expr			vec3(clamp(g*2.2+0.5,0,1), clamp(g*2.0+0.45,0,1), clamp(g*1.8+0.4,0,1))
}

expression_painter
{
	name			expr_clouds
	param			cfreq 1.2 min 0.2 max 5.0 step 0.1 label "Cloud frequency"
	param			coverage 0.4 min 0.0 max 1.0 step 0.05 label "Cloud coverage"
	def			c fbm(P*cfreq, 6, 0.5, 2.0)
	def			m smoothstep(coverage-0.2, coverage+0.2, c)
	expr			mix(vec3(0.10,0.20,0.45), vec3(0.95,0.95,0.98), m)
}

expression_painter
{
	name			expr_lava
	param			lfreq 2.5 min 0.5 max 8.0 step 0.25 label "Lava crack frequency"
	param			heat 0.6 min 0.0 max 1.0 step 0.05 label "Heat bias"
	def			l fbm(P*lfreq, 5, 0.6, 2.2)
	def			t clamp(l+heat, 0, 1)
	expr			mix(vec3(0.05,0.02,0.02), vec3(0.95,0.35,0.05), t)
}

expression_painter
{
	name			expr_ice
	param			ifreq 5.0 min 1.0 max 15.0 step 0.5 label "Ice crack frequency"
	param			clarity 0.5 min 0.0 max 1.0 step 0.05 label "Ice clarity"
	def			i fbm(P*ifreq, 4, 0.5, 2.0)
	def			t clamp(i*clarity+0.5, 0, 1)
	expr			mix(vec3(0.70,0.85,0.95), vec3(0.95,0.98,1.0), t)
}

expression_painter
{
	name			expr_moss
	param			mfreq 6.0 min 1.0 max 20.0 step 0.5 label "Moss patch frequency"
	param			patchiness 0.5 min 0.0 max 1.0 step 0.05 label "Moss patchiness"
	def			m1 fbm(P*mfreq, 3, 0.5, 2.0)
	def			t smoothstep(patchiness-0.25, patchiness+0.25, m1)
	expr			mix(vec3(0.30,0.15,0.05), vec3(0.15,0.45,0.10), t)
}

##################################################
# Painters -- ramp_painter (consumes the expression fields, arc requirement)
##################################################

ramp_painter
{
	name			ramp_marble
	input			expr_marble
	channel			R
	interpolation		smooth
	stop			-1.0   0.02 0.08 0.35
	stop			-0.15   0.76 0.7 0.45
	stop			0.15   0.2 0.55 0.15
	stop			1.0   0.95 0.95 0.98
	color_space		Rec709RGB_Linear
}

ramp_painter
{
	name			ramp_terrain
	input			expr_terrain
