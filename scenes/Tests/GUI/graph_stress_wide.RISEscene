	scale			0.4
	bias			0.05
}

scalar_painter
{
	name			sp_deepchain_rough
	painter			blend_deepchain_2
	channel			G
	scale			0.35
	bias			0.05
}

scalar_painter
{
	name			sp_expr_0
	param			freq 8.0 min 2 max 30 step 0.5 label "Frequency"
	param			rough_lo 0.05 min 0 max 1 step 0.01 label "Polished roughness"
	param			rough_hi 0.5 min 0 max 1 step 0.01 label "Rough roughness"
	def			f1 worley_f1(P*freq, 1.0)
	expression		mix(rough_lo, rough_hi, clamp(f1, 0, 1))
}

scalar_painter
{
	name			sp_expr_1
	param			freq 10.0 min 2 max 30 step 0.5 label "Frequency"
	param			rough_lo 0.05 min 0 max 1 step 0.01 label "Polished roughness"
	param			rough_hi 0.5 min 0 max 1 step 0.01 label "Rough roughness"
	def			f1 worley_f1(P*freq, 1.0)
	expression		mix(rough_lo, rough_hi, clamp(f1, 0, 1))
}

scalar_painter
{
	name			sp_expr_2
	param			freq 12.0 min 2 max 30 step 0.5 label "Frequency"
	param			rough_lo 0.05 min 0 max 1 step 0.01 label "Polished roughness"
	param			rough_hi 0.5 min 0 max 1 step 0.01 label "Rough roughness"
	def			f1 worley_f1(P*freq, 1.0)
	expression		mix(rough_lo, rough_hi, clamp(f1, 0, 1))
}

scalar_painter
{
	name			sp_expr_3
	param			freq 14.0 min 2 max 30 step 0.5 label "Frequency"
	param			rough_lo 0.05 min 0 max 1 step 0.01 label "Polished roughness"
	param			rough_hi 0.5 min 0 max 1 step 0.01 label "Rough roughness"
	def			f1 worley_f1(P*freq, 1.0)
	expression		mix(rough_lo, rough_hi, clamp(f1, 0, 1))
}

