RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                             #
#   File:           panel_stress_params.RISEscene                                                           #
#   Description:    doc-88 Phase 3 S23 GUI stress scene 3/3 -- the property-panel + PainterPreview engine    #
#                   load test.  Three expression_painter nodes each carry 10+ fully-annotated params        #
#                   (min/max/step/label) and a 5-6 deep, strictly SEQUENTIAL def chain (each def consumes   #
#                   the previous one) -- the def-stage thumbnail strip workout.  One ramp_painter carries    #
#                   twelve stops.  Two scalar_painter{expression} nodes have a vec3-typed body, so their     #
#                   value genuinely varies PER CHANNEL (R != G != B) rather than broadcasting one scalar --  #
#                   the "per-channel scalars" case.  Kept to a handful of objects and a tiny film/sample     #
#                   count: this scene stresses the PANEL, not the renderer.                                 #
#   Author:         RISE contributors                                                                       #
#   Birthdate:      2026-08-21                                                                              #
#                                                                                                           #
#############################################################################################################

##################################################
# Setup a renderer
##################################################

standard_shader
{
	name			global
	shaderop		DefaultDirectLighting
}

pixelpel_rasterizer
{
	max_recursion		3
	samples				4
	lum_samples			1
}

file_rasterizeroutput
{
	pattern			rendered/panel_stress_params
	type			PNG
	bpp				8
	color_space		sRGB
}

##################################################
# Cameras
##################################################

film
{
	width			800
	height			600
}

pinhole_camera
{
	location		0 2.2 8.5
	lookat			0 0 0
	up				0 1 0
	fov				36.0
}

##################################################
# Painters -- expr 1/3: "panel_terrain_field", 12 fully-annotated params,
# a 6-deep SEQUENTIAL def chain (warp_p -> base_h -> ridged_h -> detail ->
# h -> moist -> expr).  Each def stage renders its own thumbnail in the
# property panel's stage strip -- this is the node to open first when
# checking that the strip scrolls/paginates past five stages cleanly.
##################################################

expression_painter
{
	name			panel_terrain_field
	param			freq_base      1.4  min 0.2  max 6.0   step 0.1   label "Base frequency"
	param			freq_warp      0.8  min 0.2  max 4.0   step 0.1   label "Warp frequency"
	param			warp_strength  0.45 min 0.0  max 2.0   step 0.05  label "Warp strength"
	param			ridge_sharpness 0.6 min 0.0  max 1.0   step 0.05  label "Ridge sharpness"
	param			valley_depth   0.3  min 0.0  max 1.0   step 0.05  label "Valley depth"
	param			snow_line      0.35 min -1.0 max 1.0   step 0.05  label "Snow line height"
	param			rock_tint      0.8  min 0.0  max 1.5   step 0.05  label "Rock tint strength"
	param			moisture       0.5  min 0.0  max 1.0   step 0.05  label "Base moisture"
	param			erosion        0.4  min 0.0  max 1.0   step 0.05  label "Erosion strength"
	param			detail_freq    9.0  min 2.0  max 30.0  step 0.5   label "Detail frequency"
	param			detail_amount  0.15 min 0.0  max 0.6   step 0.02  label "Detail amount"
	param			contrast       1.8  min 1.0  max 4.0   step 0.1   label "Elevation contrast"
	def				warp_p P*freq_warp + warp_strength*vec3(fbm(P*freq_warp,4,0.5,2.0), fbm(P*freq_warp+vec3(5.2,1.3,7.7),4,0.5,2.0), fbm(P*freq_warp+vec3(9.1,2.6,4.4),4,0.5,2.0))
	def				base_h fbm(warp_p*freq_base, 5, 0.5, 2.0)
	def				ridged_h 1.0 - abs(base_h)
	def				detail fbm(P*detail_freq, 3, 0.5, 2.0)*detail_amount
	def				h clamp((ridged_h*ridge_sharpness + base_h*(1.0-ridge_sharpness) + detail - valley_depth*0.3)*contrast, -1, 1)
	def				moist clamp(moisture - erosion*h, 0, 1)
	expr			mix(vec3(0.15,0.12,0.08)*rock_tint, mix(vec3(0.85,0.85,0.90), vec3(0.30,0.50,0.25), moist), smoothstep(-0.2, snow_line, h))
}

##################################################
# Painters -- expr 2/3: "panel_organic_field", 10 fully-annotated params,
# a 5-deep sequential def chain (warp_p -> vein -> pore -> pigment_t ->
# blush_t -> expr).
##################################################

expression_painter
{
	name			panel_organic_field
	param			vein_freq       5.0  min 1.0 max 20.0 step 0.5  label "Vein frequency"
	param			vein_warp       0.4  min 0.0 max 2.0  step 0.05 label "Vein warp strength"
	param			pigment_bias    0.1  min -1.0 max 1.0 step 0.05 label "Pigment bias"
	param			pigment_contrast 2.0 min 1.0 max 5.0  step 0.1  label "Pigment contrast"
	param			pore_freq       22.0 min 4.0 max 60.0 step 1.0  label "Pore frequency"
	param			pore_amount     0.12 min 0.0 max 0.5  step 0.02 label "Pore amount"
	param			blush_strength  0.35 min 0.0 max 1.0  step 0.05 label "Blush strength"
	param			blush_freq      1.6  min 0.2 max 5.0  step 0.1  label "Blush frequency"
	param			translucency    0.5  min 0.0 max 1.0  step 0.05 label "Translucency tint"
	param			seed_val        3.0  min 0.0 max 50.0 step 1.0  label "Pattern seed"
	def				warp_p P*vein_freq + vein_warp*vec3(fbm(P*vein_freq+vec3(seed_val,0,0),3,0.5,2.0), fbm(P*vein_freq+vec3(0,seed_val,0),3,0.5,2.0), fbm(P*vein_freq+vec3(0,0,seed_val),3,0.5,2.0))
	def				vein fbm(warp_p, 4, 0.55, 2.0)
	def				pore fbm(P*pore_freq+vec3(seed_val,seed_val,0), 3, 0.5, 2.0)*pore_amount
	def				pigment_t clamp((vein-pore)*pigment_contrast + pigment_bias, -1, 1)
	def				blush_t smoothstep(0.2, 0.2+blush_strength, fbm(P*blush_freq,3,0.5,2.0))
	expr			mix(mix(vec3(0.85,0.68,0.62), vec3(0.55,0.28,0.22), 0.5+0.5*pigment_t), vec3(0.90,0.45,0.42), blush_t*translucency)
}

##################################################
# Painters -- expr 3/3: "panel_metal_field", 11 fully-annotated params,
# a 5-def sequential chain (scratch -> scratch_line -> oxide_n ->
# oxide_mask -> base_col -> expr).
##################################################

expression_painter
{
	name			panel_metal_field
	param			scratch_freq    18.0 min 4.0  max 50.0 step 1.0  label "Scratch frequency"
	param			scratch_anis    3.0  min 1.0  max 8.0  step 0.25 label "Scratch anisotropy"
	param			scratch_amount  0.18 min 0.0  max 0.6  step 0.02 label "Scratch amount"
	param			oxide_freq      2.5  min 0.5  max 8.0  step 0.1  label "Oxide patch frequency"
	param			oxide_thresh    0.1  min -1.0 max 1.0  step 0.05 label "Oxide threshold"
	param			oxide_soft      0.35 min 0.05 max 1.0  step 0.05 label "Oxide edge softness"
	param			base_r          0.72 min 0.0  max 1.0  step 0.01 label "Base metal red"
	param			base_g          0.72 min 0.0  max 1.0  step 0.01 label "Base metal green"
	param			base_b          0.75 min 0.0  max 1.0  step 0.01 label "Base metal blue"
	param			oxide_r         0.25 min 0.0  max 1.0  step 0.01 label "Oxide tint red"
	param			oxide_g         0.45 min 0.0  max 1.0  step 0.01 label "Oxide tint green"
	def				scratch fbm(vec3(P.x*scratch_freq*scratch_anis, P.y*scratch_freq, P.z*scratch_freq), 4, 0.5, 2.0)
	def				scratch_line abs(sin(scratch*20.0))*scratch_amount
	def				oxide_n fbm(P*oxide_freq, 4, 0.55, 2.0)
	def				oxide_mask smoothstep(oxide_thresh, oxide_thresh+oxide_soft, oxide_n)
	def				base_col vec3(base_r,base_g,base_b) - vec3(scratch_line,scratch_line,scratch_line)*0.3
	expr			mix(base_col, vec3(oxide_r,oxide_g,0.05), oxide_mask)
}

##################################################
# Painters -- a 12-stop ramp_painter (many-stops workout for the ramp
# editor's stop-row list; the def-chain field above feeds it).
##################################################

ramp_painter
{
	name			panel_ramp_many
	input			panel_terrain_field
	channel			R
	interpolation	smooth
	stop			0.000  0.02 0.02 0.08
	stop			0.090  0.05 0.05 0.15
	stop			0.180  0.10 0.08 0.22
	stop			0.270  0.18 0.12 0.28
	stop			0.360  0.30 0.18 0.28
	stop			0.450  0.45 0.25 0.22
	stop			0.540  0.62 0.38 0.18
	stop			0.630  0.75 0.55 0.20
	stop			0.720  0.85 0.72 0.30
	stop			0.810  0.90 0.85 0.55
	stop			0.900  0.95 0.95 0.85
	stop			1.000  1.00 1.00 1.00
	color_space		Rec709RGB_Linear
}

##################################################
# Painters -- per-channel scalars (scalar_painter{expression} with a
# vec3-typed body -> a genuine R != G != B scalar, not a broadcast).
##################################################

scalar_painter
{
	name			panel_scalar_dispersion
	param			ior_r          1.51 min 1.40 max 1.80 step 0.005 label "IOR red"
	param			ior_g          1.52 min 1.40 max 1.80 step 0.005 label "IOR green"
	param			ior_b          1.54 min 1.40 max 1.80 step 0.005 label "IOR blue"
	param			dispersion_amt 1.0  min 0.0  max 3.0   step 0.05  label "Dispersion amount"
	def				spread (ior_b-ior_r)*dispersion_amt
	expression		vec3(ior_r, ior_r+spread*0.5, ior_r+spread)
}

scalar_painter
{
	name			panel_scalar_roughness_rgb
	param			rough_r  0.05 min 0.0 max 1.0 step 0.01 label "Roughness (R probe)"
	param			rough_g  0.20 min 0.0 max 1.0 step 0.01 label "Roughness (G probe)"
	param			rough_b  0.55 min 0.0 max 1.0 step 0.01 label "Roughness (B probe)"
	def				n worley_f1(P*6.0, 1.0)
	expression		vec3(mix(rough_r,rough_g,clamp(n,0,1)), rough_g, mix(rough_g,rough_b,clamp(n,0,1)))
}

##################################################
# Materials
##################################################

lambertian_material
{
	name			mat_terrain
	reflectance		panel_ramp_many
}

lambertian_material
{
	name			mat_organic
	reflectance		panel_organic_field
}

ggx_material
{
	name			mat_metal
	rd				panel_metal_field
	rs				panel_metal_field
	alphax			panel_scalar_roughness_rgb
	alphay			panel_scalar_roughness_rgb
	ior				1.8
	extinction		2.5
}

dielectric_material
{
	name			mat_glass_dispersive
	tau				1
	ior				panel_scalar_dispersion
}

##################################################
# Geometry + objects
##################################################

sphere_geometry
{
	name			geo_ball
	radius			0.9
}

standard_object
{
	name			obj_terrain
	geometry		geo_ball
	material		mat_terrain
	position		-2.7 0.9 0
}

standard_object
{
	name			obj_organic
	geometry		geo_ball
	material		mat_organic
	position		-0.9 0.9 0
}

standard_object
{
	name			obj_metal
	geometry		geo_ball
	material		mat_metal
	position		0.9 0.9 0
}

standard_object
{
	name			obj_glass
	geometry		geo_ball
	material		mat_glass_dispersive
	position		2.7 0.9 0
}

uniformcolor_painter
{
	name			pnt_floor_grey
	color			0.30 0.30 0.32
}

lambertian_material
{
	name			mat_floor
	reflectance		pnt_floor_grey
}

infiniteplane_geometry
{
	name			floor
	xtile			1.0
	ytile			1.0
}

standard_object
{
	name			obj_floor
	geometry		floor
	material		mat_floor
	position		0 0 0
	orientation		-90 0 0
	receives_shadows	false
}

##################################################
# Lights
##################################################

directional_light
{
	name		key
	power		3.14
	color		1.0 1.0 1.0
	direction	0.5 0.8 0.6
}

directional_light
{
	name		fill
	power		1.0
	color		0.85 0.9 1.0
	colorspace	sRGB
	direction	-0.4 0.5 0.6
}
