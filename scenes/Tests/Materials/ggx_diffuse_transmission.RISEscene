RISE ASCII SCENE 7
#############################################################################################################
#
#   DL-37 GGX diffuse interface transmission render fixture.
#
#   Three PBR spheres retain the coloured-dielectric / gold-metal comparison
#   from pbr_metallic_roughness.RISEscene.  Direct lighting makes the specular
#   highlights legible while keeping the image inexpensive enough for a
#   serial before/after capture.
#
#############################################################################################################

standard_shader
{
	name			global
	shaderop		DefaultDirectLighting
}

pixelpel_rasterizer
{
	max_recursion		3
	samples			64
	lum_samples		1
	oidn_denoise		FALSE
	pixel_filter		box
}

file_rasterizeroutput
{
	pattern			rendered/DL37_pbr
	type			EXR
	bpp			16
	color_space		Rec709RGB_Linear
}

film
{
	width			384
	height			128
}

pinhole_camera
{
	location		0 0 6
	lookat			0 0 0
	up			0 1 0
	fov			40.0
}

uniformcolor_painter
{
	name			pbr_orange
	color			0.95 0.45 0.10
	colorspace		sRGB
}

uniformcolor_painter
{
	name			pbr_blue
	color			0.10 0.30 0.85
	colorspace		sRGB
}

uniformcolor_painter
{
	name			pbr_gold
	color			1.00 0.85 0.40
	colorspace		sRGB
}

pbr_metallic_roughness_material
{
	name			mat_orange
	base_color		pbr_orange
	metallic		0.0
	roughness		0.4
}

pbr_metallic_roughness_material
{
	name			mat_blue
	base_color		pbr_blue
	metallic		0.0
	roughness		0.7
}

pbr_metallic_roughness_material
{
	name			mat_gold
	base_color		pbr_gold
	metallic		1.0
	roughness		0.2
}

sphere_geometry
{
	name			sph
	radius			0.7
}

standard_object
{
	name			s_orange
	geometry		sph
	material		mat_orange
	position		-1.7 0 0
}

standard_object
{
	name			s_blue
	geometry		sph
	material		mat_blue
	position		0.0 0 0
}

standard_object
{
	name			s_gold
	geometry		sph
	material		mat_gold
	position		1.7 0 0
}

directional_light
{
	name			key
	power			3.14
	color			1.0 1.0 1.0
	direction		0.5 0.5 0.7
}
