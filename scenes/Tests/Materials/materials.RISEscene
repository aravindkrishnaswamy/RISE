#############################################################################################################


uniformcolor_painter
{
	name		color_white
	color		1.0 1.0 1.0
}













#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           povray_colors.RISEscene                                                                 #
#   Description:    Contains colors taken from POV-Ray                                                      #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################






















	
	

	




































































uniformcolor_painter
{
	name				50pgrey
	color				0.5 0.5 0.5
}

##################################################
# Materials
##################################################

lambertian_material
{
	name				lamb
	reflectance			50pgrey
}


# Legacy phase 2 slice B2: was ashikminshirley_anisotropicphong_material; ashikmin-shirley nu 1 nv 100 200 400 -> alphax 0.8165 alphay 0.14 0.0995 0.07053 (sqrt(2/(n+2))); PER-CHANNEL ROUGHNESS COLLAPSED: alphax 0.8165 alphay 0.14 0.0995 0.07053 -> 0.8165 / 0.106 (Rec.709-luminance-weighted mean; ggx_material reads only the first channel under RGB), rs -> F0 (schlick_f0) (SCENE_CONVENTIONS 11.5).
ggx_material
{
	name				aniso
	rd					50pgrey
	rs					color_white
	alphax				0.8165
	alphay				0.10603
	fresnel_mode		schlick_f0
}

uniformcolor_painter
{
	name				facets
	colorspace			RISERGB
	color				0.1 0.15 0.3
}

# Legacy phase 2 slice B2: was cooktorrance_material; cooktorrance_material -> ggx_material conductor, alpha = facets 0.1 0.15 0.3; PER-CHANNEL ROUGHNESS COLLAPSED: alphax 0.1 0.15 0.3 alphay 0.1 0.15 0.3 -> 0.1502 / 0.1502 (Rec.709-luminance-weighted mean; ggx_material reads only the first channel under RGB) (SCENE_CONVENTIONS 11.5).
ggx_material
{
	name				ct
	rd					50pgrey
	rs					color_white
	alphax				0.1502
	alphay				0.1502
	fresnel_mode		conductor
	ior					1.8
	extinction			0
}

uniformcolor_painter
{
	name				alphay
	colorspace			RISERGB
	color				0.1 0.2 0.3
}

# Legacy phase 2 slice B2: was ward_anisotropic_material; ward_anisotropic alphax 0.9 alphay 0.1 0.2 0.3 carried; PER-CHANNEL ROUGHNESS COLLAPSED: alphax 0.9 alphay 0.1 0.2 0.3 -> 0.9 / 0.186 (Rec.709-luminance-weighted mean; ggx_material reads only the first channel under RGB), rs -> F0 (schlick_f0) (SCENE_CONVENTIONS 11.5).
ggx_material
{
	name				wa
	rd					50pgrey
	rs					color_white
	alphax				0.9
	alphay				0.18596
	fresnel_mode		schlick_f0
}

uniformcolor_painter
{
	name				isotropy
	colorspace			RISERGB
	color				0.01 0.2 0.1
}

# Legacy phase 2 slice B2: was schlick_material; schlick roughness 0.01 -> alpha sqrt(r) = 0.1; isotropy 0.01 0.2 0.1 -> alphax 0.3162 0.1495 0.1778 alphay 0.03162 0.06687 0.05623 (heuristic: geometric-mean width kept, aspect 1/sqrt(isotropy)); PER-CHANNEL ROUGHNESS COLLAPSED: alphax 0.3162 0.1495 0.1778 alphay 0.03162 0.06687 0.05623 -> 0.187 / 0.05861 (Rec.709-luminance-weighted mean; ggx_material reads only the first channel under RGB), rs -> F0 (schlick_f0) (SCENE_CONVENTIONS 11.5).
ggx_material
{
	name				sc
	rd					50pgrey
	rs					color_white
	alphax				0.18702
	alphay				0.058611
	fresnel_mode		schlick_f0
}

uniformcolor_painter
{
	name				alpha
	colorspace			RISERGB
	color				0.1 0.2 0.3
}

# Legacy phase 2 slice B2: was ward_isotropic_material; ward_isotropic alpha 0.1 0.2 0.3 -> alphax = alphay; PER-CHANNEL ROUGHNESS COLLAPSED: alphax 0.1 0.2 0.3 alphay 0.1 0.2 0.3 -> 0.186 / 0.186 (Rec.709-luminance-weighted mean; ggx_material reads only the first channel under RGB), rs -> F0 (schlick_f0) (SCENE_CONVENTIONS 11.5).
ggx_material
{
	name				wi
	rd					50pgrey
	rs					color_white
	alphax				0.18596
	alphay				0.18596
	fresnel_mode		schlick_f0
}

##################################################
# Objects
##################################################

bezierpatch_geometry
{
	name				teapotgeom
	file				models/raw/teapot.bezier
	maxpatches			2
	maxdepth			7
	bsp					TRUE
	center_object		TRUE
}

standard_object
{
	name				teapot3
	geometry			teapotgeom
	orientation			10 -20 0
	position			-3.5 4 0
	material			lamb
	receives_shadows 	false
}

standard_object
{
	name				teapot4
	geometry			teapotgeom
	orientation			10 -20 0
	position			3.5 4 0
	material			wi
	receives_shadows 	false
}

standard_object
{
	name				teapot
	geometry			teapotgeom
	orientation			10 -20 0
	position			-3.5 0 0
	material			ct
	receives_shadows 	false
}

standard_object
{
	name				teapot2
	geometry			teapotgeom
	orientation			10 -20 0
	position			3.5 0 0
	material			sc
	receives_shadows 	false
}


standard_object
{
	name				teapot5
	geometry			teapotgeom
	orientation			10 -20 0
	position			-3.5 -4 0
	material			aniso
	receives_shadows 	false
}

standard_object
{
	name				teapot6
	geometry			teapotgeom
	orientation			10 -20 0
	position			3.5 -4 0
	material			wa
	receives_shadows 	false
}


directional_light
{
	name		light
	power		3.14
	color		1.0 1.0 1.0
	direction	0 0 1
}


