RISE ASCII SCENE 7
#
# DL-09 fixture (docs/DL09_GRADED_INDEX_INTERIOR_FACTOR.md): an INTERIOR
# gather inside a graded-index dielectric, camera OUTSIDE.
#
# A box G spanning z in [0, 2] whose `ior` is the tent
#     n(z) = 1.8 - 0.6*|z - 1|      (1.2 at both faces, 1.8 at mid-plane)
# holds a Lambertian floor C (rho 0.5, z = 0.02) lit ONLY by a one-sided
# luminaire plane E at the mid-plane (z = 1, facing -z, L = 1/pi).  An
# orthographic camera looks straight down the gradient, so every eye ray is
# parallel to grad(n) and bends in no model; the emitter covers the floor's
# upward hemisphere and n rises monotonically from C to E, so curved rays
# reach it from every direction too.  This is the configuration in which a
# straight-ray renderer can be EXACT (derivation doc section 5).
#
# Closed form (derivation doc section 3 (ii)):  pixel = T_A*rho*L_e*cov / n_E^2
# = 0.99174 * 0.5 * (1/pi) * 0.9988 / 3.24 = 0.04868.  Before DL-09 RISE
# charged the entry index n_A = 1.2 instead of n_E = 1.8: 2.25x too bright.
# tests/GradedIndexInteriorFactorTest.cpp renders this file (PT, and with the
# rasterizer block swapped, BDPT/VCM) against nested-box piecewise-constant
# references that converge to the same number.
#
# The test replaces the RASTERIZER span (to render with BDPT/VCM) and the
# MEDIUM span (with nested constant-index boxes, and with a uniform control).
# BEGIN RASTERIZER
standard_shader
{
	name global
	shaderop DefaultPathTracing
}

pathtracing_pel_rasterizer
{
	samples 64
	oidn_denoise FALSE
	pixel_filter box
}
# END RASTERIZER

film
{
	width 32
	height 32
}

orthographic_camera
{
	location 0 0 4
	lookat 0 0 0
	up 0 1 0
	viewport_scale 0.2 0.2
}

# BEGIN MEDIUM
scalar_painter
{
	name ior_tent
	expression 1.8-0.6*abs(P.z-1.0)
}

dielectric_material
{
	name mat_graded
	ior ior_tent
	tau 1.0
	scattering 1000000
}

box_geometry
{
	name geo_graded
	width 60
	height 60
	depth 2
}

standard_object
{
	name graded
	geometry geo_graded
	material mat_graded
	position 0 0 1
}
# END MEDIUM

uniformcolor_painter
{
	name pnt_floor
	color 0.5 0.5 0.5
}

lambertian_material
{
	name mat_floor
	reflectance pnt_floor
}

clippedplane_geometry
{
	name geo_floor
	pta -28 -28 0.02
	ptb 28 -28 0.02
	ptc 28 28 0.02
	ptd -28 28 0.02
	doublesided FALSE
}

standard_object
{
	name floor
	geometry geo_floor
	material mat_floor
}

uniformcolor_painter
{
	name pnt_emit
	color 1.0 1.0 1.0
}

lambertian_luminaire_material
{
	name mat_emit
	exitance pnt_emit
	scale 1.0
	material none
}

clippedplane_geometry
{
	name geo_emit
	pta -28 -28 1.0
	ptb -28 28 1.0
	ptc 28 28 1.0
	ptd 28 -28 1.0
	doublesided FALSE
}

standard_object
{
	name emitter
	geometry geo_emit
	material mat_emit
}
