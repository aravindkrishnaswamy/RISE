RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           displaced_plus_relief_shared_field.RISEscene                                            #
#   Description:    ONE scalar field driving BOTH coarse displacement and fine relief.                      #
#   Author:         RISE contributors                                                                       #
#   Birthdate:      2026-09-06                                                                              #
#                                                                                                           #
#   WHAT THIS SCENE PROVES                                                                                  #
#                                                                                                           #
#   docs/RELIEF_MODIFIER_DESIGN.md section 5.3 recommends splitting surface                                 #
#   detail in two: coarse, silhouette-changing shape goes to                                                #
#   `displaced_geometry`; fine, sub-silhouette relief goes to                                               #
#   `relief_modifier` on the displaced object.  Until 2026-09-06 the two                                    #
#   could share ONE authored field only when that field was a function of                                   #
#   (u, v), because `displaced_geometry.displacement` sampled an                                            #
#   IFunction2D while `relief_modifier.height` took an IScalarPainter -- a                                  #
#   3D painter bound to `displacement` went through Painter::Evaluate's                                     #
#   fake hit and came back a CONSTANT.                                                                      #
#                                                                                                           #
#   `displaced_geometry.height` closes that: the SINGLE `shared_field`                                      #
#   chunk below is bound to BOTH slots.  What you should see:                                               #
#                                                                                                           #
#     * a COARSE, silhouette-changing lumpiness -- the low-frequency term                                   #
#       of the field, at `disp_scale 0.16`, moving actual vertices; and                                     #
#     * a FINE relief within each lump -- the high-frequency term of the                                    #
#       SAME field, tilting shading normals at `scale 0.03`, well below                                     #
#       the tessellation the displacement could ever resolve.                                               #
#                                                                                                           #
#   The two READ AS ONE MATERIAL because they are one field: the fine                                       #
#   grain follows the coarse lumps instead of floating over them, which is                                  #
#   the whole point of sharing.                                                                             #
#                                                                                                           #
#   The field is written against `Po` (OBJECT space) deliberately.  A                                       #
#   `displaced_geometry` is baked BEFORE it is bound to an object, so it                                    #
#   does not know its own transform: `P` and `Po` COINCIDE at bake time and                                 #
#   a `P`-authored field would not follow the object's placement, silently                                  #
#   disagreeing with the relief modifier (which runs at HIT time, where `P`                                 #
#   is genuinely world space).  `Po` means the same thing to both.                                          #
#                                                                                                           #
#   LIGHTING: one raking directional key plus a small ambient fill -- the                                   #
#   same choice, for the same reason, as relief_sphere_no_uv.RISEscene: a                                   #
#   dome would average the normal tilt away and the fine half of the                                        #
#   picture would prove nothing.  Per SCENE_CONVENTIONS, `direction` is the                                 #
#   vector FROM the surface TO the light, so the +Z component lights the                                    #
#   face the camera at +Z sees.                                                                             #
#                                                                                                           #
#############################################################################################################

##################################################
# Renderer
##################################################

standard_shader
{
	name			global
	shaderop		DefaultDirectLighting
}

pathtracing_pel_rasterizer
{
	samples				16
	oidn_denoise		FALSE
}

file_rasterizeroutput
{
	pattern			rendered/displaced_plus_relief_shared_field
	type			PNG
	bpp				8
	color_space		sRGB
}

##################################################
# Camera
##################################################

film
{
	width			256
	height			256
}

pinhole_camera
{
	location		0 0 4
	lookat			0 0 0
	up				0 1 0
	fov				30.0
}

##################################################
# THE shared field -- one chunk, two consumers
##################################################

scalar_painter
{
	name			shared_field
	expression		fbm(Po*3.0, 2, 0.5, 2.0) + 0.35*fbm(Po*26.0, 4, 0.5, 2.0)
}

relief_modifier
{
	name			shared_relief
	height			shared_field
	scale			0.03
	domain			surface
	step			0.004
}

##################################################
# Subject: the field displaces the geometry...
##################################################

sphere_geometry
{
	name			ball_base
	radius			1.0
}

displaced_geometry
{
	name			ball_geom
	base_geometry	ball_base
	detail			96
	height			shared_field
	disp_scale		0.16
}

uniformcolor_painter
{
	name			clay
	color			0.68 0.60 0.50
}

lambertian_material
{
	name			mat_clay
	reflectance		clay
}

##################################################
# ...and the SAME field reliefs the object built from it
##################################################

standard_object
{
	name			ball
	geometry		ball_geom
	material		mat_clay
	modifier		shared_relief
	position		0 0 0
	orientation		0 0 0
}

##################################################
# Lighting -- one raking key + a small fill
##################################################

directional_light
{
	name		key
	power		2.2
	color		1.0 1.0 1.0
	colorspace	Rec709RGB_Linear
	direction	0.75 0.55 0.60
}

ambient_light
{
	name		fill
	color		1.0 1.0 1.0
	colorspace	Rec709RGB_Linear
	power		0.25
}
