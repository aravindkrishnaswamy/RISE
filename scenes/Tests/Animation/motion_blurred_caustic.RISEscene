RISE ASCII SCENE 7
# Taxonomy: focused animation/caustic regression.
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           motion_blurred_caustic.RISEscene                                                        #
#   Description:    Tests animations with caustics                                                          #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      May 27, 2004                                                                            #
#                                                                                                           #
#############################################################################################################

##################################################
# Setup a renderer
##################################################

standard_shader
{
	name		global
#	shaderop	DefaultDirectLighting
	shaderop		DefaultPathTracing
}

# Migrated from pixelpel_rasterizer by tools/migrate_scenes_legacy_rasterizer.py (--mode full --integrator vcm, legacy-deprecation Phase 2).
vcm_pel_rasterizer
{
	samples				144
	show_luminaires		FALSE
}

file_rasterizeroutput
{
	pattern				rendered/motion_blurred_caustic
	type				PNG
	bpp					8
	color_space			sRGB
	multiple			TRUE
}

##################################################
# Cameras
##################################################

film
{
	width			512
	height			512
}

pinhole_camera
{
	location			0 0 0.5
	lookat				0 0 0
	up					0 1 0
	fov					30.0
	exposure			0.5
}

##################################################
# Painters
##################################################

#############################################################################################################
#									RISE Ascii Scene File													#
#																											#
#	File: 			colors.scn																				#
#   Description:	Contains commonly used colors from all scenes											#
#	Author: 		Aravind Krishnaswamy																	#
#	Birthdate:		November 14, 2003																		#
#																											#
#############################################################################################################
#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           standard_colors.RISEscene                                                               #
#   Description:    Contains some standard colors                                                           #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################


uniformcolor_painter
{
	name		color_white
	color		1.0 1.0 1.0
}













#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           povray_colors.RISEscene                                                                 #
#   Description:    Contains colors taken from POV-Ray                                                      #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################
















uniformcolor_painter
{
	name		color_gold
	color		0.8 0.498039 0.196078 
}






	
	

	




































































##################################################
# Materials
##################################################

lambertian_material
{
	name				white
	reflectance			color_white
}

perfectrefractor_material
{
	name				glass
	refractance			color_gold
	ior					1.45
}

lambertian_luminaire_material
{
	name				white_lum
	exitance			color_white
	scale				30.0
	material			none
}

##################################################
# Objects
##################################################

sphere_geometry
{
	name			spheregeom
	radius			0.05
}

standard_object
{
	name				sphere
	geometry			spheregeom
	position			-0.1 0 0.0
	material			glass
}

infiniteplane_geometry
{
	name				planegeom
	xtile				1.0
	ytile				1.0
}

standard_object
{
	name				plane
	geometry			planegeom
	position			0 -0.1 0
	orientation			-90 0 0
	material			white
}

clippedplane_geometry
{
	name				lightgeom2
	pta					-0.1 0.1 0.0
	ptb					-0.1 -0.1 0.0
	ptc					0.1 -0.1 0.0
	ptd					0.1 0.1 0.0
}

standard_object
{
	name				light2
	geometry			lightgeom2
	position			0 0.5 0.0
	orientation			90 0 0
	material			white_lum
}

##################################################
# Keyframes
##################################################

timeline
{
	element		sphere
	param		position
	
	time		0.0
	value		-0.1 0 0.0
	
	time		1.0
	value		0.1 0 0.0
}


