RISE ASCII SCENE 7
# Chromaticity preservation test: 3 saturated lambertian spheres (R/G/B)
# under flat ambient illumination.  Each sphere should render as
# predominantly its respective channel after spectral integration +
# XYZ -> RGB conversion.

pathtracing_shaderop
{
	name		pathtracer
}

standard_shader
{
	name		global
	shaderop	pathtracer
}

# Legacy phase 2 slice B2: the former ambient_light, as a uniform environment (radiance_map
# below).  radiance = ambient color x power / pi: the uniform radiance that lights an
# unoccluded Lambertian surface as the ambient light did.  The environment is occluded,
# so creases and interiors get darker (owner ruling #5).
uniformcolor_painter
{
	name				pnt_ambient_env
	color				1 1 1
	colorspace			Rec709RGB_Linear
}

# Migrated from pixelintegratingspectral_rasterizer by tools/migrate_scenes_legacy_rasterizer.py (--mode pt, legacy-deprecation Phase 2).
pathtracing_spectral_rasterizer
{
	samples				256
	nmbegin				380
	nmend				780
	num_wavelengths		32
	hwss				false
	radiance_map			pnt_ambient_env
	radiance_scale			0.31831
	radiance_background		FALSE
}

file_rasterizeroutput
{
	pattern				rendered/chromaticity_test_spectral
	type				PNG
	bpp					8
	color_space			sRGB
}

film
{
	width			300
	height			100
}

pinhole_camera
{
	location			0 0 6
	lookat				0 0 0
	up					0 1 0
	fov					40.0
}

uniformcolor_painter
{
	name		pnt_red
	color		0.8 0.0 0.0
	colorspace	Rec709RGB_Linear
}

uniformcolor_painter
{
	name		pnt_green
	color		0.0 0.8 0.0
	colorspace	Rec709RGB_Linear
}

uniformcolor_painter
{
	name		pnt_blue
	color		0.0 0.0 0.8
	colorspace	Rec709RGB_Linear
}

lambertian_material
{
	name		mat_red
	reflectance	pnt_red
}

lambertian_material
{
	name		mat_green
	reflectance	pnt_green
}

lambertian_material
{
	name		mat_blue
	reflectance	pnt_blue
}

sphere_geometry
{
	name		sph
	radius		0.7
}

standard_object
{
	name		sph_red
	geometry	sph
	material	mat_red
	position	-1.6 0 0
}

standard_object
{
	name		sph_green
	geometry	sph
	material	mat_green
	position	0 0 0
}

standard_object
{
	name		sph_blue
	geometry	sph
	material	mat_blue
	position	1.6 0 0
}
