RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           hair_melanin_ladder.RISEscene                                                          #
#   Description:    Three side-by-side grooms sharing one groom recipe but differing ONLY in the Tier-1    #
#                    `eumelanin` concentration (0.3 / 1.3 / 4.0 -- blond-ish through black, the same       #
#                    ladder HairBSDFTest's unit-level melanin check exercises).  Neutral, spatially         #
#                    UNIFORM lighting (the same L=1.0 env as hair_furnace.RISEscene) so the only thing      #
#                    that can move the three spheres' brightness is eumelanin's effect on sigma_a(lambda)   #
#                    via the OMLC extinction curves (BioSpecSkinData) -- higher eumelanin absorbs more, so  #
#                    mean luminance must decrease strictly left to right.  HairRenderTest.cpp's "Melanin    #
#                    ladder" assertion renders the equivalent recipe in-process and checks that strict      #
#                    monotonic decrease numerically; this scene is the render/parse/CST-golden-covered      #
#                    companion.                                                                             #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      August 27, 2026                                                                         #
#                                                                                                           #
#############################################################################################################

standard_shader
{
	name			global
	shaderop		DefaultDirectLighting
}

film
{
	width			192
	height			64
}

pinhole_camera
{
	location		0 0 5.4
	lookat			0 0 0
	up			0 1 0
	fov			32.0
}

##################################################
# Env: uniform L=1.0 -- declared before the rasterizer that binds it.
##################################################
uniformcolor_painter
{
	name			pnt_env
	color			1.0 1.0 1.0
}

pathtracing_pel_rasterizer
{
	samples			64
	radiance_map		pnt_env
	radiance_scale		1.0
	radiance_background	TRUE
	rr_min_depth		12
}

file_rasterizeroutput
{
	pattern			rendered/hair_melanin_ladder
	type			PNG
	bpp			8
	color_space		sRGB
}

sphere_geometry
{
	name			scalp
	radius			1.0
}

##################################################
# Rung 1: eumelanin 0.3 -- lightest (blond-ish).
##################################################
scalar_painter
{
	name			pnt_eumel_lo
	value			0.3
}

hair_material
{
	name			mat_hair_lo
	eumelanin		pnt_eumel_lo
}

hair_geometry
{
	name			groom_lo
	base_geometry		scalp
	count			2000
	segments		6
	length			0.22
	width_root		0.03
	width_tip		0.01
	base_detail		20
	seed			7
}

standard_object
{
	name			obj_lo
	geometry		groom_lo
	material		mat_hair_lo
	position		-2.6 0 0
}

##################################################
# Rung 2: eumelanin 1.3 -- brown-black (the descriptor's reference
# midpoint value).
##################################################
scalar_painter
{
	name			pnt_eumel_mid
	value			1.3
}

hair_material
{
	name			mat_hair_mid
	eumelanin		pnt_eumel_mid
}

hair_geometry
{
	name			groom_mid
	base_geometry		scalp
	count			2000
	segments		6
	length			0.22
	width_root		0.03
	width_tip		0.01
	base_detail		20
	seed			7
}

standard_object
{
	name			obj_mid
	geometry		groom_mid
	material		mat_hair_mid
	position		0 0 0
}

##################################################
# Rung 3: eumelanin 4.0 -- darkest (near-black).
##################################################
scalar_painter
{
	name			pnt_eumel_hi
	value			4.0
}

hair_material
{
	name			mat_hair_hi
	eumelanin		pnt_eumel_hi
}

hair_geometry
{
	name			groom_hi
	base_geometry		scalp
	count			2000
	segments		6
	length			0.22
	width_root		0.03
	width_tip		0.01
	base_detail		20
	seed			7
}

standard_object
{
	name			obj_hi
	geometry		groom_hi
	material		mat_hair_hi
	position		2.6 0 0
}
