RISE ASCII SCENE 7
# Taxonomy: tessellated reference for the analytic Bezier geometry path.
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           aphrodite_mesh.RISEscene                                                                #
#   Description:    Aphrodite rendered via a high-detail tessellated mesh.  Identical scene to             #
#                   aphrodite.RISEscene except the bezier patches are wrapped in a displaced_geometry     #
#                   with displacement=none and disp_scale=0 — giving a pure triangle-mesh render that      #
#                   is the ground-truth reference for the analytic path.                                   #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      May 20, 2004                                                                            #
#                                                                                                           #
#############################################################################################################

##################################################
# Setup a renderer
##################################################

standard_shader
{
	name				global
	shaderop			DefaultPathTracing
}

# Migrated from pixelpel_rasterizer by tools/migrate_scenes_legacy_rasterizer.py (--mode direct, legacy-deprecation Phase 2).
pathtracing_pel_rasterizer
{
	samples				4

	max_diffuse_bounce		0
}

file_rasterizeroutput
{
	pattern				rendered/aphrodite_mesh
	type				PNG
	bpp					8
	color_space			sRGB
}

##################################################
# Cameras
##################################################

film
{
	width			500
	height			700
}

pinhole_camera
{
	location			0 0 16.5
	lookat				0 0 0
	up					0 1 0
	fov					39.0
}

##################################################
# Painters
##################################################

#############################################################################################################
#									RISE Ascii Scene File													#
#																											#
#	File: 			colors.scn																				#
#   Description:	Contains commonly used colors from all scenes											#
#	Author: 		Aravind Krishnaswamy																	#
#	Birthdate:		November 14, 2003																		#
#																											#
#############################################################################################################
#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           standard_colors.RISEscene                                                               #
#   Description:    Contains some standard colors                                                           #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################


uniformcolor_painter
{
	name		color_white
	color		1.0 1.0 1.0
}













#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           povray_colors.RISEscene                                                                 #
#   Description:    Contains colors taken from POV-Ray                                                      #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################






















	
	

	






















uniformcolor_painter
{
	name		color_slateblue
	color		0.0 0.498039 1.0 
}






















uniformcolor_painter
{
	name		color_darkpurple
	color		0.53 0.12 0.47 
}
























# Legacy phase 2 slice B2: was iridescent_painter (colora `color_darkpurple`, colorb `color_slateblue`, bias -0.5); now its
# projected-area mean colour (1-w) colora + w colorb, w = 0.2083; the view-dependent
# colour shift moved to the thin-film ggx_material(s) that bind it.
uniformcolor_painter
{
	name				pnt_iri
	color				0.41958 0.19876 0.58042
	colorspace			Rec709RGB_Linear
}

##################################################
# Materials
##################################################

# Legacy phase 2 slice B2: white F0 tint for the thin-film materials.
uniformcolor_painter
{
	name				pnt_tf_white
	color				1 1 1
	colorspace			Rec709RGB_Linear
}

scalar_painter
{
	name				tf_Ti_n
	file				colors/thinfilm/substrates/Ti.n
}

scalar_painter
{
	name				tf_Ti_k
	file				colors/thinfilm/substrates/Ti.k
}

scalar_painter
{
	name				tf_TiO2_n
	file				colors/thinfilm/oxides/TiO2.n
}

scalar_painter
{
	name				tf_TiO2_k
	file				colors/thinfilm/oxides/TiO2.k
}

# Legacy phase 2 slice B2: was perfectreflector_material; perfectreflector with iridescent `pnt_iri` -> near-mirror (alpha 0.01) TiO2 film 150 nm over titanium, thickness matching colorb's hue.
ggx_material
{
	name				perf_ref
	rd					none
	rs					pnt_tf_white
	alphax				0.01
	alphay				0.01
	fresnel_mode		thinfilm
	ior					tf_Ti_n
	extinction			tf_Ti_k
	film_ior			tf_TiO2_n
	film_extinction		tf_TiO2_k
	film_thickness		150
}

lambertian_material
{
	name				white
	reflectance			color_white
}

##################################################
# Objects
##################################################
#
# High-detail tessellated-mesh variant: the bezier patches are the base
# geometry, wrapped by displaced_geometry (displacement=none, disp_scale=0)
# which tessellates the patches up-front into triangles and ray-traces the
# triangle mesh.  detail=20 gives (20+1)^2 = 441 triangles per patch — well
# above the point where the curved silhouette becomes smooth.  double_sided
# is on to match aphrodite.bezier's patch-winding convention.
#
bezierpatch_geometry
{
	name				bezgeom_base
	file				models/bezier/aphrodite.bezier
	maxpatches			10
	maxdepth			24
	bsp					TRUE
}

displaced_geometry
{
	name				bezgeom
	base_geometry		bezgeom_base
	detail				32	
	displacement		none
	disp_scale			0.0
	maxpolygons			10
	maxdepth			24
	double_sided		TRUE
	bsp					TRUE
}

standard_object
{
	name				bez
	geometry			bezgeom
	position			0 -1.0 0
	orientation			0 180 0
	material			white
#	casts_shadows		FALSE
#	receives_shadows	FALSE
}

directional_light
{
	name		light
	power		3.0
	color		1.0 1.0 1.0
	direction	0 0 1
}

