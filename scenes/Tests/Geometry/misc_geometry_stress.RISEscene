}

#############################################################################
# SPECIMEN 1 -- THE CARTESIAN UV.  A checker in UV must land as a true square
# grid in world space, identical at centre and rim.
#############################################################################
cartesian_disk_geometry
{
	name				chkdisk
	radius				2.20
	mesh_n				420
}

standard_object
{
	name				checkerdisk
	geometry			chkdisk
	material			mat_checker
	position			-7.0 2.60 -5
}

#############################################################################
# SPECIMEN 2 + 3 -- THE DOCUMENTED USE: an arbitrary 2D field displaced onto
# the flat Cartesian base, at two very different mesh_n on the SAME field.
#
# The field is a concentric-ring term times a square-grid term: the rings
# expose radial UV distortion, the grid exposes non-uniform cell density.
#############################################################################
expression_function2d
{
	name				diskfn
	param				R 2.20
	param				rings 5
	param				cells 4
	def					x (2*u-1)*R
	def					y (2*v-1)*R
	def					r hypot(x,y)
	def					ring 0.5+0.5*cos(tau*rings*r/R)
	def					gx 0.5+0.5*cos(tau*cells*x/(2*R))
	def					gy 0.5+0.5*cos(tau*cells*y/(2*R))
	expr				clamp(0.40*ring+0.60*gx*gy,0,1)
}

cartesian_disk_geometry
{
	name				finedisk
	radius				2.20
	mesh_n				300
}

cartesian_disk_geometry
{
	name				coarsedisk
	radius				2.20
	mesh_n				44
}

displaced_geometry
{
	name				finerelief
	base_geometry		finedisk
	displacement		diskfn
	disp_scale			0.30
	uv_seam_fold		FALSE
	face_normals		TRUE
}

displaced_geometry
{
	name				coarserelief
	base_geometry		coarsedisk
	displacement		diskfn
	disp_scale			0.30
	uv_seam_fold		FALSE
	face_normals		TRUE
}

standard_object
{
	name				finedial
	geometry			finerelief
	material			mat_brass
	position			-1.0 2.60 -5
}

standard_object
{
	name				coarsedial
	geometry			coarserelief
	material			mat_copper
	position			5.4 2.60 -5
}

#############################################################################
# SPECIMEN 4 -- `path_instances_geometry` with a NON-TRIVIAL TEMPLATE.
#
# The template is a lathe-turned finial (bead, cove, bead), consumed through
# TessellateToMesh, stamped at ARC-LENGTH pitch along a genuinely 3D path.
#############################################################################
lathe_geometry
{
	name				beadgeom
	profile_point		0.00 0.00
	profile_point		0.15 0.05
	profile_point		0.30 0.22
	profile_point		0.21 0.42
	profile_point		0.34 0.60
	profile_point		0.17 0.80
	profile_point		0.00 0.90
	n_radial			28
}

path_instances_geometry
{
	name				beadchain_up
	geometry			beadgeom
	point				-4.0 0.10 -1.2
	point				-2.0 1.25 0.9
	point				0.3 0.15 -0.9
	point				2.2 1.35 1.0
	point				4.0 0.30 -0.7
	pitch				2.60
	scale				2.00
	n_len				400
	detail				24
}

standard_object
{
	name				beads_upright
	geometry			beadchain_up
	material			mat_jade
	position			-5.0 0.95 5
}

#############################################################################
# SPECIMEN 5 -- the SAME template on a MIRRORED copy of the same path, with
# `slant 55` (rotation about the frame normal) and `scale 0.62`.
#############################################################################
path_instances_geometry
{
	name				beadchain_slant
	geometry			beadgeom
	point				-4.0 0.10 -1.2
	point				-2.0 1.25 0.9
	point				0.3 0.15 -0.9
	point				2.2 1.35 1.0
	point				4.0 0.30 -0.7
	pitch				2.60
	n_len				400
	detail				24
	slant				55
	scale				1.30
}

standard_object
{
	name				beads_slanted
	geometry			beadchain_slant
	material			mat_plum
	position			5.0 0.95 5
}

##################################################
# Ground + lights
##################################################
infiniteplane_geometry
{
	name				floorgeom
	xtile				4.0
	ytile				4.0
}

standard_object
{
	name				floor
	geometry			floorgeom
	material			mat_floor
	orientation			-90 0 0
	position			0 0 0
}

omni_light
{
	name				keylight
	power				2000
	color				1.0 0.98 0.94
	colorspace			sRGB
	position			-10 16 14
}

omni_light
{
	name				filllight
	power				900
	color				0.90 0.94 1.0
	colorspace			sRGB
	position			12 10 12
}

omni_light
{
	name				rimlight
	power				600
	color				1.0 1.0 1.0
	position			0 12 -16
}
