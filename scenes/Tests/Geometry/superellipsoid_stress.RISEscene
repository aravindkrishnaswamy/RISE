lambertian_material
{
	name				mat_clay
	reflectance			pnt_clay
}

lambertian_material
{
	name				mat_gold
	reflectance			pnt_gold
}

lambertian_material
{
	name				mat_jade
	reflectance			pnt_jade
}

lambertian_material
{
	name				mat_amber
	reflectance			pnt_amber
}

lambertian_material
{
	name				mat_magenta
	reflectance			pnt_magenta
}

lambertian_material
{
	name				mat_teal
	reflectance			pnt_teal
}

lambertian_material
{
	name				mat_steel
	reflectance			pnt_steel
}

lambertian_material
{
	name				mat_floor
	reflectance			pnt_floor
