#############################################################################
# SPECIMEN 1 -- INTERIOR POLE.  THE MONEY CASE.
#
# A symmetric peanut: r runs 0 -> 0.92 -> 0 -> 0.92 -> 0.  The middle point
# (0.00, 1.62) is an INTERIOR pole -- it sits ON the axis with a LIVE band on
# BOTH sides.  Those two bands demand opposite axial normal signs, and a pole
# vertex's normal is forced to +-axis, so ONE shared vertex cannot serve both
# fans.  The factory splits it into two rows, one per band.
#
# The two END points are ALSO poles, but ordinary ones (a live band on one
# side only).  Having all three in one specimen is deliberate: only the
# middle one may split.
#############################################################################
lathe_geometry
{
	name				pinchgeom
	profile_point		0.00 0.00
	profile_point		0.44 0.12
	profile_point		0.72 0.34
	profile_point		0.92 0.68
	profile_point		0.80 1.02
	profile_point		0.54 1.30
	profile_point		0.26 1.50
	profile_point		0.00 1.62
	profile_point		0.26 1.74
	profile_point		0.54 1.94
	profile_point		0.80 2.22
	profile_point		0.92 2.56
	profile_point		0.72 2.90
	profile_point		0.44 3.12
	profile_point		0.00 3.24
	n_radial			72
	smooth				TRUE
}

standard_object
{
	name				pinch
	geometry			pinchgeom
	material			mat_magenta
	position			0.6 0 5
}

#############################################################################
# SPECIMEN 2 -- POLE AT START ONLY.  Closed dome at the bottom, open rim at
# the top.  The mesh is double-sided, so the inside of the wall is visible
# and shaded through the mouth.
#############################################################################
lathe_geometry
{
	name				cupgeom
	profile_point		0.00 0.00
	profile_point		0.28 0.06
	profile_point		0.50 0.22
	profile_point		0.68 0.52
	profile_point		0.80 0.94
	profile_point		0.86 1.40
	profile_point		0.83 1.82
	profile_point		0.78 2.20
	profile_point		0.84 2.48
	profile_point		0.92 2.70
	n_radial			64
}

standard_object
{
	name				cup
	geometry			cupgeom
	material			mat_jade
	position			-8.6 0 5
}

#############################################################################
# SPECIMEN 3 -- POLE AT BOTH ENDS.  A closed, watertight vessel: no caps,
# no zero-area triangles, no seam.
#############################################################################
lathe_geometry
{
	name				egggeom
	profile_point		0.00 0.00
	profile_point		0.30 0.10
	profile_point		0.52 0.34
	profile_point		0.70 0.72
	profile_point		0.80 1.14
	profile_point		0.86 1.70
	profile_point		0.82 2.10
	profile_point		0.68 2.44
	profile_point		0.44 2.70
	profile_point		0.00 2.86
	n_radial			64
}

standard_object
{
	name				egg
	geometry			egggeom
	material			mat_plum
	position			-5.0 0 -5
}

#############################################################################
# SPECIMEN 4 -- HARD EDGES via DUPLICATED profile points.  Three duplicated
# points give three crisp creases; the curvature between them stays smooth.
#############################################################################
lathe_geometry
{
	name				spoolgeom
	profile_point		0.00 0.00
	profile_point		0.88 0.00
	profile_point		0.88 0.00
	profile_point		0.88 0.34
	profile_point		0.88 0.34
	profile_point		0.62 0.62
	profile_point		0.44 1.10
	profile_point		0.42 1.70
	profile_point		0.56 2.14
	profile_point		0.56 2.14
	profile_point		0.96 2.30
	profile_point		0.96 2.62
	profile_point		0.00 2.62
	n_radial			64
	smooth				TRUE
}

standard_object
{
	name				spool
	geometry			spoolgeom
	material			mat_slate
	position			-2.0 0 -5
}

#############################################################################
# SPECIMEN 5 -- `smooth TRUE` (left) vs `smooth FALSE` (right).  Identical
# profile, identical n_radial 12.  Left averages adjacent segment normals per
# profile point; right emits two rows per segment carrying that segment's own
# flat normal.
#############################################################################
lathe_geometry
{
	name				smoothgeom
	profile_point		0.00 0.00
	profile_point		0.52 0.22
	profile_point		0.80 0.80
	profile_point		0.88 1.50
	profile_point		0.66 2.20
	profile_point		0.00 2.60
	n_radial			12
	smooth				TRUE
}

lathe_geometry
{
	name				flatgeom
	profile_point		0.00 0.00
	profile_point		0.52 0.22
	profile_point		0.80 0.80
	profile_point		0.88 1.50
	profile_point		0.66 2.20
	profile_point		0.00 2.60
	n_radial			12
	smooth				FALSE
}

standard_object
{
	name				smoothed
	geometry			smoothgeom
	material			mat_amber
	position			-5.4 0 5
}

standard_object
{
	name				faceted
	geometry			flatgeom
	material			mat_amber
	position			-2.8 0 5
}

#############################################################################
# SPECIMEN 6 -- TUBE / SHELL with LEVEL off-axis ends, partial sweep.
#
# The profile runs UP the outer wall, ACROSS the rim, and back DOWN the inner
# wall, ending at the same height it started (h = 0 and r > 0 at both ends).
# That is the `endsLevel` branch of the cap rule: the cross-section is closed
# DIRECTLY rather than through the axis, because the through-axis spur would
# have zero area and ear-clip into zero-area triangles.
#
# `orientation 0 55 0` turns the missing 160-degree wedge toward the camera.
#############################################################################
lathe_geometry
{
	name				tubegeom
	profile_point		1.00 0.00
	profile_point		1.00 1.20
	profile_point		1.00 2.40
	profile_point		0.72 2.40
	profile_point		0.72 1.20
	profile_point		0.72 0.00
	sweep_degrees		200
	n_radial			48
}

standard_object
{
	name				tube
	geometry			tubegeom
	material			mat_teal
	position			4.2 0 5
	orientation			0 55 0
}

#############################################################################
# SPECIMEN 7 -- PARTIAL SWEEP, 140 degrees, SOLID silhouette.  The profile
# starts and ends ON the axis, so the cut cross-section is already a closed
# polygon and both cut half-planes get a flat ear-clipped cap.
#############################################################################
lathe_geometry
{
	name				cutawaygeom
	profile_point		0.00 0.00
	profile_point		0.94 0.18
	profile_point		1.14 1.05
	profile_point		0.56 2.10
	profile_point		0.68 2.60
	profile_point		0.00 2.78
	sweep_degrees		140
	n_radial			40
}

standard_object
{
	name				cutaway
	geometry			cutawaygeom
	material			mat_clay
	position			1.2 0 -5
	orientation			0 110 0
}

#############################################################################
# SPECIMEN 8 -- REVERSED vs FORWARD profile, same material.
#
# `fwdgeom` is authored bottom-to-top; `revgeom` is the identical point list
# written backwards.  Outward orientation is derived from the signed volume of
# revolution, so both must face outward.  CORRECT: indistinguishable.
#############################################################################
lathe_geometry
{
	name				fwdgeom
	profile_point		0.00 0.00
	profile_point		0.64 0.10
	profile_point		0.92 0.72
	profile_point		0.34 1.58
	profile_point		0.54 2.24
	profile_point		0.00 2.46
	n_radial			56
}

lathe_geometry
{
	name				revgeom
	profile_point		0.00 2.46
	profile_point		0.54 2.24
	profile_point		0.34 1.58
	profile_point		0.92 0.72
	profile_point		0.64 0.10
	profile_point		0.00 0.00
	n_radial			56
}

standard_object
{
	name				fwd
	geometry			fwdgeom
	material			mat_gold
	position			4.4 0 -5
}

standard_object
{
	name				rev
	geometry			revgeom
	material			mat_gold
	position			7.2 0 -5
}

#############################################################################
# SPECIMEN 9 -- `axis x`.  A horn revolved about world X: mouth at the local
# h = 0 end (world -X), closed tip at h = 2.60 (world +X), circular in Y/Z.
#############################################################################
lathe_geometry
{
	name				trumpet_x
	profile_point		1.20 0.00
	profile_point		0.72 0.55
	profile_point		0.46 1.15
	profile_point		0.34 1.90
	profile_point		0.30 2.60
	profile_point		0.00 2.60
	axis				x
	n_radial			56
}

standard_object
{
	name				horiz_x
	geometry			trumpet_x
	material			mat_copper
	position			-10.2 1.5 -5
}

#############################################################################
# SPECIMEN 10 -- `axis z`.  A STEPPED ZIGGURAT about world Z: h runs along +Z,
# so the widest step sits farthest from the camera and the apex points at it.
# Head-on that is an unambiguous signature -- CONCENTRIC RINGS in the X/Y
# plane with a shaded annular tread between each pair.  Every step boundary is
# a duplicated profile point, so each ring edge is a hard crease.
#############################################################################
lathe_geometry
{
	name				zigg_z
	profile_point		0.00 0.00
	profile_point		1.20 0.00
	profile_point		1.20 0.00
	profile_point		1.20 0.44
	profile_point		1.20 0.44
	profile_point		0.92 0.44
	profile_point		0.92 0.44
	profile_point		0.92 0.88
	profile_point		0.92 0.88
	profile_point		0.64 0.88
	profile_point		0.64 0.88
	profile_point		0.64 1.32
	profile_point		0.64 1.32
	profile_point		0.36 1.32
	profile_point		0.36 1.32
	profile_point		0.36 1.76
	profile_point		0.36 1.76
	profile_point		0.00 1.76
	axis				z
	n_radial			56
}

standard_object
{
	name				horiz_z
	geometry			zigg_z
	material			mat_steel
	position			7.8 1.5 3.4
}

