RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           group_basic.RISEscene                                                                  #
#   Description:    `group` (docs/agentic-redesign/86-object-grouping.md Slice 1): a small three-object     #
#                    "cart" assembly (a box body + two sphere wheels) authored at LOCAL coordinates around   #
#                    the assembly's own origin, then placed as one unit by a single `group` chunk (position  #
#                    + orientation + scale).  Every member's own transform composes normally; the group's    #
#                    transform lands OUTSIDE it.  A second, unrelated standalone sphere sits beside the cart #
#                    for visual contrast (not a group member).                                               #
#   Author:         Aravind Krishnaswamy                                                                    #
#                                                                                                           #
#############################################################################################################

standard_shader
{
	name			global
	shaderop		DefaultDirectLighting
}

pixelpel_rasterizer
{
	max_recursion		10
	samples				4
	lum_samples			1
}

file_rasterizeroutput
{
	pattern				rendered/group_basic
	type				PNG
	bpp					8
	color_space			sRGB
}

film
{
	width			512
	height			512
}

pinhole_camera
{
	location			2.5 3.0 11
	lookat				1.0 0.2 0
	up					0 1 0
	fov					40.0
}

##################################################
# Painters + materials
##################################################

uniformcolor_painter
{
	name				pnt_body
	color				0.75 0.2 0.15
}

lambertian_material
{
	name				mat_body
	reflectance			pnt_body
}

uniformcolor_painter
{
	name				pnt_wheel
	color				0.12 0.12 0.12
}

lambertian_material
{
	name				mat_wheel
	reflectance			pnt_wheel
}

uniformcolor_painter
{
	name				pnt_bystander
	color				0.2 0.45 0.75
}

lambertian_material
{
	name				mat_bystander
	reflectance			pnt_bystander
}

##################################################
# The cart's members -- authored at LOCAL coordinates around the
# assembly's own origin.  Every member must be declared BEFORE the
# `group` chunk that places it (chunk order matters -- see the `group`
# descriptor).
##################################################

box_geometry
{
	name				box_geo
	width				1.6
	height				0.6
	depth				0.8
}

standard_object
{
	name				cart_body
	geometry			box_geo
	material			mat_body
	position			0 0.4 0
}

sphere_geometry
{
	name				wheel_geo
	radius				0.35
}

standard_object
{
	name				cart_wheel_l
	geometry			wheel_geo
	material			mat_wheel
	position			-0.7 0.30 0.5
}

standard_object
{
	name				cart_wheel_r
	geometry			wheel_geo
	material			mat_wheel
	position			-0.7 0.30 -0.5
}

##################################################
# Place the whole assembly with ONE chunk: the group's transform
# composes OUTSIDE each member's own local transform above (final =
# groupMatrix * memberMatrix), so the cart appears rotated 45 degrees
# and shifted to (2, 0, -1) as a single rigid unit.
##################################################

group
{
	name			cart
	member			cart_body
	member			cart_wheel_l
	member			cart_wheel_r
	position		2 0 -1
	orientation		0 45 0
	scale			1 1 1
}

##################################################
# An unrelated standalone object (NOT a group member) for visual contrast.
##################################################

sphere_geometry
{
	name				bystander_geo
	radius				0.6
}

standard_object
{
	name				bystander
	geometry			bystander_geo
	material			mat_bystander
	position			-2.2 0.6 0.5
}

##################################################
# Ground, for shadow/contact context
##################################################

uniformcolor_painter
{
	name				pnt_ground
	color				0.4 0.4 0.42
}

lambertian_material
{
	name				mat_ground
	reflectance			pnt_ground
}

clippedplane_geometry
{
	name				ground_geo
	pta					-14 0 -10
	ptb					 14 0 -10
	ptc					 14 0  10
	ptd					-14 0  10
}

standard_object
{
	name				ground
	geometry			ground_geo
	material			mat_ground
}

##################################################
# Lights
##################################################
omni_light
{
	name				keylight
	power				2400
	color				1.0 1.0 1.0
	position			-8 10 12
}

omni_light
{
	name				filllight
	power				900
	color				1.0 1.0 1.0
	position			10 6 8
}
