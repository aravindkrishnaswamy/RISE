RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           sss_ibl.RISEscene                                                                             #
#   Description:    Translucent teapot lit with HDR image based lighting                                    #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      February 23, 2005                                                                       #
#                                                                                                           #
#############################################################################################################

##################################################
# Setup a renderer
##################################################

hdr_painter
{
	name				pnt_rad
	file				lightprobes/rnl_probe.hdr
}

# We do the incident lighting calculation using ambient occlusion, which is smart enough
# to also figure out that there is a radiance map.  We use ambient occlusion because it has
# an optimized path in the rendering system
# Shader by which we compute incident illuminatin
# Note: You may have to increase the number of points to get adequate results
# Now setup the default 'global' shader for the object itself
standard_shader
{
	name		global
	shaderop		DefaultPathTracing
}

# Migrated from pixelpel_rasterizer by tools/migrate_scenes_legacy_rasterizer.py (--mode full --integrator pt, legacy-deprecation Phase 2).
pathtracing_pel_rasterizer
{
	samples				64
	radiance_map		pnt_rad
	radiance_background	TRUE
}

file_rasterizeroutput
{
	pattern				rendered/sss_ibl
	type				HDR
	bpp					8
}

##################################################
# Cameras
##################################################

film
{
	width			680
	height			480
}

pinhole_camera
{
	location			0 0 7.5
	lookat				0 0 0
	up					0 1 0
	fov					39.0
}

##################################################
# Painters
##################################################

#############################################################################################################
#									RISE Ascii Scene File													#
#																											#
#	File: 			colors.scn																				#
#   Description:	Contains commonly used colors from all scenes											#
#	Author: 		Aravind Krishnaswamy																	#
#	Birthdate:		November 14, 2003																		#
#																											#
#############################################################################################################
#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           standard_colors.RISEscene                                                               #
#   Description:    Contains some standard colors                                                           #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################


uniformcolor_painter
{
	name		color_white
	color		1.0 1.0 1.0
}













#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           povray_colors.RISEscene                                                                 #
#   Description:    Contains colors taken from POV-Ray                                                      #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################






















	
	

	




































































lambertian_material
{
	name				white
	reflectance			color_white
}

##################################################
# Materials
##################################################

##################################################
# Objects
##################################################

bezierpatch_geometry
{
	name				teapotgeom
	file				models/raw/teapot.bezier
	maxpatches			2
	maxdepth			7
	bsp					TRUE
	center_object		TRUE
}

# Converted from simple_sss_shaderop `sss` (point-cloud SSS, frozen) by tools/migrate_scenes_legacy_rasterizer.py --mode full:
#   Christensen-Burley match: albedo 0.95 0.444444 0.0493827 (material `white` x the op's 1/extinction^2 channel weights, clamped to [0.01, 0.95]), profile tail falloff = extinction x 1000 x geometric_scale 0.35 = 7 10.5 31.5 per unit.
subsurfacescattering_material
{
	name			sss_sss_white
	ior			1.3
	absorption	1.02066 9.22011 23.5005
	scattering	19.3925 7.37609 1.22081
	g			0
}

standard_object
{
	name				teapot
	geometry			teapotgeom
	orientation			20 -20 0
	material			sss_sss_white
	casts_shadows		FALSE
	receives_shadows	FALSE
	shader				global
}



