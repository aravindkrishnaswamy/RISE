RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           caustic_sss.RISEscene                                                                   #
#   Description:    Sub-surface scattering getting light from a caustic in a translucent box                #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      May 23, 2004                                                                            #
#                                                                                                           #
#############################################################################################################

##################################################
# Setup a renderer
##################################################

standard_shader
{
	name				global
	shaderop		DefaultPathTracing
}

standard_shader
{
	name				sss
	shaderop		DefaultPathTracing
}

# Migrated from pixelpel_rasterizer by tools/migrate_scenes_legacy_rasterizer.py (--mode full --integrator vcm, legacy-deprecation Phase 2).
# NOTE: VCM renders neither ambient_light nor directional_light, so this scene's ambient_light `ambient` contributes nothing here.
vcm_pel_rasterizer
{
	samples				64

}

file_rasterizeroutput
{
	pattern				rendered/caustic_sss
	type				PNG
	bpp				16
	color_space			ProPhotoRGB
}

file_rasterizeroutput
{
	pattern				rendered/caustic_sss
	type				EXR
	color_space			ROMMRGB_Linear
}

##################################################
# Cameras
##################################################

film
{
	width			500
	height			400
}

pinhole_camera
{
	location			0 0 10
	lookat				0 0 0
	up					0 1 0
	fov					25.0
	theta				15.0
}

##################################################
# Painters
##################################################

#############################################################################################################
#									RISE Ascii Scene File													#
#																											#
#	File: 			colors.scn																				#
#   Description:	Contains commonly used colors from all scenes											#
#	Author: 		Aravind Krishnaswamy																	#
#	Birthdate:		November 14, 2003																		#
#																											#
#############################################################################################################
#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           standard_colors.RISEscene                                                               #
#   Description:    Contains some standard colors                                                           #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################


uniformcolor_painter
{
	name		color_white
	color		1.0 1.0 1.0
}













#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           povray_colors.RISEscene                                                                 #
#   Description:    Contains colors taken from POV-Ray                                                      #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################






















	
	

	




































































uniformcolor_painter
{
	name				pnt_cnt
	color				0.65 0.15 0.02
}

##################################################
# Materials
##################################################

lambertian_material
{
	name				reddish
	reflectance			color_white
}

perfectrefractor_material
{
	name				glass
	refractance			color_white
}

translucent_material
{
	name				trans
	ref					pnt_cnt
	tau					pnt_cnt
	ext			0
	N					1.0
	scattering			0.8
}


##################################################
# Objects
##################################################

box_geometry
{
	name				boxgeom
	width				4.0
	height				3.0
	depth				4.0
}

# Converted from simple_sss_shaderop `sss` (point-cloud SSS, frozen) by tools/migrate_scenes_legacy_rasterizer.py --mode full:
#   Christensen-Burley match: albedo 0.65 0.15 0.02 (colour material `trans`, x the op's 1/extinction^2 channel weights, clamped to [0.01, 0.95]), profile tail falloff = extinction x 1000 x geometric_scale 0.45 = 4.5 4.5 4.5 per unit.
subsurfacescattering_material
{
	name			sss_sss_trans
	ior			1.3
	absorption	3.55597 3.55401 3.29975
	scattering	6.60395 0.627178 0.0673417
	g			0
}

standard_object
{
	name				plane
	geometry			boxgeom
	position			0 -1.5 0
	material			sss_sss_trans
	shader				sss
}

sphere_geometry
{
	name				spheregeom
	radius				0.5
}

standard_object
{
	name				sphere
	geometry			spheregeom
	position			1.0 0.75 0
	material			glass
}

spot_light
{
	name				light
	# Phase 2 slice B1 retune (owner-approved): power 3.14 -> 56.5; the legacy caustic photons carried power_scale 1593 and the SSS op irrad_scale 30 (x18 restores the mean)
	power				56.5
	position			3.0 3.5 -5.0
	target				1.0 0.0 0.5
	inner				20.0
	outer				25.0
	color				1.0 1.0 1.0
}

##################################################
# Ambient light (not rendered by VCM; see the rasterizer chunk)
##################################################

ambient_light
{
	name				ambient
	color				1 1 1
	power				0.5
}


