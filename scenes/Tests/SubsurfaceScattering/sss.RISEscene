RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           sss.RISEscene                                                                           #
#   Description:    A simple demonstration of the subsurface scattering shaderop                            #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      February 18, 2005                                                                       #
#                                                                                                           #
#############################################################################################################

##################################################
# Setup a renderer
##################################################

standard_shader
{
	name		global
	shaderop		DefaultPathTracing
}

standard_shader
{
	name		sss2
	shaderop		DefaultPathTracing
}

# Migrated from pixelpel_rasterizer by tools/migrate_scenes_legacy_rasterizer.py (--mode full --integrator pt, legacy-deprecation Phase 2).
pathtracing_pel_rasterizer
{
	samples				64
}

file_rasterizeroutput
{
	pattern				rendered/sss
	type				PNG
	bpp					8
	color_space			sRGB
}

##################################################
# Cameras
##################################################

film
{
	width			450
	height			250
}

pinhole_camera
{
	location			0 0 0.45
	lookat				0 0 0
	up					0 1 0
	fov					20.0
}

##################################################
# Painters
##################################################

#############################################################################################################
#									RISE Ascii Scene File													#
#																											#
#	File: 			colors.scn																				#
#   Description:	Contains commonly used colors from all scenes											#
#	Author: 		Aravind Krishnaswamy																	#
#	Birthdate:		November 14, 2003																		#
#																											#
#############################################################################################################
#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           standard_colors.RISEscene                                                               #
#   Description:    Contains some standard colors                                                           #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################


uniformcolor_painter
{
	name		color_white
	color		1.0 1.0 1.0
}













#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           povray_colors.RISEscene                                                                 #
#   Description:    Contains colors taken from POV-Ray                                                      #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################






















	
	

	




































































##################################################
# Materials
##################################################

translucent_material
{
	name				trans
	ref					color_white
	tau					color_white
	ext			0
	N					1.0
	scattering			0.8
}


##################################################
# Objects
##################################################

sphere_geometry
{
	name			spheregeom
	radius			0.05
}

box_geometry
{
	name			boxgeom
	width			0.10
	height			0.10
	depth			0.10
}

# Converted from simple_sss_shaderop `sss` (point-cloud SSS, frozen) by tools/migrate_scenes_legacy_rasterizer.py --mode full:
#   Christensen-Burley match: albedo 0.95 0.444444 0.0493827 (material `trans` x the op's 1/extinction^2 channel weights, clamped to [0.01, 0.95]), profile tail falloff = extinction x 1000 x geometric_scale 2 = 40 60 180 per unit.
subsurfacescattering_material
{
	name			sss_sss_trans
	ior			1.3
	absorption	5.83232 52.6864 134.289
	scattering	110.814 42.1491 6.97604
	g			0
}

standard_object
{
	name				mesh
	geometry			boxgeom
	orientation			45 0 0
	position			-0.06 0 0
	material			sss_sss_trans
}

# Converted from diffusion_approximation_sss_shaderop `sss2` (point-cloud SSS, frozen) by tools/migrate_scenes_legacy_rasterizer.py --mode full:
#   the op's own sigma_s / sigma_a (per mm) x 1000 x geometric_scale 0.1, ior 1.3, g 0.8.
subsurfacescattering_material
{
	name			sss2_sss_trans
	ior			1.3
	absorption	6.1 97 145
	scattering	18 7 3
	g			0.8
}

standard_object
{
	name				mesh2
	geometry			boxgeom
	orientation			45 0 0
	position			0.06 0 0
	material			sss2_sss_trans
	shader				sss2
}

omni_light
{
	name				light
	power				500000.0
	position			0 10 0
	color				1.0 1.0 1.0
}



