#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################











uniformcolor_painter
{
	name		color_cream
	color		0.7 0.7 0.7
}




#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           povray_colors.RISEscene                                                                 #
#   Description:    Contains colors taken from POV-Ray                                                      #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################






















	
	

	












uniformcolor_painter
{
	name		color_orange
	color		1.0 0.5 0.0 
}
























































lambertian_material
{
	name				white
	reflectance			color_cream
}

standard_shader
{
	name		global
	shaderop		DefaultPathTracing
}

# Migrated from pixelpel_rasterizer by tools/migrate_scenes_legacy_rasterizer.py (--mode full --integrator pt, legacy-deprecation Phase 2).
pathtracing_pel_rasterizer
{
	samples				64
}

file_rasterizeroutput
{
	pattern				rendered/sss_different_bsdf
	type				PNG
	bpp				8
	#color_space			ProPhotoRGB
}

/*
file_rasterizeroutput
{
	pattern				rendered/sss_different_bsdf
	type				EXR
	color_space			ROMMRGB_Linear
}
*/

##################################################
# Cameras
##################################################

film
{
	width			1000
	height			800
}

pinhole_camera
{
	location			0 0 0.4
	lookat				0 0 0
	up					0 1 0
	fov					30.0
}

##################################################
# Painters
##################################################

##################################################
# Materials
##################################################

# Legacy phase 2 slice B2: was ward_anisotropic_material; ward_anisotropic alphax 0.9 alphay 0.1 carried, rs -> F0 (schlick_f0) (SCENE_CONVENTIONS 11.5).
ggx_material
{
	name				wa
	rd					color_orange
	rs					color_cream
	alphax				0.9
	alphay				0.1
	fresnel_mode		schlick_f0
}

##################################################
# Objects
##################################################

risemesh_geometry
{
	name			meshgeom
	file			models/risemesh/dragon_small.risemesh
}

# Converted from simple_sss_shaderop `sss` (point-cloud SSS, frozen) by tools/migrate_scenes_legacy_rasterizer.py --mode full:
#   Christensen-Burley match: albedo 0.7 0.311111 0.0345679 (colour the irradiance shader's override BSDF, x the op's 1/extinction^2 channel weights, clamped to [0.01, 0.95]), profile tail falloff = extinction x 1000 x geometric_scale 7 = 140 210 630 per unit.
subsurfacescattering_material
{
	name			sss_sss_wa
	ior			1.3
	absorption	102.024 178.937 465.948
	scattering	238.057 80.8103 16.6835
	g			0
}

standard_object
{
	name				mesh
	geometry			meshgeom
	position			0.0 -0.12 0.0
	orientation			10.0 20.0 0
	material			sss_sss_wa
}

omni_light
{
	name				light
	# Phase 2 slice B1 retune (owner-approved): power 12500.0 -> 142500; the legacy point-cloud SSS op scaled its glow by irrad_scale 1900; the physical SSS material is normalized
	power				142500
	position			0 100 0
	color				1.0 1.0 1.0
}


