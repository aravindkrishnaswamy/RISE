RISE ASCII SCENE 7
#############################################################################################################
#                                      RISE Ascii Scene File                                                #
#                                                                                                           #
#   File:           sss_multiple_lights.RISEscene                                                           #
#   Description:    Demonstrates subsurface scattering with multiple area light sources                     #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      March 8, 2004                                                                           #
#                                                                                                           #
#############################################################################################################

##################################################
# Setup a renderer
##################################################

standard_shader
{
	name		global
	shaderop		DefaultPathTracing
}

# Migrated from pixelpel_rasterizer by tools/migrate_scenes_legacy_rasterizer.py (--mode full --integrator pt, legacy-deprecation Phase 2).
pathtracing_pel_rasterizer
{
	samples				64
}

file_rasterizeroutput
{
	pattern				rendered/sss_multiple_lights
	type				EXR
	color_space			ROMMRGB_Linear
}

##################################################
# Cameras
##################################################

film
{
	width			384
	height			512
}

pinhole_camera
{
	location			0 0 17.0
	lookat				0 0 0
	up					0 1 0
	fov					45.0
}

##################################################
# Painters
##################################################

#############################################################################################################
#									RISE Ascii Scene File													#
#																											#
#	File: 			colors.scn																				#
#   Description:	Contains commonly used colors from all scenes											#
#	Author: 		Aravind Krishnaswamy																	#
#	Birthdate:		November 14, 2003																		#
#																											#
#############################################################################################################
#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           standard_colors.RISEscene                                                               #
#   Description:    Contains some standard colors                                                           #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################


uniformcolor_painter
{
	name		color_white
	color		1.0 1.0 1.0
}

uniformcolor_painter
{
	name		color_red
	color		1.0 0.0 0.0
}

uniformcolor_painter
{
	name		color_green
	color		0.0 1.0 0.0
}

uniformcolor_painter
{
	name		color_blue
	color		0.0 0.0 1.0
}










#############################################################################################################
#                                   RISE Ascii Scene File                                                   #
#                                                                                                           #
#   File:           povray_colors.RISEscene                                                                 #
#   Description:    Contains colors taken from POV-Ray                                                      #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      April 22, 2004                                                                          #
#                                                                                                           #
#############################################################################################################






















	
	

	



































































		
##################################################
# Materials
##################################################
			
lambertian_material
{
	name				white
	reflectance			color_white
}

lambertian_luminaire_material
{
	name				lumA
	exitance			color_red
	scale				90.0
	material			none
}

lambertian_luminaire_material
{
	name				lumB
	exitance			color_green
	scale				90.0
	material			none
}

lambertian_luminaire_material
{
	name				lumC
	exitance			color_blue
	scale				90.0
	material			none
}

translucent_material
{
	name				translucent
	ref					color_white
	tau					color_white
	ext			0
	N					0.0
	scattering			0.0
}

##################################################
# Objects
##################################################

rawmesh_geometry
{
	name				venusgeom
	file				models/raw/venus.rawmesh
	maxpolygons			10
	maxdepth			8
}

standard_shader
{
	name		sss
	shaderop		DefaultPathTracing
}

# Converted from simple_sss_shaderop `sss` (point-cloud SSS, frozen) by tools/migrate_scenes_legacy_rasterizer.py --mode full:
#   Christensen-Burley match: albedo 0.95 0.95 0.95 (colour material `translucent`, x the op's 1/extinction^2 channel weights, clamped to [0.01, 0.95]), profile tail falloff = extinction x 1000 x geometric_scale 3.5 = 3.5 3.5 3.5 per unit.
subsurfacescattering_material
{
	name			sss_sss_translucent
	ior			1.3
	absorption	0.510328 0.510328 0.510328
	scattering	9.69623 9.69623 9.69623
	g			0
}

standard_object
{
	name				venus
	geometry			venusgeom
	material			sss_sss_translucent
	orientation			-90 0 0
	shader				sss
}

# Luminaries

clippedplane_geometry
{
	name				lightAgeom
	pta					-4 -1 -4
	ptb					4 -1 -4
	ptc					4 1 -4
	ptd					-4 1 -4
}

standard_object
{
	name				lightA
	geometry			lightAgeom
	material			lumA
	position			0 -5 0
}

standard_object
{
	name				lightB
	geometry			lightAgeom
	material			lumB
	position			0 5 0
}

standard_object
{
	name				lightC
	geometry			lightAgeom
	material			lumC
	position			0 0 0
}



