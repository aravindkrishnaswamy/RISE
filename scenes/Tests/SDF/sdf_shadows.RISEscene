RISE ASCII SCENE 7
# SDF interop test: an SDF melded blob alongside an analytic sphere + box on a
# ground plane, a directional light -> mutual shadows + correct ground contact.
# Validates that sphere-traced SDF geometry participates in the same ray /
# shadow-ray / inter-geometry pipeline as the analytic primitives.

standard_shader
{
	name			global
	shaderop		DefaultPathTracing
}

# Legacy phase 2 slice B2: the former ambient_light, as a uniform environment (radiance_map
# below).  radiance = ambient color x power / pi: the uniform radiance that lights an
# unoccluded Lambertian surface as the ambient light did.  The environment is occluded,
# so creases and interiors get darker (owner ruling #5).
uniformcolor_painter
{
	name				pnt_ambient_env
	color				0.68207 0.76572 1
	colorspace			Rec709RGB_Linear
}

# Migrated from pixelpel_rasterizer by tools/migrate_scenes_legacy_rasterizer.py (--mode direct, legacy-deprecation Phase 2).
pathtracing_pel_rasterizer
{
	samples			24
	max_diffuse_bounce		0
	radiance_map			pnt_ambient_env
	radiance_scale			0.0281359
	radiance_background		FALSE
}

file_rasterizeroutput
{
	pattern			rendered/sdf_shadows
	type			PNG
	bpp				8
	color_space		sRGB
}

film
{
	width			900
	height			560
}

pinhole_camera
{
	location		0 9 22
	lookat			0 2 0
	up				0 1 0
	fov				40.0
}

directional_light
{
	name			key
	power			3.0
	color			1.0 1.0 1.0
	direction		0.45 0.8 0.35
}

uniformcolor_painter
{
	name			pgray
	color			0.66 0.66 0.68
}

uniformcolor_painter
{
	name			pblue
	color			0.20 0.35 0.75
}

uniformcolor_painter
{
	name			pred
	color			0.75 0.25 0.22
}

uniformcolor_painter
{
	name			pgreen
	color			0.25 0.62 0.30
}

lambertian_material
{
	name			mgray
	reflectance		pgray
}

lambertian_material
{
	name			mblue
	reflectance		pblue
}

lambertian_material
{
	name			mred
	reflectance		pred
}

lambertian_material
{
	name			mgreen
	reflectance		pgreen
}

clippedplane_geometry
{
	name			groundgeom
	pta				-40 0 -40
	ptb				 40 0 -40
	ptc				 40 0  40
	ptd				-40 0  40
}

sphere_geometry
{
	name			sphgeom
	radius			2.2
}

box_geometry
{
	name			boxgeom
	width			3.4
	height			3.4
	depth			3.4
}

sdf_geometry
{
	name			blobgeom
	part			roundbox union 0  0 2 0  0 0 0  1 1 1  2 2 2  0.5
	part			sphere smin 1.6  2.6 3.2 0  0 0 0  1 1 1  1.7 0 0  0
}

standard_object
{
	name			ground
	geometry		groundgeom
	material		mgray
	position		0 0 0
}

standard_object
{
	name			blob
	geometry		blobgeom
	material		mblue
	position		-5 0 0
}

standard_object
{
	name			sph
	geometry		sphgeom
	material		mred
	position		1 2.2 1
}

standard_object
{
	name			box
	geometry		boxgeom
	material		mgreen
	position		6 1.7 -1
	orientation		0 30 0
}
