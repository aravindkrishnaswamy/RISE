RISE ASCII SCENE 7
# SDF + refractive-caustic test.  A glass SDF torus sits above a white floor with
# an overhead area light.  Light passes through the ring's hole AND refracts
# through the glass band -> a ring caustic focused on the floor.  Photons are
# traced from the light through the ray-marched dielectric (up to 4 boundary
# crossings per photon: enter/exit the near band, enter/exit the far band),
# exercising the sphere-tracer's entry/exit tracking on the LIGHT-transport side
# as well as the camera side.

standard_shader
{
	name		global
	shaderop		DefaultPathTracing
}

# Migrated from pixelpel_rasterizer by tools/migrate_scenes_legacy_rasterizer.py (--mode full --integrator vcm, legacy-deprecation Phase 2).
vcm_pel_rasterizer
{
	samples				64
}

file_rasterizeroutput
{
	pattern			rendered/sdf_caustic
	type			PNG
	bpp				8
	color_space		sRGB
}

film
{
	width			640
	height			512
}

pinhole_camera
{
	location		0 7.5 -9.5
	lookat			0 0.6 0
	up				0 1 0
	fov				42.0
}

