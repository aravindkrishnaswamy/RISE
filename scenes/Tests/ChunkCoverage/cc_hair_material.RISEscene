RISE ASCII SCENE 7
# Coverage: hair_material (Chiang et al. 2016 near-field hair/fur BCSDF).

film
{
	width		64
	height		64
}

scalar_painter
{
	name		cc_eumelanin
	value		1.3
}

scalar_painter
{
	name		cc_medulla_ratio
	value		0.7
}

# The three medulla parameters are exercised two ways here, so the
# coverage fixture pins BOTH binding styles the descriptor allows: a
# named scalar_painter reference (medulla_ratio) and an inline numeric
# literal (medulla_scatter / medulla_g).
hair_material
{
	name		cc_hair
	eumelanin	cc_eumelanin
	medulla_ratio	cc_medulla_ratio
	medulla_scatter	1.5
	medulla_g	0.35
}

sphere_geometry
{
	name		cc_sph
	radius		1.0
}

standard_object
{
	name		cc_obj
	geometry	cc_sph
	material	cc_hair
	position	0 0 0
}
