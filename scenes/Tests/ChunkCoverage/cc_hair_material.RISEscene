RISE ASCII SCENE 7
# Coverage: hair_material (Chiang et al. 2016 near-field hair/fur BCSDF).

film
{
	width		64
	height		64
}

scalar_painter
{
	name		cc_eumelanin
	value		1.3
}

hair_material
{
	name		cc_hair
