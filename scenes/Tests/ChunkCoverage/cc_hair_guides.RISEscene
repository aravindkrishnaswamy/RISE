RISE ASCII SCENE 7
# Coverage: hair_guides (authored guide strands) + hair_geometry's
# `guides` field.
#
# Four guides rooted around the crown of a sphere, each a three-point
# polyline that rises off the surface and then flicks sideways, driving
# a 400-strand groom.  Every parameter of the chunk (`name`, repeatable
# `guide`) is exercised, and so is the one field on `hair_geometry` this
# slice adds.
#
# WHAT THIS SCENE PROVES, and what it does not.  It proves the chunk is
# DECLARED, parses, resolves through Job::AddHairGeometry's `guides`
# lookup, and survives a CST derive (it is hashed by CstDeriveGoldenTest,
# so a derive-level change shows up as a digest diff).  It does NOT prove
# the interpolation is correct, or even that Finalize hands the points to
# the right slot -- nothing is generated by a parse.  That is
# HairGuidesTest's job: it pins every control point against an
# independently computed closed form, and its group 4 grows two grooms
# through this very chunk differing only in the `guides` line.
#
# Note the guides are authored ON the sphere's surface (their first
# points are unit-length vectors from the origin, i.e. points of the
# radius-1 scalp).  That is the documented authoring rule: a guide is
# attached to the base by projecting its ROOT onto the base surface, and
# a guide rooted somewhere meaningful is what makes its shape mean
# something at the strands it steers.

film
{
	width		64
	height		64
}

sphere_geometry
{
	name		cc_scalp
	radius		1.0
}

hair_guides
{
	name		cc_guides
	guide		0 1 0            0 1.15 0            0.06 1.18 0
	guide		0.707 0.707 0    0.81 0.81 0         0.86 0.83 0.05
	guide		-0.707 0.707 0   -0.81 0.81 0        -0.86 0.83 -0.05
	guide		0 0.707 0.707    0 0.81 0.81         0.05 0.83 0.86
}

hair_geometry
{
	name		cc_guided_groom
	base_geometry	cc_scalp
	guides		cc_guides
	count		400
	segments	8
	length		0.15
	width_root	0.004
	width_tip	0.001
	seed		5
	base_detail	16
	frizz		0.05
}

scalar_painter
{
	name		cc_eumelanin
	value		1.3
}

hair_material
{
	name		cc_hair
	eumelanin	cc_eumelanin
}

standard_object
{
	name		cc_obj
	geometry	cc_guided_groom
	material	cc_hair
	position	0 0 0
}
