RISE ASCII SCENE 7
# Coverage: hair_geometry (painter-driven groom on a base surface).
# A small 500-strand groom on a sphere, bound to a hair_material, with
# every optional styling field bound at least once.
#
# WHAT THIS SCENE ACTUALLY PROVES, and what it does not.  Binding every
# field here proves each one is DECLARED in the chunk descriptor and
# survives a parse + CST derive (it is one of the scenes hashed by
# CstDeriveGoldenTest, so a derive-level change to any of them shows up
# as a digest diff).  It does NOT prove Finalize reads a field under the
# name the descriptor declares -- a transposed or misspelled bag.Get*
# here would still parse, and the golden would still match, because the
# groom itself is never generated by a parse.  Only a BEHAVIOURAL probe
# catches that, by growing two grooms that differ in one field and
# measuring the difference: HairGeneratorTest's group 8 does that for
# `segments`, `seed`, `gravity` and `frizz`.  The remaining fields
# (width_root, width_tip, base_detail, density, length_painter, comb,
# clump, clump_size, curl_radius, curl_step) are parse-and-golden only
# from the chunk path -- their behaviour is pinned through the direct
# recipe API in groups 3-6 instead.

film
{
	width		64
	height		64
}

sphere_geometry
{
	name		cc_scalp
	radius		1.0
}

scalar_painter
{
	name		cc_density
	value		0.8
}

scalar_painter
{
	name		cc_lengthscale
	value		0.9
}

uniformcolor_painter
{
	name		cc_comb
	color		0.8 0.5 0.5
}

hair_geometry
{
	name		cc_groom
	base_geometry	cc_scalp
	count		500
	segments	8
	length		0.15
	width_root	0.004
	width_tip	0.001
	seed		11
	base_detail	16
	density		cc_density
	length_painter	cc_lengthscale
	comb		cc_comb
	gravity		0.2
	frizz		0.1
	clump		0.5
	clump_size	0.05
	curl_radius	0.01
	curl_step	0.06
}

scalar_painter
{
	name		cc_eumelanin
	value		1.3
}

hair_material
{
	name		cc_hair
	eumelanin	cc_eumelanin
}

standard_object
{
	name		cc_obj
	geometry	cc_groom
	material	cc_hair
	position	0 0 0
}
