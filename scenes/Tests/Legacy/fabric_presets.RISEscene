RISE ASCII SCENE 7
#############################################################################################################
#                                                                                                           #
#   File:           fabric_presets.RISEscene                                                                #
#   Description:    docs/CLOTH_FABRIC_DESIGN.md Phase 1 (9.9 gate 11): all SEVEN `fabric`                   #
#                   presets on one row, on scenes/Tests/Materials/sheen.RISEscene's shape.                  #
#                                                                                                           #
#                   Left to right:                                                                          #
#                     cotton  linen  denim  wool  silk  satin  velvet                                       #
#                                                                                                           #
#                   EACH PRESET IS PAIRED WITH THE SUBSTRATE IT WAS CALIBRATED FOR (9.3's                   #
#                   split table).  A preset can only seed `fabric_material`'s OWN slots --                  #
#                   it holds a reference to an already-constructed base material and can                    #
#                   neither retype nor re-parameterise it -- so binding `fabric satin` over                 #
#                   a Lambertian would give chalk with a faint sheen and a warn-level                       #
#                   diagnostic.  This scene therefore hand-authors each recommended base:                   #
#                                                                                                           #
#                     cotton / linen / wool  ->  orennayar_material, sigma 0.4 / 0.5 / 0.6                  #
#                     denim / silk / satin   ->  a `weave_material` carrying the same-named             #
#                                                weave preset (PHASE 2, 2026-09-03 -- these            #
#                                                three used to want an anisotropic                     #
#                                                ggx_material, and 9.9 gate 9b measured that           #
#                                                shape and found it reads as brushed metal)            #
#                     velvet                 ->  a DARK lambertian_material (a pile, not a                  #
#                                                weave -- isotropic on purpose)                             #
#                                                                                                           #
#                   THE THREE WEAVE BASES CARRY ONLY `fabric`, two dyes and a `weave_scale`.                #
#                   Everything else -- the draft, both IORs, both longitudinal widths, both                 #
#                   azimuthal widths, both k_d fractions, both float tilts and the gap --                   #
#                   comes from the weave preset table.  Both dyes are authored here rather                  #
#                   than only the warp's, because the presets' own generic weft tones clash                 #
#                   with this scene's palette and make the rows read as speckle; each weft                  #
#                   is a darker relative of its warp, so the two families stay unmistakably                 #
#                   different -- which is what makes a lost draft obvious.                                  #
#                                                                                                           #
#                   `weave_rotation` steers the SUBSTRATE's frame, not the sheen lobe (9.5):                #
#                   denim gets 45 deg and satin 90 deg on the FABRIC wrapper, which rotates                 #
#                   the frame its weave substrate is evaluated in.  Silk stays at 0, so the                 #
#                   three directional rows differ in orientation as well as in draft.  Every                #
#                   other preset leaves it unset, where the rotation is a bit-exact no-op.                  #
#                                                                                                           #
#                   LIGHTING is a near-grazing rim plus a soft front key, because the sheen                 #
#                   lobe's mass sits at grazing half-vectors: under a front-on key alone the                #
#                   presets are nearly indistinguishable and the scene proves nothing.  In a                #
#                   healthy render each sphere shows a bright silhouette halo -- narrow and                 #
#                   tight on satin/velvet (alpha 0.12 / 0.08), broad and soft on wool                       #
#                   (alpha 0.75) -- over a substrate whose own draft is visible on the three                #
#                   weave rows: denim a diagonal 3/1 twill wale, silk and satin a 5-harness                 #
#                   satin float.                                                                            #
#                                                                                                           #
#                   Note that `directional_light.direction` is the vector FROM the surface                  #
#                   TO the light, so a camera-facing hemisphere needs a POSITIVE Z                          #
#                   component (docs/SCENE_CONVENTIONS.md 1).                                                #
#                                                                                                           #
#   Author:         Aravind Krishnaswamy                                                                    #
#   Birthdate:      2026-09-02                                                                              #
#                                                                                                           #
#############################################################################################################

standard_shader
{
	name			global
	shaderop		DefaultDirectLighting
}

pixelpel_rasterizer
{
	max_recursion		3
	samples				64
	lum_samples			1
}

file_rasterizeroutput
{
	pattern				rendered/fabric_presets
	type				PNG
	bpp					8
	color_space			sRGB
}

film
{
	width			1344
	height			256
}

pinhole_camera
{
	location			0 0 8
	lookat				0 0 0
	up					0 1 0
	fov					20.0
}

#############################################################################################################
# Painters
#############################################################################################################

# Substrate reflectances (the "cloth" colour under the sheen).
uniformcolor_painter
{
	name				dye_cotton
	color				0.72 0.70 0.64
	colorspace			Rec709RGB_Linear
}
uniformcolor_painter
{
	name				dye_linen
	color				0.76 0.71 0.58
	colorspace			Rec709RGB_Linear
}
uniformcolor_painter
{
	name				dye_denim
	color				0.16 0.24 0.42
	colorspace			Rec709RGB_Linear
}
uniformcolor_painter
{
	name				dye_wool
	color				0.55 0.40 0.32
	colorspace			Rec709RGB_Linear
}
uniformcolor_painter
{
	name				dye_silk
	color				0.62 0.16 0.20
	colorspace			Rec709RGB_Linear
}
uniformcolor_painter
{
	name				dye_satin
	color				0.20 0.42 0.38
	colorspace			Rec709RGB_Linear
}
# The WEFT dyes for the three weave rows.  The presets seed both families,
# but their generic second tone clashes with this scene's own warp dyes and
# makes the row read as speckle rather than as a draft.  Each is a darker
# relative of its warp, so the two families stay unmistakably DIFFERENT --
# which is what makes a lost draft obvious -- without fighting the colour.
uniformcolor_painter
{
	name				dye_denim_weft
	color				0.58 0.55 0.47
	colorspace			Rec709RGB_Linear
}
uniformcolor_painter
{
	name				dye_silk_weft
	color				0.34 0.09 0.12
	colorspace			Rec709RGB_Linear
}
uniformcolor_painter
{
	name				dye_satin_weft
	color				0.10 0.22 0.20
	colorspace			Rec709RGB_Linear
}
uniformcolor_painter
{
	name				dye_velvet
	color				0.10 0.05 0.14
	colorspace			Rec709RGB_Linear
}

# Sheen tints.  Left unset on `velvet` on purpose, so the ONE preset
# that seeds its own (dark) sheen colour is exercised through the
# omitted-slot path rather than being overridden here.
uniformcolor_painter
{
	name				sheen_neutral
	color				0.95 0.94 0.92
	colorspace			Rec709RGB_Linear
}
uniformcolor_painter
{
	name				sheen_warm
	color				1.00 0.90 0.72
	colorspace			Rec709RGB_Linear
}

#############################################################################################################
# Substrates -- 9.3's recommended class + parameters, per preset
#############################################################################################################

orennayar_material
{
	name				base_cotton
	reflectance			dye_cotton
	roughness			0.4
}

orennayar_material
{
	name				base_linen
	reflectance			dye_linen
	roughness			0.5
}

orennayar_material
{
	name				base_wool
	reflectance			dye_wool
	roughness			0.6
}

# PHASE 2 (2026-09-03): denim, silk and satin now recommend a
# `weave_material`, so that is what they are paired with here.  `weave_scale`
# is authored because no preset can know this sphere's UV scale or this
# framing; 26 puts about a dozen cells across each visible face, which is
# where the draft reads.
weave_material
{
	name				base_denim
	fabric				denim
	warp_color			dye_denim
	weft_color			dye_denim_weft
	weave_scale			26.0
}

weave_material
{
	name				base_silk
	fabric				silk
	warp_color			dye_silk
	weft_color			dye_silk_weft
	weave_scale			26.0
}

weave_material
{
	name				base_satin
	fabric				satin
	warp_color			dye_satin
	weft_color			dye_satin_weft
	weave_scale			26.0
}

lambertian_material
{
	name				base_velvet
	reflectance			dye_velvet
}

#############################################################################################################
# The seven presets.  Only `fabric` + `base` are authored on most of
# them: `sheen_roughness` comes from the preset table, which is the
# multi-slot seeding 9.3 introduces.
#############################################################################################################

fabric_material
{
	name				m_cotton
	fabric				cotton
	base				base_cotton
	sheen_color			sheen_neutral
}

fabric_material
{
	name				m_linen
	fabric				linen
	base				base_linen
	sheen_color			sheen_neutral
}

fabric_material
{
	name				m_denim
	fabric				denim
	base				base_denim
	sheen_color			sheen_neutral
	weave_rotation		0.7853981633974483
}

fabric_material
{
	name				m_wool
	fabric				wool
	base				base_wool
	sheen_color			sheen_warm
}

fabric_material
{
	name				m_silk
	fabric				silk
	base				base_silk
	sheen_color			sheen_warm
}

fabric_material
{
	name				m_satin
	fabric				satin
	base				base_satin
	sheen_color			sheen_neutral
	weave_rotation		1.5707963267948966
}

# velvet: `sheen_color` deliberately OMITTED, so the preset's own dark
# sheen colour is what binds -- the only preset that sets one, and the
# only path through Job::AddFabricMaterial's preset-colour branch that a
# scene exercises.
fabric_material
{
	name				m_velvet
	fabric				velvet
	base				base_velvet
}

#############################################################################################################
# Geometry
#############################################################################################################

sphere_geometry
{
	name				sph
	radius				0.7
}

standard_object
{
	name				s_cotton
	geometry			sph
	material			m_cotton
	position			-5.1 0 0
}

standard_object
{
	name				s_linen
	geometry			sph
	material			m_linen
	position			-3.4 0 0
}

standard_object
{
	name				s_denim
	geometry			sph
	material			m_denim
	position			-1.7 0 0
}

standard_object
{
	name				s_wool
	geometry			sph
	material			m_wool
	position			0.0 0 0
}

standard_object
{
	name				s_silk
	geometry			sph
	material			m_silk
	position			1.7 0 0
}

standard_object
{
	name				s_satin
	geometry			sph
	material			m_satin
	position			3.4 0 0
}

standard_object
{
	name				s_velvet
	geometry			sph
	material			m_velvet
	position			5.1 0 0
}

#############################################################################################################
# Lights.  `direction` is FROM the surface TO the light source, so a
# camera-facing hemisphere needs a POSITIVE Z (docs/SCENE_CONVENTIONS.md 1).
# Colours are LINEAR Rec.709 (the 2026-09-02 zero-area-light convention).
#############################################################################################################

# The RIM: nearly perpendicular to the view, which is the geometry the
# Charlie lobe is built for.  Without it the presets look alike.
directional_light
{
	name		rim
	power		2.0
	color		1.0 0.97 0.92
	direction	0.93 0.30 0.20
}

# A second rim from the other side, so every sphere shows a halo on at
# least one silhouette regardless of where it sits in the row.
directional_light
{
	name		rim2
	power		1.3
	color		0.90 0.94 1.0
	direction	-0.93 0.22 0.28
}

# A soft front key, so the SUBSTRATE (the dye and, on the GGX rows, the
# weave-steered highlight) is readable rather than silhouette-only.
directional_light
{
	name		key
	power		0.8
	color		1.0 1.0 1.0
	direction	0.15 0.45 0.88
}

ambient_light
{
	name		ambient
	power		0.10
	color		1.0 1.0 1.0
}
