}

# Staff: thin tilted cylinder rising past the wizard's hand.
cylinder_geometry
{
	name	staff
	axis	y
	radius	0.035
	height	2.3
}

uniformcolor_painter
{
	name	pnt_staff
	color	0.25 0.14 0.08
}

lambertian_material
{
	name		mat_staff
	reflectance	pnt_staff
}

standard_object
{
	name		obj_staff
	geometry	staff
	material	mat_staff
	position	2.50 2.50 3.55
	orientation	0 0 -6
}

# The orb: emissive heart of the scene's magic.
uniformcolor_painter
{
	name	pnt_orb
	color	0.55 1.0 0.85
}

lambertian_luminaire_material
{
	name		mat_orb
	exitance	pnt_orb
	scale		60.0
	material	none
}

sphere_geometry
{
	name	orb
	radius	0.14
}

standard_object
{
	name		obj_orb
	geometry	orb
	material	mat_orb
