RISE ASCII SCENE 7
#############################################################################################################
#   Dreamscape: "The Covenant of the Vale"                                                                  #
#   A wizard communes with a dragon in a psychedelic dusk valley -- spiral nebula sky, mist, glowing        #
#   terrain veins.  Authored for the Fable benchmark.                                                       #
#############################################################################################################

#############################################################################################################
#   BENCHMARK PROVENANCE                                                                                    #
#   Prompt (verbatim): "Build me a dreamy landscape with dragons, wizards, and mist.  Make it               #
#   psychedelic, creative that sparks the imagination and makes you wonder how that was made.  Use          #
#   textures, shapes and objects creatively."                                                               #
#   Model: Claude Fable 5 (claude-fable-5), subagent with full RISE context, 17 look iterations.            #
#   Date: 2026-08-06.  Held as the frontier-model qualitative bar for agent scene-building comparisons.     #
#############################################################################################################

##################################################
# Sky: a spiral nebula painted in the angular map
# (radiance_map evaluates its painter at UV derived
# from the ray direction; center of map = -Z, which
# is dead ahead of the +Z camera).
##################################################

# NOTE: with a 52-degree fov the visible frame occupies only
# r < ~0.09 of the angular map (r = angle/2pi), so every sky
# feature is scaled into that window.

# Spiral arm field: log-spiral interference around the map center.
expression_function2d
{
	name	fn_sky_spiral
	def		dx u - 0.5
	def		dy v - 0.5
	def		r hypot( dx, dy )
	def		th atan2( dy, dx )
	def		arm 0.5 + 0.5 * sin( th * 4.0 + r * 320.0 + 1.5 )
	expr	pow( arm, 3.0 ) * smoothstep( 0.12, 0.012, r )
}

# Radial core glow: hot center fading out.
expression_function2d
{
	name	fn_sky_glow
	def		dx u - 0.5
	def		dy v - 0.5
	def		r hypot( dx, dy )
	expr	exp( -2200.0 * r * r )
}

uniformcolor_painter
{
	name	pnt_sky_indigo
	color	0.012 0.008 0.045
}

uniformcolor_painter
{
	name	pnt_sky_magenta
	color	0.60 0.08 0.70
}

uniformcolor_painter
{
	name	pnt_sky_teal
	color	0.03 0.38 0.45
}

uniformcolor_painter
{
	name	pnt_sky_gold
	color	1.0 0.62 0.20
}

# Teal base washed with indigo away from the spiral zone.
blend_painter
{
	name	pnt_sky_base
	colora	pnt_sky_teal
	colorb	pnt_sky_indigo
	mask	fn_sky_spiral
}

# Magenta spiral arms over the teal/indigo wash.
expression_function2d
{
	name	fn_sky_arms2
	def		dx u - 0.5
	def		dy v - 0.5
	def		r hypot( dx, dy )
	def		th atan2( dy, dx )
	def		arm 0.5 + 0.5 * sin( th * 4.0 - r * 420.0 - 0.8 )
	expr	pow( arm, 3.0 ) * smoothstep( 0.11, 0.008, r )
}

blend_painter
{
	name	pnt_sky_swirl
	colora	pnt_sky_magenta
	colorb	pnt_sky_base
	mask	fn_sky_arms2
}

# Golden core burning through the middle of the vortex.
blend_painter
{
	name	pnt_sky
	colora	pnt_sky_gold
	colorb	pnt_sky_swirl
	mask	fn_sky_glow
}

##################################################
# Renderer
##################################################

standard_shader
{
	name		global
	shaderop	DefaultPathTracing
}

pathtracing_pel_rasterizer
{
	samples					256
	pixel_filter			box
	oidn_denoise			TRUE
	radiance_map			pnt_sky
	radiance_scale			0.75
	radiance_background		TRUE
}

file_rasterizeroutput
{
	pattern		final
	type		PNG
	bpp			8
	color_space	sRGB
}

film
{
	width	800
	height	600
}

pinhole_camera
{
	location	0 2.4 9.5
	lookat		0 1.8 0
	up			0 1 0
	fov			52.0
}

##################################################
# Terrain: displaced rolling valley floor
##################################################

uniformcolor_painter
{
	name	pnt_terra_violet
	color	0.16 0.05 0.24
}

uniformcolor_painter
{
	name	pnt_terra_teal
	color	0.03 0.28 0.26
}

# Psychedelic dusk ground: warped teal-into-violet fields.
domainwarp3d_painter
{
	name			pnt_terrain
	colora			pnt_terra_teal
	colorb			pnt_terra_violet
	octaves			4
	persistence		0.6
	warp_amplitude	2.5
	warp_levels		2
	scale			0.35 0.35 0.35
}

lambertian_material
{
	name		mat_terrain
	reflectance	pnt_terrain
}

# Glowing leyline veins: worley f2-f1 is ~0 on cell BOUNDARIES, and
# colora sits at the low end -- electric cyan cracks running across
# the valley, black elsewhere.  The luminaire wraps the base terrain.
uniformcolor_painter
{
	name	pnt_vein_glow
	color	0.25 0.85 0.95
}

uniformcolor_painter
{
	name	pnt_vein_black
	color	0.0 0.0 0.0
}

uniformcolor_painter
{
	name	pnt_vein_white
	color	1.0 1.0 1.0
}

# (An emissive-terrain attempt turned the frame into NEE noise -- a
# 60x60 luminaire is a variance bomb.  The veins are now BRIGHT
# REFLECTANCE layered over the warped base instead: mask 1 keeps the
# base, mask ~0 at cell boundaries lets the cyan vein through.)
worley3d_painter
{
	name	pnt_vein_mask
	colora	pnt_vein_black
	colorb	pnt_vein_white
	output	f2-f1
	jitter	1.0
	scale	0.55 0.55 0.55
}

blend_painter
{
	name	pnt_terrain_veined
	colora	pnt_terrain
	colorb	pnt_vein_glow
	mask	pnt_vein_mask
}

lambertian_material
{
	name		mat_terrain_glow
	reflectance	pnt_terrain_veined
}

# Rolling hills displacement over the big ground quad.
expression_function2d
{
	name	fn_hills
	def		a sin( u * 19.0 + 1.3 ) * cos( v * 15.0 - 0.7 )
	def		b sin( u * 41.0 - 2.0 ) * sin( v * 37.0 + 0.9 )
	def		c sin( u * 7.0 ) * sin( v * 9.0 + 2.1 )
	expr	0.5 * c + 0.35 * a + 0.15 * b
}

clippedplane_geometry
{
	name	ground_base
	pta		-30.0 0.0 -30.0
	ptb		-30.0 0.0 30.0
	ptc		30.0 0.0 30.0
	ptd		30.0 0.0 -30.0
}

displaced_geometry
{
	name			ground_hills
	base_geometry	ground_base
	detail			160
	displacement	fn_hills
	disp_scale		1.8
	uv_seam_fold	FALSE
}

standard_object
{
	name		obj_ground
	geometry	ground_hills
	material	mat_terrain_glow
	position	0 -0.6 0
}

##################################################
# The dragon: serpentine SDF sphere-chain
##################################################

uniformcolor_painter
{
	name	pnt_drg_magenta
	color	0.75 0.12 0.55
}

uniformcolor_painter
{
	name	pnt_drg_teal_lo
	color	0.02 0.20 0.18
}

uniformcolor_painter
{
	name	pnt_drg_teal_hi
	color	0.10 0.55 0.45
}

# Labyrinthine hide pattern.
reactiondiffusion3d_painter
{
	name		pnt_drg_hide
	colora		pnt_drg_teal_hi
	colorb		pnt_drg_teal_lo
	feed		0.037
	kill		0.06
	grid_size	48
	iterations	3000
	scale		1.4 1.4 1.4
}

# Magenta sheen at grazing angles over the patterned hide.
iridescent_painter
{
	name	pnt_dragon
	colora	pnt_drg_magenta
	colorb	pnt_drg_hide
	bias	0.05
}

lambertian_material
{
	name		mat_dragon
	reflectance	pnt_dragon
}

# Body: local frame, head toward +X.  Dense sphere chain along a
# serpentine ground path rising through an S-curved neck into a real
# skull + snout + jaw; horns as swept-back roundcones.
sdf_geometry
{
	name	dragon_body
	part	sphere smin 0.30  -3.7 0.24 1.25  0 0 0  1 1 1  0.10 0 0  0.0
	part	sphere smin 0.34  -3.3 0.30 1.02  0 0 0  1 1 1  0.16 0 0  0.0
	part	sphere smin 0.38  -2.85 0.36 0.78  0 0 0  1 1 1  0.22 0 0  0.0
	part	sphere smin 0.40  -2.45 0.42 0.55  0 0 0  1 1 1  0.28 0 0  0.0
	part	sphere smin 0.42  -1.85 0.50 0.25  0 0 0  1 1 1  0.36 0 0  0.0
	part	sphere smin 0.42  -1.2 0.58 0.02  0 0 0  1 1 1  0.45 0 0  0.0
	part	sphere smin 0.42  -0.55 0.64 -0.08  0 0 0  1 1 1  0.52 0 0  0.0
	part	sphere smin 0.42  0.1 0.68 -0.05  0 0 0  1 1 1  0.52 0 0  0.0
	part	sphere smin 0.40  0.7 0.72 0.05  0 0 0  1 1 1  0.46 0 0  0.0
	part	sphere smin 0.36  1.25 0.85 0.12  0 0 0  1 1 1  0.38 0 0  0.0
	part	sphere smin 0.30  1.55 1.25 0.10  0 0 0  1 1 1  0.28 0 0  0.0
	part	sphere smin 0.28  1.85 1.70 0.06  0 0 0  1 1 1  0.24 0 0  0.0
	part	sphere smin 0.26  2.00 2.10 0.03  0 0 0  1 1 1  0.21 0 0  0.0
	part	sphere smin 0.24  2.05 2.45 0.0  0 0 0  1 1 1  0.19 0 0  0.0
	part	sphere smin 0.18  2.15 2.68 0.0  0 0 0  1 1 1  0.24 0 0  0.0
	part	sphere smin 0.14  2.40 2.72 0.0  0 0 0  1 1 1  0.34 0 0  0.0
	part	sphere smin 0.12  2.66 2.62 0.0  0 0 0  1 1 1  0.19 0 0  0.0
	part	sphere smin 0.10  2.88 2.54 0.0  0 0 0  1 1 1  0.14 0 0  0.0
	part	sphere smin 0.08  3.06 2.48 0.0  0 0 0  1 1 1  0.10 0 0  0.0
	part	sphere smin 0.07  2.70 2.44 0.0  0 0 0  1 1 1  0.12 0 0  0.0
	part	roundcone smin 0.05  2.20 2.98 0.16  30 0 -55  1 1 1  0.08 0.01 0.75  0.0
	part	roundcone smin 0.05  2.20 2.98 -0.16  -30 0 -55  1 1 1  0.08 0.01 0.75  0.0
	part	roundcone smin 0.05  1.45 1.35 0.10  0 0 -45  1 1 1  0.07 0.01 0.50  0.0
	part	roundcone smin 0.05  0.85 1.10 0.10  0 0 -35  1 1 1  0.08 0.01 0.55  0.0
	part	roundcone smin 0.05  0.15 1.14 -0.05  0 0 -25  1 1 1  0.08 0.01 0.55  0.0
	part	roundcone smin 0.05  -0.55 1.10 -0.08  0 0 -18  1 1 1  0.07 0.01 0.50  0.0
	part	roundcone smin 0.05  -1.35 0.82 0.05  0 0 -10  1 1 1  0.05 0.01 0.32  0.0
	part	roundcone smin 0.05  -2.1 0.62 0.35  0 0 -5  1 1 1  0.04 0.01 0.26  0.0
	maxsteps	256
}

standard_object
{
	name		obj_dragon
	geometry	dragon_body
	material	mat_dragon
	position	-2.6 1.15 -4.0
	scale		1.25 1.25 1.25
	orientation	0 -30 0
}

# Wings: flattened ellipsoids, angled up and back.
ellipsoid_geometry
{
	name	wing
	radii	1.3 0.035 0.7
}

uniformcolor_painter
{
	name	pnt_wing_violet
	color	0.30 0.08 0.55
}

uniformcolor_painter
{
	name	pnt_wing_teal
	color	0.03 0.35 0.42
}

iridescent_painter
{
	name	pnt_wing
	colora	pnt_wing_violet
	colorb	pnt_wing_teal
	bias	0.1
}

lambertian_material
{
	name		mat_wing
	reflectance	pnt_wing
}

# Wings rise as a V from the shoulders.  The X euler tips the membrane
# toward the camera (a pure Z bank leaves the thin axis edge-on to +Z
# and the wing renders as a stick); the Z euler banks the span upward.
standard_object
{
	name		obj_wing_l
	geometry	wing
	material	mat_wing
	position	-3.1 3.0 -4.1
	orientation	55 20 -55
}

standard_object
{
	name		obj_wing_r
	geometry	wing
	material	mat_wing
	position	-0.45 3.0 -4.5
	orientation	65 -25 60
}

