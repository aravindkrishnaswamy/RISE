##################################################
# Mist: thin global haze + banked valley fog
##################################################

# (A global_medium haze was tried and removed: on an OPEN landscape
# every ray that escapes to the environment in-scatters the
# directional lights over an unbounded path, drowning the sky in the
# rim light's colour.  Bounded mist banks below are the right idiom.)

# Dense banked mist pooling in the hollows.
homogeneous_medium
{
	name		med_mist
	absorption	0.010 0.010 0.015
	scattering	0.22 0.20 0.28
	phase		hg 0.35
}

# Near-invisible shell that carries the interior medium.
dielectric_material
{
	name		mat_mist_shell
	tau			0.999
	ior			1.001
	scattering	100000.0
}

ellipsoid_geometry
{
	name	mist_bank
	radii	4.5 0.40 2.2
}

standard_object
{
	name			obj_mist_a
	geometry		mist_bank
	material		mat_mist_shell
	interior_medium	med_mist
	position		0.5 0.35 -1.2
	orientation		0 20 0
	casts_shadows	FALSE
}

standard_object
{
	name			obj_mist_b
	geometry		mist_bank
	material		mat_mist_shell
	interior_medium	med_mist
	position		-3.2 0.55 0.8
	orientation		0 -15 0
	casts_shadows	FALSE
}

standard_object
{
	name			obj_mist_c
	geometry		mist_bank
	material		mat_mist_shell
	interior_medium	med_mist
	position		2.8 0.35 -3.5
	orientation		0 30 0
	casts_shadows	FALSE
}

# Low foreground veil drifting in front of the camera path.
ellipsoid_geometry
{
	name	mist_veil
	radii	6.0 0.30 2.5
}

standard_object
{
	name			obj_mist_d
	geometry		mist_veil
	material		mat_mist_shell
	interior_medium	med_mist
	position		-1.0 0.15 5.0
	orientation		0 10 0
	casts_shadows	FALSE
}

