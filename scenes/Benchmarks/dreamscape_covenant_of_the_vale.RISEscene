##################################################
# Floating shards: craggy displaced rocks adrift
##################################################

sphere_geometry
{
	name	shard_base
	radius	0.7
}

# Craggy surface via UV-domain ridges (3D painters are constant
# through the function2d bridge, so the field is authored in UV).
expression_function2d
{
	name	fn_crag
	def		a sin( u * 55.0 ) * sin( v * 47.0 + 1.0 )
	def		b sin( u * 23.0 + 2.0 ) * sin( v * 19.0 )
	expr	0.5 * abs( a ) + 0.5 * abs( b )
}

displaced_geometry
{
	name			shard_rock
	base_geometry	shard_base
	detail			64
	displacement	fn_crag
	disp_scale		0.35
}

standard_object
{
	name		obj_shard_a
	geometry	shard_rock
	material	mat_terrain_glow
	position	-5.2 5.3 -10.0
	orientation	20 40 10
}

standard_object
{
	name		obj_shard_b
	geometry	shard_rock
	material	mat_terrain_glow
	position	5.6 5.7 -10.5
	scale		0.65 0.65 0.65
	orientation	-15 70 30
}

##################################################
# The spell: a luminous arc from orb to dragon
##################################################

lambertian_luminaire_material
{
	name		mat_spell
	exitance	pnt_orb
	scale		4.0
	material	none
}

sweep_geometry
{
	name			spell_arc
	profile_point	0.032 0.0
	profile_point	0.023 0.023
	profile_point	0.0 0.032
	profile_point	-0.023 0.023
	profile_point	-0.032 0.0
	profile_point	-0.023 -0.023
	profile_point	0.0 -0.032
	profile_point	0.023 -0.023
	point	2.63 3.72 3.55
	point	1.90 4.00 1.60
	point	1.30 4.25 -0.30
	point	0.80 4.26 -2.00
	n_len	96
	cap_start	TRUE
	cap_end		TRUE
}

standard_object
{
	name		obj_spell
	geometry	spell_arc
	material	mat_spell
}

